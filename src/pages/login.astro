---
// =============================================================================
// RUTA DE AUTENTICACIÓN Y PANEL ADMIN: /login (src/pages/login.astro)
// Implementación bajo estándares OWASP Top 10 (2025) + Autenticación JWT
// Incluye:
//   1. Alta de Productos (Imágenes a Supabase Storage + URL, Tallas disponibles, Medidas y Specs)
//   2. Configuración de Canales Sociales (Número de WhatsApp, Mostrar/Ocultar Instagram y Enlace IG)
//   3. Inspector Criptográfico JWT y Bitácora OWASP A09 (auth_audit_logs)
// =============================================================================

const pageTitle = "URBAN_DROP — Admin & Acceso Seguro JWT (OWASP 2025)";
const pageDescription = "Portal administrativo con autenticación JWT bajo OWASP 2025, alta de productos con subida de imágenes y configuración en vivo de WhatsApp e Instagram.";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#020617" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Google Fonts optimizadas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Iconografía Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>

  <body class="min-h-screen pb-24 select-none bg-slate-950 antialiased font-sans text-slate-100">
    <!-- ========================================== -->
    <!-- TOAST DE NOTIFICACIONES DE SEGURIDAD/ADMIN -->
    <!-- ========================================== -->
    <div
      id="auth-toast"
      class="fixed top-16 left-1/2 -translate-x-1/2 z-[60] px-4 py-2.5 rounded-2xl bg-slate-900/95 border border-emerald-500/40 text-emerald-400 text-xs font-bold shadow-2xl backdrop-blur-md flex items-center gap-2 opacity-0 pointer-events-none -translate-y-3 transition-all duration-300"
      role="status"
      aria-live="polite"
    >
      <i id="auth-toast-icon" class="fa-solid fa-shield-halved text-sm" aria-hidden="true"></i>
      <span id="auth-toast-msg">Operación verificada</span>
    </div>

    <!-- ========================================== -->
    <!-- HEADER STICKY (Navegación y Estado OWASP)  -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80 px-4 py-3">
      <div class="max-w-xl mx-auto flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 rounded-lg"
          aria-label="Volver al catálogo principal"
        >
          <div class="w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-xs text-pink-400">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          </div>
          <div>
            <span class="font-heading text-sm font-bold tracking-tight text-white block leading-none">URBAN_DROP</span>
            <span class="text-[10px] font-mono text-slate-400">Ver Catálogo Público</span>
          </div>
        </a>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-pink-500/10 text-pink-400 border border-pink-500/20">
            <i class="fa-solid fa-lock text-[9px]" aria-hidden="true"></i>
            <span>OWASP 2025 • JWT</span>
          </span>

          <button
            id="btn-owasp-info"
            type="button"
            class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center text-xs hover:bg-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
            aria-label="Ver Arquitectura de Seguridad OWASP 2025"
          >
            <i class="fa-solid fa-shield-cat text-emerald-400" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-xl mx-auto px-4 pt-5 space-y-5">
      <!-- ============================================================== -->
      <!-- VISTA 1: FORMULARIO DE LOGIN SEGURO (OWASP 2025)               -->
      <!-- ============================================================== -->
      <section
        id="login-card-view"
        class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 shadow-2xl space-y-5 relative overflow-hidden"
      >
        <div class="absolute -top-16 -right-16 w-36 h-36 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-pink-500/20 via-purple-500/20 to-emerald-400/20 border border-pink-500/30 flex items-center justify-center text-pink-400 text-lg shrink-0">
              <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
            </div>
            <div>
              <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 font-bold block">
                Supabase Auth + JWT
              </span>
              <h1 class="font-heading text-xl font-bold text-white leading-tight">
                Acceso Administrativo
              </h1>
              <p class="text-xs text-slate-400">
                Inicia sesión para gestionar productos, tallas, WhatsApp e Instagram
              </p>
            </div>
          </div>
        </div>

        <!-- Indicador de Rate-Limiting / Protección Fuerza Bruta (A07:2025) -->
        <div class="p-3 rounded-2xl bg-slate-950/90 border border-slate-800 flex items-center justify-between text-[11px]">
          <span class="text-slate-400 flex items-center gap-1.5">
            <i class="fa-solid fa-gauge-high text-cyan-400" aria-hidden="true"></i>
            <span>Protección Anti-Fuerza Bruta:</span>
          </span>
          <span id="rate-limit-badge" class="font-mono font-bold text-emerald-400">
            5 / 5 intentos disponibles
          </span>
        </div>

        <!-- Banner de Bloqueo Temporal -->
        <div
          id="lockout-banner"
          class="hidden p-3.5 rounded-2xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs items-center gap-2.5"
          role="alert"
        >
          <i class="fa-solid fa-ban text-red-400 text-base shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-red-200">Cuenta protegida temporalmente (OWASP A07:2025)</p>
            <p class="text-[11px] text-red-300/90">
              Demasiados intentos fallidos. Espera <span id="lockout-timer" class="font-mono font-bold">30</span>s para volver a intentar.
            </p>
          </div>
        </div>

        <!-- Banner de Error Genérico -->
        <div
          id="auth-error-banner"
          class="hidden p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs items-start gap-2.5"
          role="alert"
        >
          <i class="fa-solid fa-triangle-exclamation text-amber-400 text-sm mt-0.5 shrink-0" aria-hidden="true"></i>
          <div>
            <p class="font-bold text-amber-200" id="auth-error-title">No se pudo iniciar sesión</p>
            <p class="text-[11px] text-amber-300/90" id="auth-error-desc">
              Credenciales inválidas o cuenta no autorizada. Todos los intentos son auditados.
            </p>
          </div>
        </div>

        <!-- Formulario de Login -->
        <form id="secure-login-form" class="space-y-4" novalidate>
          <input type="hidden" id="csrf-token-input" name="csrf_token" value="" />

          <div class="space-y-1.5">
            <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              Correo Electrónico Corporativo
            </label>
            <div class="relative flex items-center">
              <i class="fa-regular fa-envelope absolute left-3.5 text-slate-500 text-xs pointer-events-none" aria-hidden="true"></i>
              <input
                id="login-email"
                name="email"
                type="email"
                autocomplete="username"
                required
                maxlength="120"
                placeholder="admin@urbandrop.store"
                class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl pl-9 pr-4 py-3 text-xs text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-pink-500/20 transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                Contraseña
              </label>
              <span id="password-entropy-label" class="text-[10px] font-mono text-slate-500">
                Mín. 10 caracteres + complejidad
              </span>
            </div>

            <div class="relative flex items-center">
              <i class="fa-solid fa-key absolute left-3.5 text-slate-500 text-xs pointer-events-none" aria-hidden="true"></i>
              <input
                id="login-password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                minlength="10"
                maxlength="64"
                placeholder="••••••••••••••••••••"
                class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl pl-9 pr-10 py-3 text-xs text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-pink-500/20 transition-all font-mono"
              />
              <button
                id="toggle-password-btn"
                type="button"
                class="absolute right-2.5 w-8 h-8 rounded-lg text-slate-400 hover:text-white flex items-center justify-center text-xs focus-visible:outline-none"
                aria-label="Mostrar u ocultar contraseña"
              >
                <i id="toggle-password-icon" class="fa-regular fa-eye" aria-hidden="true"></i>
              </button>
            </div>

            <div class="grid grid-cols-4 gap-1.5 pt-1" id="password-strength-bars">
              <div class="h-1 rounded-full bg-slate-800 transition-colors" data-bar="1"></div>
              <div class="h-1 rounded-full bg-slate-800 transition-colors" data-bar="2"></div>
              <div class="h-1 rounded-full bg-slate-800 transition-colors" data-bar="3"></div>
              <div class="h-1 rounded-full bg-slate-800 transition-colors" data-bar="4"></div>
            </div>
          </div>

          <button
            id="btn-submit-login"
            type="submit"
            class="w-full min-h-[44px] py-3.5 px-4 rounded-xl bg-gradient-to-r from-pink-500 via-purple-500 to-emerald-400 p-[1px] font-bold text-xs text-white shadow-lg shadow-pink-500/20 active:scale-95 transition-all focus-visible:outline-none"
          >
            <div class="w-full h-full bg-slate-950/40 hover:bg-transparent rounded-[11px] py-3 px-4 flex items-center justify-center gap-2 transition-colors">
              <i id="submit-spinner" class="fa-solid fa-fingerprint text-sm" aria-hidden="true"></i>
              <span id="submit-btn-text">Autenticar y Abrir Panel Admin</span>
            </div>
          </button>
        </form>

        <!-- Panel de Pruebas Rápidas -->
        <div class="pt-3 border-t border-slate-800/90 space-y-2.5">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-slate-400 font-semibold flex items-center gap-1.5">
              <i class="fa-solid fa-flask text-pink-400" aria-hidden="true"></i>
              <span>Entorno de Pruebas Supabase Auth:</span>
            </span>
            <span class="font-mono text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">
              Admin Semilla Activo
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button
              id="btn-fill-demo"
              type="button"
              class="min-h-[40px] py-2 px-3 rounded-xl bg-slate-950 hover:bg-slate-800 border border-emerald-500/30 text-emerald-400 font-bold text-[11px] flex items-center justify-center gap-1.5 transition-all active:scale-95"
            >
              <i class="fa-solid fa-wand-magic-sparkles text-[10px]" aria-hidden="true"></i>
              <span>Cargar Admin Válido</span>
            </button>

            <button
              id="btn-fill-invalid"
              type="button"
              class="min-h-[40px] py-2 px-3 rounded-xl bg-slate-950 hover:bg-slate-800 border border-amber-500/30 text-amber-400 font-bold text-[11px] flex items-center justify-center gap-1.5 transition-all active:scale-95"
            >
              <i class="fa-solid fa-bug-slash text-[10px]" aria-hidden="true"></i>
              <span>Simular Fallo Auth</span>
            </button>
          </div>
        </div>
      </section>

      <!-- ============================================================== -->
      <!-- VISTA 2: WORKSPACE ADMINISTRATIVO PROTEGIDO POR JWT            -->
      <!-- ============================================================== -->
      <section
        id="jwt-session-view"
        class="hidden bg-slate-900/90 border border-emerald-500/30 rounded-3xl p-5 shadow-2xl space-y-5"
      >
        <!-- Cabecera de Sesión Verificada -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-3.5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-lg">
              <i class="fa-solid fa-user-check" aria-hidden="true"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 font-bold">
                  Sesión JWT Activa
                </span>
                <span id="jwt-role-badge" class="text-[10px] font-mono bg-pink-500/20 text-pink-300 border border-pink-500/30 px-2 py-0.5 rounded-full font-bold">
                  ROL: ADMIN_DROP
                </span>
              </div>
              <h2 id="jwt-user-email" class="font-heading font-bold text-base text-white">
                admin@urbandrop.store
              </h2>
            </div>
          </div>

          <div class="text-right">
            <span class="text-[10px] font-mono text-slate-400 block">EXPIRA EN</span>
            <span id="jwt-exp-countdown" class="font-mono font-bold text-sm text-emerald-400">
              59m 59s
            </span>
          </div>
        </div>

        <!-- Navegación por Pestañas del Panel Admin -->
        <div class="grid grid-cols-3 gap-1.5 p-1.5 rounded-2xl bg-slate-950 border border-slate-800" role="tablist">
          <button
            id="tab-btn-productos"
            type="button"
            role="tab"
            aria-selected="true"
            class="admin-tab-btn min-h-[40px] py-2 px-2 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all bg-pink-500 text-white shadow-md shadow-pink-500/20"
          >
            <i class="fa-solid fa-shirt text-xs" aria-hidden="true"></i>
            <span>Alta Productos</span>
          </button>

          <button
            id="tab-btn-canales"
            type="button"
            role="tab"
            aria-selected="false"
            class="admin-tab-btn min-h-[40px] py-2 px-2 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all text-slate-400 hover:text-white"
          >
            <i class="fa-brands fa-whatsapp text-xs" aria-hidden="true"></i>
            <span>WhatsApp & IG</span>
          </button>

          <button
            id="tab-btn-jwt"
            type="button"
            role="tab"
            aria-selected="false"
            class="admin-tab-btn min-h-[40px] py-2 px-2 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all text-slate-400 hover:text-white"
          >
            <i class="fa-solid fa-key text-xs" aria-hidden="true"></i>
            <span>Token JWT</span>
          </button>
        </div>

        <!-- ============================================================ -->
        <!-- PESTAÑA 1: ALTA DE PRODUCTOS Y GESTIÓN DE CATÁLOGO           -->
        <!-- ============================================================ -->
        <div id="tab-panel-productos" class="space-y-5">
          <div class="p-3.5 rounded-2xl bg-slate-950/90 border border-slate-800 flex items-center justify-between gap-2">
            <div>
              <h3 class="font-heading font-bold text-sm text-white flex items-center gap-1.5">
                <i class="fa-solid fa-plus-circle text-pink-400" aria-hidden="true"></i>
                <span>Dar de Alta Nuevo Producto</span>
              </h3>
              <p class="text-[11px] text-slate-400">
                Guarda directo en Supabase PostgreSQL (<code class="text-slate-300">productos</code>, <code class="text-slate-300">imagenes</code>, <code class="text-slate-300">tallas</code> y <code class="text-slate-300">especificaciones</code>)
              </p>
            </div>
            <button
              id="btn-fill-sample-prod"
              type="button"
              class="shrink-0 py-2 px-3 rounded-xl bg-pink-500/15 hover:bg-pink-500/25 border border-pink-500/30 text-pink-300 text-[11px] font-bold flex items-center gap-1.5 active:scale-95 transition-all"
            >
              <i class="fa-solid fa-wand-magic-sparkles text-[10px]" aria-hidden="true"></i>
              <span>Autocompletar Demo</span>
            </button>
          </div>

          <form id="create-product-form" class="space-y-4" novalidate>
            <!-- Nombre y Categoría -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="sm:col-span-2 space-y-1">
                <label for="prod-name" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Nombre de la Prenda *
                </label>
                <input
                  id="prod-name"
                  type="text"
                  required
                  maxlength="90"
                  placeholder="Ej. Hoodie Cyber Acid 520G"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder:text-slate-600 focus:outline-none"
                />
              </div>

              <div class="space-y-1">
                <label for="prod-category" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Categoría *
                </label>
                <select
                  id="prod-category"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none"
                >
                  <option value="hoodies">Hoodies</option>
                  <option value="pantalones">Pantalones</option>
                  <option value="t-shirts">T-Shirts</option>
                  <option value="chaquetas">Chaquetas</option>
                </select>
              </div>
            </div>

            <!-- Precio, Stock y Etiqueta -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <div class="space-y-1">
                <label for="prod-price" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Precio (USD) *
                </label>
                <div class="relative flex items-center">
                  <span class="absolute left-3 text-xs font-mono text-emerald-400">$</span>
                  <input
                    id="prod-price"
                    type="number"
                    step="0.01"
                    min="1"
                    required
                    placeholder="58.00"
                    class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl pl-7 pr-3 py-2.5 text-xs text-white font-mono placeholder:text-slate-600 focus:outline-none"
                  />
                </div>
              </div>

              <div class="space-y-1">
                <label for="prod-stock" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Stock Total *
                </label>
                <input
                  id="prod-stock"
                  type="number"
                  min="1"
                  max="999"
                  required
                  value="8"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3.5 py-2.5 text-xs text-white font-mono focus:outline-none"
                />
              </div>

              <div class="col-span-2 sm:col-span-1 space-y-1">
                <label for="prod-tag" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Etiqueta / Drop Tag *
                </label>
                <input
                  id="prod-tag"
                  type="text"
                  required
                  placeholder="Nuevo Drop • Limitado"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder:text-slate-600 focus:outline-none"
                />
              </div>
            </div>

            <!-- Corte / Fit e Información de Modelo -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1">
                <label for="prod-fit" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Corte / Fit *
                </label>
                <input
                  id="prod-fit"
                  type="text"
                  required
                  placeholder="Ej. Oversized Boxy Fit"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder:text-slate-600 focus:outline-none"
                />
              </div>

              <div class="space-y-1">
                <label for="prod-model" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
                  Referencia del Modelo *
                </label>
                <input
                  id="prod-model"
                  type="text"
                  required
                  placeholder="Ej. 1.80m — Usa Talla L"
                  class="w-full bg-slate-950 border border-slate-800 focus:border-pink-500 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder:text-slate-600 focus:outline-none"
                />
              </div>
            </div>

            <!-- Carga de Imágenes (Pipeline Desacoplado Cloudflare R2 + Presigned S3 URL + Magic Bytes + EXIF Strip) -->
            <div class="p-3.5 rounded-2xl bg-slate-950 border border-orange-500/30 space-y-3">
              <div class="flex items-center justify-between flex-wrap gap-1.5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-200 flex items-center gap-1.5">
                  <i class="fa-solid fa-cloud-bolt text-orange-400" aria-hidden="true"></i>
                  <span>Cloudflare R2 Image Ingestion Pipeline (3:4) *</span>
                </span>
                <span id="prod-images-count" class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                  1 activo R2 listo
                </span>
              </div>

              <!-- Telemetría en vivo del Pipeline R2 -->
              <div id="r2-upload-telemetry" class="p-2.5 rounded-xl bg-slate-900/90 border border-slate-800 text-[10px] font-mono text-slate-300 space-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-orange-400 font-bold">● S3 Presigned URL (/functions/v1/r2-presigned-upload)</span>
                  <span id="r2-telemetry-status" class="text-emerald-400">READY • SHA-256 + EXIF STRIP</span>
                </div>
