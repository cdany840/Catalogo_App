      });

      // Registro de Auditoría en Supabase PostgreSQL (`public.auth_audit_logs`)
      async function logAuthAuditEvent(
        eventType: 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'LOGOUT' | 'RATE_LIMIT_LOCK' | 'TOKEN_VERIFIED',
        email: string,
        userId: string | null = null,
        accessToken: string | null = null,
        extraMeta: Record<string, unknown> = {}
      ) {
        try {
          const headers: Record<string, string> = {
            apikey: SUPABASE_PUBLISHABLE_KEY,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          };
          if (accessToken) {
            headers['Authorization'] = `Bearer ${accessToken}`;
          }

          await fetch(`${SUPABASE_URL}/rest/v1/auth_audit_logs`, {
            method: 'POST',
            headers,
            body: JSON.stringify({
              user_id: userId,
              email_masked: maskEmailForAudit(email),
              event_type: eventType,
              ip_hint: 'client-web-owasp2025',
              user_agent: navigator.userAgent.slice(0, 140),
              metadata: extraMeta,
            }),
          });
        } catch {
          // Falla silenciosa
        }
      }

      async function loadUserAuditLogs(accessToken: string) {
        const container = document.getElementById('audit-logs-container');
        if (!container) return;

        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/auth_audit_logs?select=id,event_type,email_masked,created_at,metadata&order=created_at.desc&limit=6`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                Accept: 'application/json',
              },
            }
          );

          if (!res.ok) return;
          const logs = await res.json();
          if (!Array.isArray(logs) || logs.length === 0) {
            container.innerHTML = `<p class="text-slate-500 text-center py-2">Sin eventos registrados aún.</p>`;
            return;
          }

          container.innerHTML = '';
          logs.forEach((item: any) => {
            const row = document.createElement('div');
            row.className =
              'flex items-center justify-between px-2.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-800/80';

            const left = document.createElement('div');
            left.className = 'flex items-center gap-2';

            const badge = document.createElement('span');
            const isSuccess = item.event_type === 'LOGIN_SUCCESS' || item.event_type === 'TOKEN_VERIFIED';
            badge.className = `font-mono text-[10px] font-bold px-1.5 py-0.5 rounded ${
              isSuccess
                ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                : 'bg-amber-500/15 text-amber-400 border border-amber-500/30'
            }`;
            badge.textContent = item.event_type;

            const emailSpan = document.createElement('span');
            emailSpan.className = 'text-slate-300 font-mono text-[10px]';
            emailSpan.textContent = item.email_masked;

            left.appendChild(badge);
            left.appendChild(emailSpan);

            const timeSpan = document.createElement('span');
            timeSpan.className = 'text-slate-500 font-mono text-[10px]';
            const dt = new Date(item.created_at);
            timeSpan.textContent = dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            row.appendChild(left);
            row.appendChild(timeSpan);
            container.appendChild(row);
          });
        } catch {
          // Ignorar error de red
        }
      }

      // ==============================================================
      // GESTIÓN DE IMÁGENES DEL NUEVO PRODUCTO (CLOUDFLARE R2 PRESIGNED PIPELINE)
      // ==============================================================
      function normalizeImageDescriptor(entry: string | R2PendingImageDescriptor): R2PendingImageDescriptor {
        if (typeof entry === 'string') {
          const fallbackHash = entry.replace(/[^a-f0-9]/gi, '').slice(0, 64).padEnd(64, 'a');
          return {
            url: entry,
            r2_object_key: `drops/v1/${fallbackHash.slice(0, 24)}-700x933.webp`,
            content_hash: fallbackHash,
            mime_type: 'image/webp',
            width: 700,
            height: 933,
            dominant_color: '#0f172a',
            lqip_data_uri: createLqipSvgDataUri('#0f172a'),
            exif_stripped: true,
            magic_bytes_verified: true,
            cache_control: 'public, max-age=31536000, immutable',
          };
        }
        return entry;
      }

