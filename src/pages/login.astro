            const uploaded = await uploadAssetViaR2PresignedPipeline(file, accessToken || '');
            const imageDesc: R2PendingImageDescriptor = {
              url: uploaded.finalUrl,
              r2_object_key: uploaded.objectKey,
              content_hash: uploaded.sha256,
              mime_type: 'image/webp',
              width: uploaded.width,
              height: uploaded.height,
              dominant_color: uploaded.dominantColor,
              lqip_data_uri: uploaded.lqipDataUri,
              exif_stripped: true,
              magic_bytes_verified: true,
              cache_control: 'public, max-age=31536000, immutable',
