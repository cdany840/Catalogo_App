    <!-- ============================================================== -->
    <!-- MODAL DETALLADO DE ARQUITECTURA OWASP 2025 & JWT               -->
    <!-- ============================================================== -->
    <div
      id="owasp-modal"
      class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
      role="dialog"
      aria-modal="true"
      aria-labelledby="owasp-modal-title"
    >
      <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl p-6 shadow-2xl max-h-[85vh] overflow-y-auto space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-emerald-400" aria-hidden="true"></i>
            <h3 id="owasp-modal-title" class="font-heading font-bold text-base text-white">
              Especificación de Seguridad OWASP 2025 & JWT
            </h3>
          </div>
          <button
            id="close-owasp-modal"
            type="button"
            class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-sm"
            aria-label="Cerrar modal de seguridad"
          >
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>

        <div class="space-y-3 text-xs text-slate-300 leading-relaxed">
          <div class="p-3 bg-slate-950 rounded-2xl border border-slate-800">
            <p class="font-bold text-pink-400 mb-1">1. Firma y Validación Estricta de JWT (RFC 7519)</p>
            <p class="text-slate-400">
              Cada token emitido por Supabase Auth se verifica validando sus 3 segmentos, algoritmo criptográfico permitido (<code class="text-slate-200">HS256/ES256/RS256</code>), emisor (<code class="text-slate-200">iss</code>), sujeto (<code class="text-slate-200">sub</code>) y expiración (<code class="text-slate-200">exp</code>).
            </p>
          </div>
          <div class="p-3 bg-slate-950 rounded-2xl border border-slate-800">
            <p class="font-bold text-emerald-400 mb-1">2. Separación de Metadatos de Autorización (A01:2025)</p>
            <p class="text-slate-400">
              En cumplimiento con las reglas de seguridad de Supabase, jamás se utiliza <code class="text-slate-200">user_metadata</code> para decisiones de autorización. El rol <code class="text-slate-200">admin_drop</code> reside en <code class="text-slate-200">raw_app_meta_data</code>, validado por RLS en cada alta de producto o cambio de configuración.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- CLIENT SCRIPT: AUTENTICACIÓN JWT, ALTA PRODUCTOS Y CANALES     -->
    <!-- ============================================================== -->
    <script>
      import {
        SUPABASE_URL,
        SUPABASE_PUBLISHABLE_KEY,
      } from '../lib/supabase';
      import { inspectAndValidateJwt, maskEmailForAudit } from '../lib/auth';
      import {
        createLqipSvgDataUri,
        sha256HexFromString,
        uploadAssetViaR2PresignedPipeline,
      } from '../lib/cloudflare-r2';

      const SESSION_STORAGE_KEY = 'urban_drop_jwt_session_v1';
      const RATE_LIMIT_STORAGE_KEY = 'urban_drop_auth_rate_limit_v1';
      const STORE_CONFIG_CACHE_KEY = 'urban_drop_store_config_v1';
      const MAX_ATTEMPTS = 5;
      const LOCKOUT_SECONDS = 30;

      const COMPROMISED_PATTERNS = [
        'password',
        '123456',
        'qwerty',
        'admin123',
        'letmein',
        'welcome',
        'contraseña',
        'iloveyou',
      ];

      const DEFAULT_MEASUREMENTS_BY_CAT: Record<string, Record<'S' | 'M' | 'L' | 'XL', string>> = {
        hoodies: {
          S: 'Pecho: 58cm | Largo: 68cm',
          M: 'Pecho: 61cm | Largo: 71cm',
          L: 'Pecho: 64cm | Largo: 74cm',
          XL: 'Pecho: 67cm | Largo: 77cm',
        },
        pantalones: {
          S: 'Cintura: 76cm | Largo: 102cm',
          M: 'Cintura: 80cm | Largo: 104cm',
          L: 'Cintura: 84cm | Largo: 106cm',
          XL: 'Cintura: 88cm | Largo: 108cm',
        },
        't-shirts': {
          S: 'Pecho: 55cm | Largo: 69cm',
          M: 'Pecho: 58cm | Largo: 72cm',
          L: 'Pecho: 61cm | Largo: 75cm',
          XL: 'Pecho: 64cm | Largo: 78cm',
        },
        chaquetas: {
          S: 'Pecho: 60cm | Largo: 65cm',
          M: 'Pecho: 63cm | Largo: 67cm',
          L: 'Pecho: 66cm | Largo: 70cm',
          XL: 'Pecho: 69cm | Largo: 72cm',
        },
      };

      interface R2PendingImageDescriptor {
        url: string;
        r2_object_key: string;
        content_hash: string;
        mime_type: string;
        width: number;
        height: number;
        dominant_color: string;
        lqip_data_uri: string;
        exif_stripped: boolean;
        magic_bytes_verified: boolean;
        cache_control: string;
      }

      // Estado del formulario de Alta de Producto
      let pendingProductImages: Array<string | R2PendingImageDescriptor> = import.meta.env.DEV
        ? ['https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&q=80&w=700']
        : [];

      function initCsrfToken(): string {
        const array = new Uint8Array(24);
        window.crypto.getRandomValues(array);
        const token = Array.from(array, (b) => b.toString(16).padStart(2, '0')).join('');
        sessionStorage.setItem('urban_drop_csrf_nonce', token);
        const csrfInput = document.getElementById('csrf-token-input') as HTMLInputElement;
        if (csrfInput) csrfInput.value = token;
        return token;
      }

      initCsrfToken();

      const loginCardView = document.getElementById('login-card-view') as HTMLElement;
      const jwtSessionView = document.getElementById('jwt-session-view') as HTMLElement;
      const loginForm = document.getElementById('secure-login-form') as HTMLFormElement;
      const emailInput = document.getElementById('login-email') as HTMLInputElement;
      const passwordInput = document.getElementById('login-password') as HTMLInputElement;
      const togglePassBtn = document.getElementById('toggle-password-btn') as HTMLButtonElement;
      const togglePassIcon = document.getElementById('toggle-password-icon') as HTMLElement;
      const rateLimitBadge = document.getElementById('rate-limit-badge') as HTMLElement;
      const lockoutBanner = document.getElementById('lockout-banner') as HTMLElement;
      const lockoutTimerEl = document.getElementById('lockout-timer') as HTMLElement;
      const errorBanner = document.getElementById('auth-error-banner') as HTMLElement;
      const errorTitle = document.getElementById('auth-error-title') as HTMLElement;
      const errorDesc = document.getElementById('auth-error-desc') as HTMLElement;
      const submitBtn = document.getElementById('btn-submit-login') as HTMLButtonElement;
      const submitBtnText = document.getElementById('submit-btn-text') as HTMLElement;
      const submitSpinner = document.getElementById('submit-spinner') as HTMLElement;
      const toastEl = document.getElementById('auth-toast') as HTMLElement;
      const toastMsgEl = document.getElementById('auth-toast-msg') as HTMLElement;

      let expInterval: ReturnType<typeof setInterval> | null = null;
      let lockoutInterval: ReturnType<typeof setInterval> | null = null;
      let toastTimer: ReturnType<typeof setTimeout> | null = null;

      function showToast(msg: string, durationMs = 3000) {
        if (!toastEl || !toastMsgEl) return;
        if (toastTimer !== null) {
          clearTimeout(toastTimer);
        }
        toastMsgEl.textContent = msg;
        toastEl.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-3');
        toastEl.classList.add('opacity-100', 'translate-y-0');
        toastTimer = setTimeout(() => {
          toastEl.classList.add('opacity-0', 'pointer-events-none', '-translate-y-3');
          toastEl.classList.remove('opacity-100', 'translate-y-0');
          toastTimer = null;
        }, durationMs);
      }

      function getActiveAccessToken(): string | null {
        try {
          const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          return parsed.access_token || null;
        } catch {
          return null;
        }
      }

      // Gestión de Pestañas del Panel Admin
      const tabButtons = [
        { btnId: 'tab-btn-productos', panelId: 'tab-panel-productos' },
        { btnId: 'tab-btn-canales', panelId: 'tab-panel-canales' },
        { btnId: 'tab-btn-jwt', panelId: 'tab-panel-jwt' },
      ];

      function syncFabVisibility() {
        const fabBtn = document.getElementById('fab-create-product-btn');
        const bottomTabs = document.getElementById('admin-bottom-tabs');
        const isProdTabActive = document.getElementById('tab-btn-productos')?.getAttribute('aria-selected') === 'true';
        const isAuthed = !jwtSessionView?.classList.contains('hidden');
        if (bottomTabs) {
          bottomTabs.classList.toggle('hidden', !isAuthed);
        }
        if (!fabBtn) return;
        const shouldShow = Boolean(isProdTabActive && isAuthed);
        fabBtn.classList.toggle('hidden', !shouldShow);
        fabBtn.classList.toggle('flex', shouldShow);
      }

      function switchAdminTab(targetBtnId: string) {
        tabButtons.forEach(({ btnId, panelId }) => {
          const btn = document.getElementById(btnId);
          const panel = document.getElementById(panelId);
          const isActive = btnId === targetBtnId;
          if (btn) {
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
            btn.className = isActive
              ? 'admin-tab-btn min-h-[40px] py-2 px-2 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all bg-pink-500 text-white shadow-md shadow-pink-500/20'
              : 'admin-tab-btn min-h-[40px] py-2 px-2 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all text-slate-400 hover:text-white';
          }
          if (panel) {
