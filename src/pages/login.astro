                           <i class="fa-regular fa-image text-xl" aria-hidden="true"></i>
                         </div>`
                  }
                  ${
                    extraPhotos > 0
                      ? `<span class="absolute right-1 bottom-1 rounded-md bg-slate-950/90 border border-slate-700 px-1.5 py-0.5 text-[10px] font-mono font-bold text-white">+${extraPhotos}</span>`
                      : ''
                  }
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-2">
                    <h4 class="truncate font-heading text-sm font-bold text-white group-hover:text-pink-300 transition-colors">${escapeHtml(
                      prod.marca
                    )}</h4>
                    <span class="shrink-0 font-mono text-sm font-bold text-emerald-400 tabular-nums">$${prod.precio.toFixed(
                      2
                    )}</span>
                  </div>
                  <p class="mt-0.5 truncate text-[11px] text-slate-400">${escapeHtml(subtitleParts.join(' · '))}</p>
                  <div class="mt-2 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1" aria-label="Tallas disponibles">
                      ${sizesHtml}
                    </div>
                    <div class="flex shrink-0 items-center gap-1.5">
                      <button
                        type="button"
                        data-edit-product-id="${prod.id}"
                        aria-label="Modificar ${escapeHtml(prod.marca)}"
                        title="Modificar"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-pink-500/30 bg-pink-500/15 text-xs text-pink-300 transition hover:bg-pink-500/30 active:scale-95"
                      >
                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                      </button>
                      <button
                        type="button"
                        data-delete-product-id="${prod.id}"
                        aria-label="Borrar ${escapeHtml(prod.marca)}"
                        title="Borrar"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-red-500/30 bg-red-500/15 text-xs text-red-400 transition hover:bg-red-500/30 active:scale-95"
                      >
                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                      </button>
