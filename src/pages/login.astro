          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/productos?select=${encodeURIComponent(selectQuery)}&activo=eq.true&order=id.desc`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          if (!res.ok) return;
          const rows = await res.json();
          if (!Array.isArray(rows)) return;

          countEl.textContent = `${rows.length} prendas activas`;
          listEl.innerHTML = rows
            .map((p: any) => {
              const imgs = [...(p.producto_imagenes || [])].sort((a, b) => a.orden - b.orden);
              const thumb =
                imgs[0]?.url ||
                'https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&q=80&w=300';
              const activeSizes = (p.producto_tallas || [])
                .filter((t: any) => (t.stock_talla ?? 1) > 0)
                .map((t: any) => t.talla)
                .join(', ');
              const priceNum = typeof p.precio === 'number' ? p.precio : parseFloat(String(p.precio));

              return `
                <div class="p-2.5 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <img src="${thumb}" alt="${p.nombre}" class="w-10 h-12 rounded-xl object-cover border border-slate-800 shrink-0" />
                    <div class="min-w-0">
                      <p class="font-bold text-xs text-white truncate">${p.nombre}</p>
                      <p class="text-[10px] font-mono text-slate-400">
                        <span class="text-emerald-400 font-bold">$${priceNum.toFixed(2)}</span> • Tallas: <span class="text-pink-400">${activeSizes || 'S, M, L, XL'}</span>
                      </p>
                    </div>
                  </div>
                  <span class="text-[10px] font-mono bg-slate-900 text-slate-400 px-2 py-1 rounded-lg border border-slate-800 shrink-0">
                    ID #${p.id}
                  </span>
                </div>
              `;
            })
            .join('');
        } catch {
          // Ignorar error de red
        }
      }

      const createProductForm = document.getElementById('create-product-form') as HTMLFormElement;
      createProductForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        const accessToken = getActiveAccessToken();
        if (!accessToken) {
          showToast('Tu sesión JWT expiró. Inicia sesión nuevamente.');
          return;
        }

        const name = (document.getElementById('prod-name') as HTMLInputElement).value.trim();
        const categorySlug = (document.getElementById('prod-category') as HTMLSelectElement).value;
        const priceVal = parseFloat((document.getElementById('prod-price') as HTMLInputElement).value);
        const stockVal = parseInt((document.getElementById('prod-stock') as HTMLInputElement).value, 10) || 5;
        const tag = (document.getElementById('prod-tag') as HTMLInputElement).value.trim() || 'Nuevo Drop';
        const fit = (document.getElementById('prod-fit') as HTMLInputElement).value.trim() || 'Oversized Fit';
        const modelInfo = (document.getElementById('prod-model') as HTMLInputElement).value.trim() || '1.78m — Talla L';

        if (!name || Number.isNaN(priceVal) || priceVal <= 0) {
          showToast('Completa el nombre y un precio válido para el producto');
          return;
        }

        if (pendingProductImages.length === 0) {
          showToast('Agrega al menos 1 imagen para el producto');
          return;
        }

        const sizesPayload = (['S', 'M', 'L', 'XL'] as const).map((sz, index) => {
          const active = (document.getElementById(`size-active-${sz}`) as HTMLInputElement)?.checked ?? true;
          const cm =
            (document.getElementById(`size-cm-${sz}`) as HTMLInputElement)?.value.trim() ||
            DEFAULT_MEASUREMENTS_BY_CAT.hoodies[sz];
          return {
            talla: sz,
            medidas_cm: cm,
            stock_talla: active ? Math.max(1, Math.ceil(stockVal / 4)) : 0,
            orden: index + 1,
          };
        });

        if (!sizesPayload.some((s) => s.stock_talla > 0)) {
          showToast('Selecciona al menos una talla disponible');
          return;
        }

        const rawSpecs = [
          (document.getElementById('prod-spec-1') as HTMLInputElement)?.value.trim(),
          (document.getElementById('prod-spec-2') as HTMLInputElement)?.value.trim(),
          (document.getElementById('prod-spec-3') as HTMLInputElement)?.value.trim(),
        ].filter(Boolean) as string[];

        const finalSpecs =
          rawSpecs.length > 0
            ? rawSpecs
            : [
                'Confección streetwear de alta densidad',
                'Costuras reforzadas y acabado suave al tacto',
                'Edición limitada URBAN_DROP',
              ];

        const btn = document.getElementById('btn-create-product') as HTMLButtonElement;
        const icon = document.getElementById('create-prod-icon') as HTMLElement;
        const text = document.getElementById('create-prod-text') as HTMLElement;

        btn.disabled = true;
        icon.className = 'fa-solid fa-circle-notch animate-spin text-sm';
        text.textContent = 'Guardando producto en Supabase PostgreSQL...';

        try {
          // 1. Obtener ID de la categoría por slug
          const catRes = await fetch(
            `${SUPABASE_URL}/rest/v1/categorias?select=id,slug&slug=eq.${encodeURIComponent(categorySlug)}&limit=1`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          const catRows = await catRes.json();
          const categoriaId = Array.isArray(catRows) && catRows[0]?.id ? catRows[0].id : 1;

          // 2. Insertar en `public.productos`
          const prodRes = await fetch(`${SUPABASE_URL}/rest/v1/productos`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=representation',
            },
            body: JSON.stringify({
              categoria_id: categoriaId,
              nombre: name,
              precio: priceVal,
              etiqueta: tag,
              corte_fit: fit,
              info_modelo: modelInfo,
              stock_disponible: stockVal,
              activo: true,
              orden: 1,
            }),
          });

          if (!prodRes.ok) {
            const errText = await prodRes.text();
            throw new Error(errText || 'Error al insertar producto');
          }

          const createdRows = await prodRes.json();
          const newProductId = createdRows[0]?.id;
          if (!newProductId) throw new Error('No se recibió el ID del nuevo producto');

          // 3. Insertar imágenes en `public.producto_imagenes` con metadatos Cloudflare R2
          const imagesRows = pendingProductImages.map((item, idx) => {
            const desc = normalizeImageDescriptor(item);
            return {
              producto_id: newProductId,
              url: desc.url,
              alt_text: `${name} (${fit}) - Vista ${idx + 1} | Catálogo URBAN_DROP`,
              orden: idx + 1,
              r2_object_key: desc.r2_object_key,
              content_hash: desc.content_hash,
              mime_type: desc.mime_type || 'image/webp',
              width: desc.width || 700,
              height: desc.height || 933,
              dominant_color: desc.dominant_color || '#0f172a',
              lqip_data_uri: desc.lqip_data_uri,
              exif_stripped: Boolean(desc.exif_stripped),
              magic_bytes_verified: Boolean(desc.magic_bytes_verified),
              cache_control: desc.cache_control || 'public, max-age=31536000, immutable',
            };
          });

          await fetch(`${SUPABASE_URL}/rest/v1/producto_imagenes`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(imagesRows),
          });

          // 4. Insertar tallas en `public.producto_tallas`
          const tallasRows = sizesPayload.map((t) => ({
            producto_id: newProductId,
            ...t,
          }));

          await fetch(`${SUPABASE_URL}/rest/v1/producto_tallas`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(tallasRows),
          });

          // 5. Insertar especificaciones en `public.producto_especificaciones`
          const specsRows = finalSpecs.map((desc, idx) => ({
            producto_id: newProductId,
            descripcion: desc,
            orden: idx + 1,
          }));

          await fetch(`${SUPABASE_URL}/rest/v1/producto_especificaciones`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(specsRows),
          });

          createProductForm.reset();
          (document.getElementById('prod-stock') as HTMLInputElement).value = '8';
          fillSuggestedMeasurements();
          await loadAdminProductsList();
          showToast(`¡Producto "${name}" dado de alta en el catálogo!`);
        } catch (err: any) {
          showToast('Error al guardar el producto. Verifica tu sesión JWT.');
        } finally {
          btn.disabled = false;
          icon.className = 'fa-solid fa-cloud-arrow-up text-sm';
          text.textContent = 'Publicar Producto en el Catálogo';
        }
      });

      // ==============================================================
