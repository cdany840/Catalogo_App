      // Renderizado del Panel de Sesión e Inspector JWT
      function renderAuthenticatedSession(sessionData: {
        access_token: string;
        refresh_token?: string;
        user?: { id: string; email: string };
      }) {
        const report = inspectAndValidateJwt(sessionData.access_token);
        if (!report.valid || !report.payload) {
          sessionStorage.removeItem(SESSION_STORAGE_KEY);
          localStorage.removeItem(SESSION_STORAGE_KEY);
          return;
        }

        loginCardView.classList.add('hidden');
        jwtSessionView.classList.remove('hidden');

        const userEmailEl = document.getElementById('jwt-user-email');
        const roleBadgeEl = document.getElementById('jwt-role-badge');
        const algPillEl = document.getElementById('jwt-alg-pill');

        if (userEmailEl) userEmailEl.textContent = report.payload.email || sessionData.user?.email || 'Usuario Autenticado';
        if (roleBadgeEl) roleBadgeEl.textContent = `ROL: ${report.checks.roleFromAppMetadata.toUpperCase()}`;
        if (algPillEl) algPillEl.textContent = `ALG: ${report.header?.alg || 'HS256'} • TYP: ${report.header?.typ || 'JWT'}`;

        const checksGrid = document.getElementById('jwt-checks-grid');
        if (checksGrid) {
          const checkItems = [
            { label: 'Estructura 3 Segmentos', ok: report.checks.structureThreeParts },
            { label: 'Algoritmo Fuerte (!none)', ok: report.checks.algorithmAllowed },
            { label: 'Vigencia Temporal (exp)', ok: report.checks.notExpired },
            { label: 'Emisor Verificado (iss)', ok: report.checks.issuerMatches },
            { label: `RBAC: ${report.checks.roleFromAppMetadata}`, ok: true },
            { label: 'Session ID Vinculado', ok: report.checks.sessionIdPresent },
          ];

          checksGrid.innerHTML = checkItems
            .map(
              (c) => `
              <div class="p-2 rounded-xl bg-slate-950 border ${
                c.ok ? 'border-emerald-500/30 text-emerald-300' : 'border-red-500/30 text-red-300'
              } flex items-center gap-2">
                <i class="fa-solid ${c.ok ? 'fa-circle-check text-emerald-400' : 'fa-circle-xmark text-red-400'} text-xs"></i>
                <span class="font-medium truncate">${c.label}</span>
              </div>
            `
            )
            .join('');
        }

        const rawColorized = document.getElementById('jwt-raw-colorized');
        if (rawColorized) {
          const [h, p, s] = sessionData.access_token.split('.');
          rawColorized.innerHTML = `<span class="text-pink-400">${h}</span>.<span class="text-emerald-400">${p}</span>.<span class="text-cyan-400">${s}</span>`;
        }

        const payloadPre = document.getElementById('jwt-payload-pre');
        if (payloadPre) {
          payloadPre.textContent = JSON.stringify(
            {
              sub: report.payload.sub,
              email: report.payload.email,
              role: report.payload.role,
              app_metadata: report.payload.app_metadata,
              session_id: report.payload.session_id,
              iat: report.payload.iat,
              exp: report.payload.exp,
              iss: report.payload.iss,
            },
            null,
            2
          );
        }

        if (expInterval) clearInterval(expInterval);
        const updateCountdown = () => {
          const expEl = document.getElementById('jwt-exp-countdown');
          if (!expEl || !report.payload?.exp) return;
          const diff = report.payload.exp - Math.floor(Date.now() / 1000);
          if (diff <= 0) {
            expEl.textContent = 'EXPIRADO';
            expEl.className = 'font-mono font-bold text-sm text-red-400';
            if (expInterval) clearInterval(expInterval);
            return;
          }
          const mins = Math.floor(diff / 60);
          const secs = diff % 60;
          expEl.textContent = `${mins}m ${String(secs).padStart(2, '0')}s`;
        };
        updateCountdown();
        expInterval = setInterval(updateCountdown, 1000);

        loadUserAuditLogs(sessionData.access_token);
        loadAdminProductsList();
        loadStoreConfig();
      }

      // Envío del Formulario de Login contra Supabase Auth
      loginForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        errorBanner.classList.add('hidden');
        errorBanner.classList.remove('flex');

        if (updateRateLimitUI()) return;

        const csrfInput = (document.getElementById('csrf-token-input') as HTMLInputElement)?.value;
        const expectedCsrf = sessionStorage.getItem('urban_drop_csrf_nonce');
        if (!csrfInput || csrfInput !== expectedCsrf) {
          errorTitle.textContent = 'Fallo de validación CSRF (OWASP A01:2025)';
          errorDesc.textContent = 'El token de integridad del formulario no es válido. Recarga la página.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
          return;
        }

        const email = emailInput.value.trim().toLowerCase();
        const password = passwordInput.value;

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length < 10) {
          errorTitle.textContent = 'Formato de credenciales inválido';
          errorDesc.textContent = 'Ingresa un correo corporativo válido y una contraseña de al menos 10 caracteres.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
          return;
        }

        const startTime = Date.now();
        submitBtn.disabled = true;
        submitSpinner.className = 'fa-solid fa-circle-notch animate-spin text-sm';
        submitBtnText.textContent = 'Verificando credenciales y firmando JWT...';

        try {
          const response = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, password }),
          });

          const elapsed = Date.now() - startTime;
          if (elapsed < 450) {
            await new Promise((r) => setTimeout(r, 450 - elapsed));
          }

          if (!response.ok) {
            const rl = getRateLimitState();
            const nextFailed = rl.failedAttempts + 1;
            const isLocked = nextFailed >= MAX_ATTEMPTS;

            setRateLimitState({
              failedAttempts: nextFailed,
              lockoutUntil: isLocked ? Date.now() + LOCKOUT_SECONDS * 1000 : 0,
            });

            await logAuthAuditEvent(
              isLocked ? 'RATE_LIMIT_LOCK' : 'LOGIN_FAILED',
              email,
              null,
              null,
              { attempt: nextFailed }
            );

            errorTitle.textContent = 'Autenticación rechazada';
            errorDesc.textContent =
              'Credenciales inválidas o cuenta no autorizada. Por seguridad no se especifica qué campo falló (OWASP A07:2025).';
            errorBanner.classList.remove('hidden');
            errorBanner.classList.add('flex');
            return;
          }

          const sessionData = await response.json();
          const verification = inspectAndValidateJwt(sessionData.access_token);

          if (!verification.valid) {
            throw new Error(verification.errors.join(' '));
          }

          setRateLimitState({ failedAttempts: 0, lockoutUntil: 0 });
          const serializedSession = JSON.stringify({
            access_token: sessionData.access_token,
            refresh_token: sessionData.refresh_token,
            user: sessionData.user,
          });
          sessionStorage.setItem(SESSION_STORAGE_KEY, serializedSession);
          localStorage.setItem(SESSION_STORAGE_KEY, serializedSession);

          await logAuthAuditEvent(
            'LOGIN_SUCCESS',
            email,
            sessionData.user?.id || verification.payload?.sub || null,
            sessionData.access_token,
            { alg: verification.header?.alg, role: verification.checks.roleFromAppMetadata }
          );

          passwordInput.value = '';
          initCsrfToken();
          showToast('¡Autenticación exitosa! Panel de Alta y Configuración activo.');
          renderAuthenticatedSession(sessionData);
        } catch {
          errorTitle.textContent = 'Error de comunicación segura';
          errorDesc.textContent = 'No fue posible establecer conexión con el servidor de autenticación.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
        } finally {
          submitBtn.disabled = false;
          submitSpinner.className = 'fa-solid fa-fingerprint text-sm';
          submitBtnText.textContent = 'Autenticar y Abrir Panel Admin';
          updateRateLimitUI();
        }
      });

      document.getElementById('btn-fill-demo')?.addEventListener('click', () => {
        emailInput.value = 'admin@urbandrop.store';
        passwordInput.value = 'UrbanDrop#2025!Secure';
        passwordInput.dispatchEvent(new Event('input'));
        errorBanner.classList.add('hidden');
        showToast('Credenciales Admin cargadas.');
      });

      document.getElementById('btn-fill-invalid')?.addEventListener('click', () => {
        emailInput.value = 'admin@urbandrop.store';
        passwordInput.value = 'IntentoFallido#9999';
        passwordInput.dispatchEvent(new Event('input'));
        showToast('Credenciales de prueba fallida cargadas.');
      });

      document.getElementById('btn-copy-jwt')?.addEventListener('click', async () => {
        const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw || !navigator.clipboard) return;
        const parsed = JSON.parse(raw);
        await navigator.clipboard.writeText(parsed.access_token);
        showToast('Token JWT copiado al portapapeles');
      });

      document.getElementById('btn-verify-server-jwt')?.addEventListener('click', async () => {
        const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);

        try {
          const res = await fetch(`${SUPABASE_URL}/auth/v1/user`, {
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${parsed.access_token}`,
            },
          });
          if (res.ok) {
            const userObj = await res.json();
            await logAuthAuditEvent('TOKEN_VERIFIED', userObj.email || 'admin@urbandrop.store', userObj.id, parsed.access_token, {
              verified_endpoint: '/auth/v1/user',
            });
            await loadUserAuditLogs(parsed.access_token);
            showToast('Firma y sesión JWT validadas contra Supabase Auth');
          } else {
            showToast('El token ya no es válido en el servidor');
          }
        } catch {
          showToast('Error al verificar el token con el servidor');
        }
      });

      document.getElementById('btn-logout-jwt')?.addEventListener('click', async () => {
        const raw =
          sessionStorage.getItem(SESSION_STORAGE_KEY) ||
          localStorage.getItem(SESSION_STORAGE_KEY);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            await logAuthAuditEvent(
              'LOGOUT',
              parsed.user?.email || 'admin@urbandrop.store',
              parsed.user?.id || null,
              parsed.access_token
            );
            await fetch(`${SUPABASE_URL}/auth/v1/logout`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${parsed.access_token}`,
              },
            });
          } catch {
            // Continúa limpieza local
          }
        }

        sessionStorage.removeItem(SESSION_STORAGE_KEY);
        localStorage.removeItem(SESSION_STORAGE_KEY);
        if (expInterval) clearInterval(expInterval);
        jwtSessionView.classList.add('hidden');
        loginCardView.classList.remove('hidden');
        initCsrfToken();
        showToast('Sesión cerrada y token JWT revocado');
      });

      const owaspModal = document.getElementById('owasp-modal');
      document.getElementById('btn-owasp-info')?.addEventListener('click', () => {
        owaspModal?.classList.remove('opacity-0', 'pointer-events-none');
      });
      document.getElementById('close-owasp-modal')?.addEventListener('click', () => {
        owaspModal?.classList.add('opacity-0', 'pointer-events-none');
      });
      owaspModal?.addEventListener('click', (e) => {
        if (e.target === owaspModal) owaspModal.classList.add('opacity-0', 'pointer-events-none');
      });

      // Restaurar sesión activa si el JWT en sessionStorage o localStorage sigue vigente
      try {
        const existingRaw =
          sessionStorage.getItem(SESSION_STORAGE_KEY) ||
          localStorage.getItem(SESSION_STORAGE_KEY);
        if (existingRaw) {
          sessionStorage.setItem(SESSION_STORAGE_KEY, existingRaw);
          localStorage.setItem(SESSION_STORAGE_KEY, existingRaw);
          const existingSession = JSON.parse(existingRaw);
          renderAuthenticatedSession(existingSession);
        }
      } catch {
        sessionStorage.removeItem(SESSION_STORAGE_KEY);
        localStorage.removeItem(SESSION_STORAGE_KEY);
      }
    </script>

    <style>
      .font-heading {
        font-family: 'Space Grotesk', sans-serif;
      }
    </style>
  </body>
</html>
