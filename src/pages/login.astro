      function escapeHtml(text: string): string {
        return String(text || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function renderBrandSelectOptions(selectedBrand = '') {
        const brandSelect = document.getElementById('prod-marca') as HTMLSelectElement | null;
        if (!brandSelect) return;
        if (selectedBrand && !adminBrandsCache.some((b) => b.toLowerCase() === selectedBrand.toLowerCase())) {
          adminBrandsCache.push(selectedBrand);
        }
        const sorted = [...adminBrandsCache].sort((a, b) => a.localeCompare(b, 'es'));
        brandSelect.innerHTML =
          `<option value="" disabled ${!selectedBrand ? 'selected' : ''}>Selecciona una marca...</option>` +
          sorted
            .map(
              (b) =>
                `<option value="${escapeHtml(b)}" ${b === selectedBrand ? 'selected' : ''}>${escapeHtml(b)}</option>`
            )
            .join('');
      }

