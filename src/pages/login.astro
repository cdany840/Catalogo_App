          })
          .join('');
      }

      async function loadAdminProductsList() {
        const skeletonsEl = document.getElementById('admin-loading-skeletons');
        const listEl = document.getElementById('admin-products-list');
        const emptyEl = document.getElementById('admin-empty-state');
        const refreshIcon = document.getElementById('refresh-products-icon');

        if (adminProductsCache.length === 0) {
          skeletonsEl?.classList.remove('hidden');
          listEl?.classList.add('hidden');
          emptyEl?.classList.add('hidden');
        }
        refreshIcon?.classList.add('animate-spin');

        try {
          await loadAdminCategories();
          const selectQuery =
            'id,nombre,precio,categorias(slug,nombre),producto_imagenes(url,orden),producto_tallas(talla,medidas_cm,stock_talla,orden),producto_especificaciones(descripcion,orden)';
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/productos?select=${encodeURIComponent(selectQuery)}&activo=eq.true&order=id.desc`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          if (!res.ok) {
            renderAdminCatalog();
            return;
          }
          const rows = await res.json();
          if (!Array.isArray(rows)) return;

          adminProductsCache = rows.map((p: any) => {
            const imgs = [...(p.producto_imagenes || [])]
              .sort((a: any, b: any) => (a.orden ?? 0) - (b.orden ?? 0))
              .map((img: any) => String(img.url));
            const catSlug = String(p.categorias?.slug || 'hoodies');
            const catName = String(p.categorias?.nombre || catSlug);
            const fallbackMeas = DEFAULT_MEASUREMENTS_BY_CAT[catSlug] || DEFAULT_MEASUREMENTS_BY_CAT.hoodies;
            const measurements: Record<AdminSizeKey, string> = { ...fallbackMeas };
            const activeSizes: AdminSizeKey[] = [];

            for (const t of p.producto_tallas || []) {
              const sz = String(t.talla) as AdminSizeKey;
              if (ADMIN_ALL_SIZES.includes(sz)) {
                if (t.medidas_cm) measurements[sz] = String(t.medidas_cm);
                if ((t.stock_talla ?? 1) > 0) activeSizes.push(sz);
              }
            }

            if ((p.producto_tallas || []).length === 0) {
              activeSizes.push('S', 'M', 'L', 'XL');
            }

            const specs = [...(p.producto_especificaciones || [])]
              .sort((a: any, b: any) => (a.orden ?? 0) - (b.orden ?? 0))
              .map((s: any) => String(s.descripcion))
              .filter(Boolean);

            const priceNum = typeof p.precio === 'number' ? p.precio : parseFloat(String(p.precio)) || 0;
            const marcaName = String(p.nombre || '').trim();
            if (marcaName && !adminBrandsCache.some((b) => b.toLowerCase() === marcaName.toLowerCase())) {
              adminBrandsCache.push(marcaName);
            }

            return {
              id: Number(p.id),
              marca: marcaName,
              precio: priceNum,
              categorySlug: catSlug,
              categoryName: catName,
              images: imgs,
              activeSizes: ADMIN_ALL_SIZES.filter((sz) => activeSizes.includes(sz)),
              measurements,
              specs,
            };
          });

          renderAdminCatalog();
        } catch {
          renderAdminCatalog();
        } finally {
          refreshIcon?.classList.remove('animate-spin');
        }
      }

      // Buscador, botón limpiar, refresh y filtro por tallas
      const adminSearchInput = document.getElementById('admin-search-input') as HTMLInputElement | null;
      const adminClearSearchBtn = document.getElementById('admin-clear-search-btn');

      adminSearchInput?.addEventListener('input', (e) => {
        adminSearchQuery = (e.target as HTMLInputElement).value;
        const hasText = adminSearchQuery.length > 0;
        adminClearSearchBtn?.classList.toggle('hidden', !hasText);
        adminClearSearchBtn?.classList.toggle('flex', hasText);
        renderAdminCatalog();
      });

      adminClearSearchBtn?.addEventListener('click', () => {
        adminSearchQuery = '';
        if (adminSearchInput) adminSearchInput.value = '';
        adminClearSearchBtn.classList.add('hidden');
        adminClearSearchBtn.classList.remove('flex');
        renderAdminCatalog();
      });

      document.querySelectorAll('.admin-size-filter-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          adminActiveSizeFilter = ((chip as HTMLElement).dataset.sizeFilter || 'ALL') as 'ALL' | AdminSizeKey;
          document.querySelectorAll('.admin-size-filter-chip').forEach((c) => {
            const isSelected = c === chip;
            c.className = isSelected
              ? 'admin-size-filter-chip min-h-[44px] min-w-[44px] shrink-0 rounded-xl bg-pink-500 px-4 text-xs font-bold text-white shadow-md shadow-pink-500/20 transition active:scale-95'
              : 'admin-size-filter-chip min-h-[44px] min-w-[44px] shrink-0 rounded-xl border border-slate-800 bg-slate-900 px-3 text-xs font-bold text-slate-300 transition hover:bg-slate-800 hover:text-white active:scale-95';
          });
          renderAdminCatalog();
        });
      });

      document.getElementById('btn-refresh-products')?.addEventListener('click', () => {
        loadAdminProductsList();
      });

      document.getElementById('admin-empty-action-btn')?.addEventListener('click', () => {
        const isFiltering = adminSearchQuery.trim() !== '' || adminActiveSizeFilter !== 'ALL';
        if (isFiltering) {
          adminSearchQuery = '';
          if (adminSearchInput) adminSearchInput.value = '';
          adminClearSearchBtn?.classList.add('hidden');
          adminClearSearchBtn?.classList.remove('flex');
          const allChip = document.querySelector('.admin-size-filter-chip[data-size-filter="ALL"]') as HTMLElement | null;
          allChip?.click();
        } else {
          openAdminProductForm(null);
        }
      });

      // Contracción dinámica del FAB al hacer scroll
      let lastAdminScrollY = window.scrollY;
      const fabCreateLabel = document.getElementById('fab-create-label');
      window.addEventListener(
        'scroll',
        () => {
          const currentY = window.scrollY;
          if (currentY > lastAdminScrollY + 12) {
            fabCreateLabel?.classList.add('hidden');
          } else if (currentY < lastAdminScrollY - 12) {
            fabCreateLabel?.classList.remove('hidden');
          }
          lastAdminScrollY = currentY;
        },
        { passive: true }
      );

      // ==============================================================
      // MODAL 1: DETALLE DE PRODUCTO (LECTURA SEGURA ANTES DE EDITAR)
      // ==============================================================
      const adminDetailModal = document.getElementById('admin-detail-modal');

      function openAdminProductDetail(id: number) {
        const prod = adminProductsCache.find((p) => p.id === id);
        if (!prod || !adminDetailModal) return;
        selectedAdminProductId = prod.id;

        const nameEl = document.getElementById('admin-detail-name');
        const priceEl = document.getElementById('admin-detail-price');
        const catEl = document.getElementById('admin-detail-category');

        if (nameEl) nameEl.textContent = prod.marca;
        if (priceEl) priceEl.textContent = `$${prod.precio.toFixed(2)}`;
        if (catEl) catEl.textContent = prod.categoryName;

        const mainImg = document.getElementById('admin-detail-main-img') as HTMLImageElement | null;
        const noImg = document.getElementById('admin-detail-no-img');
        const thumbsContainer = document.getElementById('admin-detail-thumbs');

        if (prod.images.length > 0 && mainImg) {
          mainImg.src = prod.images[0];
          mainImg.alt = prod.marca;
          mainImg.classList.remove('hidden');
          noImg?.classList.add('hidden');
          noImg?.classList.remove('flex');

          if (thumbsContainer) {
            thumbsContainer.innerHTML =
              prod.images.length > 1
                ? prod.images
                    .map(
                      (src, idx) => `
                  <button type="button" data-thumb-src="${escapeHtml(src)}" class="admin-detail-thumb-btn h-14 w-14 shrink-0 overflow-hidden rounded-xl border-2 ${
                        idx === 0 ? 'border-pink-500' : 'border-slate-800 opacity-60'
                      }">
                    <img src="${escapeHtml(src)}" alt="" class="h-full w-full object-cover" />
                  </button>`
                    )
                    .join('')
                : '';
          }
        } else {
          mainImg?.classList.add('hidden');
          noImg?.classList.remove('hidden');
          noImg?.classList.add('flex');
          if (thumbsContainer) thumbsContainer.innerHTML = '';
        }

        const sizesEl = document.getElementById('admin-detail-sizes');
        if (sizesEl) {
          sizesEl.innerHTML = ADMIN_ALL_SIZES.map((sz) => {
            const available = prod.activeSizes.includes(sz);
            return `
              <div class="flex h-11 items-center justify-center rounded-xl border text-xs font-mono font-bold ${
                available
                  ? 'border-pink-500/40 bg-pink-500/20 text-pink-200'
                  : 'border-slate-800 bg-slate-950 text-slate-600 line-through'
              }">
                ${sz}
              </div>
            `;
          }).join('');
        }

        const measEl = document.getElementById('admin-detail-measurements');
        if (measEl) {
          measEl.innerHTML = prod.activeSizes
            .map((sz) => `<div><span class="text-pink-400 font-bold">${sz}:</span> ${escapeHtml(prod.measurements[sz])}</div>`)
            .join('');
        }

        const specsWrapper = document.getElementById('admin-detail-specs-wrapper');
        const specsList = document.getElementById('admin-detail-specs');
        if (specsWrapper && specsList) {
          if (prod.specs.length > 0) {
            specsList.innerHTML = prod.specs
              .map((s) => `<li class="flex items-start gap-2"><span class="text-pink-400">•</span><span>${escapeHtml(s)}</span></li>`)
              .join('');
            specsWrapper.classList.remove('hidden');
          } else {
            specsWrapper.classList.add('hidden');
          }
        }

        adminDetailModal.classList.remove('hidden');
        adminDetailModal.classList.add('flex');
      }

      document.getElementById('admin-products-list')?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const editBtn = target.closest('[data-edit-product-id]') as HTMLElement | null;
        if (editBtn) {
          e.stopPropagation();
          const id = Number(editBtn.dataset.editProductId);
          if (!Number.isNaN(id)) openAdminProductForm(id);
          return;
        }
        const deleteBtn = target.closest('[data-delete-product-id]') as HTMLElement | null;
        if (deleteBtn) {
          e.stopPropagation();
          const id = Number(deleteBtn.dataset.deleteProductId);
          if (!Number.isNaN(id)) openDeleteConfirmation(id);
          return;
        }
        const card = target.closest('.admin-product-card') as HTMLElement | null;
        if (!card) return;
        const id = Number(card.dataset.productId);
        if (!Number.isNaN(id)) openAdminProductDetail(id);
      });

      document.getElementById('admin-detail-thumbs')?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.admin-detail-thumb-btn') as HTMLElement | null;
        if (!btn) return;
        const mainImg = document.getElementById('admin-detail-main-img') as HTMLImageElement | null;
        if (mainImg && btn.dataset.thumbSrc) mainImg.src = btn.dataset.thumbSrc;
        document.querySelectorAll('.admin-detail-thumb-btn').forEach((b) => {
          const isCur = b === btn;
          b.classList.toggle('border-pink-500', isCur);
          b.classList.toggle('border-slate-800', !isCur);
          b.classList.toggle('opacity-60', !isCur);
        });
      });

      document.getElementById('close-admin-detail-btn')?.addEventListener('click', () => {
        adminDetailModal?.classList.add('hidden');
        adminDetailModal?.classList.remove('flex');
      });

      adminDetailModal?.addEventListener('click', (e) => {
        if (e.target === adminDetailModal) {
          adminDetailModal.classList.add('hidden');
          adminDetailModal.classList.remove('flex');
        }
      });

      document.getElementById('admin-detail-edit-btn')?.addEventListener('click', () => {
        adminDetailModal?.classList.add('hidden');
        adminDetailModal?.classList.remove('flex');
        if (selectedAdminProductId !== null) {
          openAdminProductForm(selectedAdminProductId);
        }
      });

      document.getElementById('admin-detail-delete-btn')?.addEventListener('click', () => {
        if (selectedAdminProductId !== null) {
          openDeleteConfirmation(selectedAdminProductId);
        }
      });

      // ==============================================================
      // MODAL 2: FORMULARIO CREAR / EDITAR + CREACIÓN RÁPIDA CATEGORÍA
      // ==============================================================
      const adminFormModal = document.getElementById('admin-form-modal');
      const createProductForm = document.getElementById('create-product-form') as HTMLFormElement;
      const DEFAULT_R2_TELEMETRY_STATUS = 'READY • SHA-256 + EXIF STRIP';
      const DEFAULT_R2_TELEMETRY_DETAIL = '700×933 • Immutable';

      function syncAdminSizeToggleButtons() {
        document.querySelectorAll('.admin-size-toggle-btn').forEach((btn) => {
          const sz = (btn as HTMLElement).dataset.sizeToggle as AdminSizeKey;
          const active = formSelectedSizes.has(sz);
          btn.setAttribute('aria-pressed', String(active));
          btn.className = active
            ? 'admin-size-toggle-btn flex min-h-[48px] items-center justify-center rounded-xl border border-pink-500 bg-pink-500 text-sm font-bold text-white shadow-md shadow-pink-500/20 transition active:scale-95'
            : 'admin-size-toggle-btn flex min-h-[48px] items-center justify-center rounded-xl border border-slate-800 bg-slate-950 text-sm font-bold text-slate-400 hover:text-white transition active:scale-95';
        });
      }

      function toggleInlineCategoryCreator(open: boolean) {
        const box = document.getElementById('new-category-box');
        const btn = document.getElementById('toggle-new-category-btn');
        const input = document.getElementById('new-category-input') as HTMLInputElement | null;
        box?.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
        if (open && input) {
          input.value = '';
          setTimeout(() => input.focus(), 50);
        }
      }

      async function handleCreateInlineCategory() {
        const input = document.getElementById('new-category-input') as HTMLInputElement | null;
        const raw = input?.value.trim() || '';
        if (!raw) {
          input?.focus();
          return;
        }

        const existing = adminCategoriesCache.find((c) => c.nombre.toLowerCase() === raw.toLowerCase());
        if (existing) {
          renderCategorySelectOptions(existing.slug);
          toggleInlineCategoryCreator(false);
          showToast(`Categoría "${existing.nombre}" seleccionada`);
          return;
        }

        const slug = raw
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');

        const accessToken = getActiveAccessToken();
        let createdId: number | undefined;

        if (accessToken) {
          try {
            const res = await fetch(`${SUPABASE_URL}/rest/v1/categorias`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
                Prefer: 'return=representation',
              },
              body: JSON.stringify({
                slug,
                nombre: raw,
                icono: 'fa-shirt',
                orden: adminCategoriesCache.length + 1,
                activo: true,
              }),
            });
            if (res.ok) {
              const rows = await res.json();
              if (Array.isArray(rows) && rows[0]?.id) createdId = Number(rows[0].id);
            }
          } catch {
            // Continúa con alta local si la política RLS restringe inserción de categorías
          }
        }

        adminCategoriesCache.push({ id: createdId, slug, nombre: raw });
        renderCategorySelectOptions(slug);
        toggleInlineCategoryCreator(false);
        showToast(`Categoría "${raw}" agregada`);
      }

      function toggleInlineBrandCreator(open: boolean) {
        const box = document.getElementById('new-brand-box');
        const btn = document.getElementById('toggle-new-brand-btn');
        const input = document.getElementById('new-brand-input') as HTMLInputElement | null;
        box?.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
        if (open && input) {
          input.value = '';
          setTimeout(() => input.focus(), 50);
        }
      }

      function handleCreateInlineBrand() {
        const input = document.getElementById('new-brand-input') as HTMLInputElement | null;
        const raw = input?.value.trim() || '';
        if (!raw) {
          input?.focus();
          return;
        }
        const existing = adminBrandsCache.find((b) => b.toLowerCase() === raw.toLowerCase());
        if (existing) {
          renderBrandSelectOptions(existing);
          toggleInlineBrandCreator(false);
          document.getElementById('error-prod-marca')?.classList.add('hidden');
          showToast(`Marca "${existing}" seleccionada`);
          return;
        }
        adminBrandsCache.push(raw);
        renderBrandSelectOptions(raw);
        toggleInlineBrandCreator(false);
        document.getElementById('error-prod-marca')?.classList.add('hidden');
        showToast(`Marca "${raw}" creada`);
      }

      document.getElementById('toggle-new-brand-btn')?.addEventListener('click', () => {
        const isHidden = document.getElementById('new-brand-box')?.classList.contains('hidden') ?? true;
        toggleInlineBrandCreator(isHidden);
      });
      document.getElementById('cancel-new-brand-btn')?.addEventListener('click', () => toggleInlineBrandCreator(false));
      document.getElementById('save-new-brand-btn')?.addEventListener('click', handleCreateInlineBrand);
      document.getElementById('new-brand-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleCreateInlineBrand();
        }
      });

      document.getElementById('toggle-new-category-btn')?.addEventListener('click', () => {
        const isHidden = document.getElementById('new-category-box')?.classList.contains('hidden') ?? true;
        toggleInlineCategoryCreator(isHidden);
      });
      document.getElementById('cancel-new-category-btn')?.addEventListener('click', () => toggleInlineCategoryCreator(false));
      document.getElementById('save-new-category-btn')?.addEventListener('click', handleCreateInlineCategory);
      document.getElementById('new-category-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleCreateInlineCategory();
        }
      });

      function resetCreateProductForm() {
        createProductForm?.reset();
        const editIdEl = document.getElementById('prod-editing-id') as HTMLInputElement | null;
        if (editIdEl) editIdEl.value = '';

        const fileInput = document.getElementById('prod-image-files') as HTMLInputElement | null;
        if (fileInput) fileInput.value = '';

        const imgUrlInput = document.getElementById('prod-image-url') as HTMLInputElement | null;
        if (imgUrlInput) imgUrlInput.value = '';

        pendingProductImages = [];
        renderProductImagesPreview();

        formSelectedSizes = new Set<AdminSizeKey>(['S', 'M', 'L', 'XL']);
        syncAdminSizeToggleButtons();

        const cc = document.getElementById('desc-char-count');
        if (cc) cc.textContent = '0/140';

        const statusEl = document.getElementById('r2-telemetry-status');
        const detailEl = document.getElementById('r2-telemetry-detail');
        if (statusEl) statusEl.textContent = DEFAULT_R2_TELEMETRY_STATUS;
        if (detailEl) detailEl.textContent = DEFAULT_R2_TELEMETRY_DETAIL;

        fillSuggestedMeasurements();
      }

      function openAdminProductForm(productId: number | null = null) {
        ['error-prod-marca', 'error-prod-price', 'error-prod-tallas'].forEach((id) =>
          document.getElementById(id)?.classList.add('hidden')
        );
        toggleInlineBrandCreator(false);
        toggleInlineCategoryCreator(false);

        const isEdit = productId !== null;
        const prod = isEdit ? adminProductsCache.find((p) => p.id === productId) : null;

        const titleEl = document.getElementById('product-form-modal-title');
        if (titleEl) titleEl.textContent = prod ? 'Editar producto' : 'Nuevo producto';

        const editIdEl = document.getElementById('prod-editing-id') as HTMLInputElement | null;
        if (editIdEl) editIdEl.value = prod ? String(prod.id) : '';

        renderBrandSelectOptions(prod ? prod.marca : '');
        renderCategorySelectOptions(prod ? prod.categorySlug : adminCategoriesCache[0]?.slug || 'hoodies');

        (document.getElementById('prod-price') as HTMLInputElement).value = prod ? String(prod.precio) : '';

        const matSelect = document.getElementById('prod-material') as HTMLSelectElement | null;
        const spec1El = document.getElementById('prod-spec-1') as HTMLTextAreaElement | null;
        const spec2El = document.getElementById('prod-spec-2') as HTMLInputElement | null;
        const spec3El = document.getElementById('prod-spec-3') as HTMLInputElement | null;

        if (prod) {
          const matchedMat = Array.from(matSelect?.options || []).find((opt) =>
            opt.value && prod.specs[0]?.toLowerCase().includes(opt.value.toLowerCase())
          );
          if (matSelect) matSelect.value = matchedMat ? matchedMat.value : '';
          if (spec1El) spec1El.value = prod.specs[0] || '';
          if (spec2El) spec2El.value = prod.specs[1] || '';
          if (spec3El) spec3El.value = prod.specs[2] || '';
        } else {
          if (matSelect) matSelect.value = '';
          if (spec1El) spec1El.value = '';
          if (spec2El) spec2El.value = '';
          if (spec3El) spec3El.value = '';
        }

        const cc = document.getElementById('desc-char-count');
        if (cc && spec1El) cc.textContent = `${spec1El.value.length}/140`;

        formSelectedSizes = new Set<AdminSizeKey>(prod ? prod.activeSizes : ['S', 'M', 'L', 'XL']);
        syncAdminSizeToggleButtons();

        ADMIN_ALL_SIZES.forEach((sz) => {
          const input = document.getElementById(`size-cm-${sz}`) as HTMLInputElement | null;
          if (input) {
            if (prod) {
              input.value = prod.measurements[sz] || '';
            } else {
              const template = DEFAULT_MEASUREMENTS_BY_CAT[prodCategorySelect?.value || 'hoodies'] || DEFAULT_MEASUREMENTS_BY_CAT.hoodies;
              input.value = template[sz];
            }
          }
        });

        pendingProductImages = prod ? [...prod.images] : [];
        renderProductImagesPreview();

        document.getElementById('delete-product-zone')?.classList.toggle('hidden', !prod);

        adminFormModal?.classList.remove('hidden');
        adminFormModal?.classList.add('flex');
        if (createProductForm) createProductForm.scrollTop = 0;
        requestAnimationFrame(() => {
          if (createProductForm) createProductForm.scrollTop = 0;
        });
      }

      document.getElementById('fab-create-product-btn')?.addEventListener('click', () => openAdminProductForm(null));
      document.getElementById('cancel-product-form-btn')?.addEventListener('click', () => {
        adminFormModal?.classList.add('hidden');
        adminFormModal?.classList.remove('flex');
      });

      document.querySelectorAll('.admin-size-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sz = (btn as HTMLElement).dataset.sizeToggle as AdminSizeKey;
          if (formSelectedSizes.has(sz)) {
            formSelectedSizes.delete(sz);
          } else {
            formSelectedSizes.add(sz);
          }
          syncAdminSizeToggleButtons();
          document.getElementById('error-prod-tallas')?.classList.add('hidden');
        });
      });

      document.getElementById('select-all-sizes-btn')?.addEventListener('click', () => {
        if (formSelectedSizes.size === ADMIN_ALL_SIZES.length) {
          formSelectedSizes.clear();
        } else {
          ADMIN_ALL_SIZES.forEach((sz) => formSelectedSizes.add(sz));
        }
        syncAdminSizeToggleButtons();
        document.getElementById('error-prod-tallas')?.classList.add('hidden');
      });

      document.getElementById('prod-spec-1')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLTextAreaElement).value;
        const cc = document.getElementById('desc-char-count');
        if (cc) cc.textContent = `${val.length}/140`;
      });

      createProductForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        const accessToken = getActiveAccessToken();
        if (!accessToken) {
          showToast('Tu sesión JWT expiró. Inicia sesión nuevamente.');
          return;
        }

        const editingIdRaw = (document.getElementById('prod-editing-id') as HTMLInputElement)?.value;
        const editingId = editingIdRaw ? Number(editingIdRaw) : null;

        const marca = (document.getElementById('prod-marca') as HTMLSelectElement).value.trim();
        const categorySlug = (document.getElementById('prod-category') as HTMLSelectElement).value;
        const priceVal = parseFloat((document.getElementById('prod-price') as HTMLInputElement).value);
        const materialVal = (document.getElementById('prod-material') as HTMLSelectElement)?.value.trim() || '';

        let valid = true;
        if (!marca) {
          document.getElementById('error-prod-marca')?.classList.remove('hidden');
          valid = false;
        } else {
          document.getElementById('error-prod-marca')?.classList.add('hidden');
        }
        if (Number.isNaN(priceVal) || priceVal <= 0) {
          document.getElementById('error-prod-price')?.classList.remove('hidden');
          valid = false;
        } else {
          document.getElementById('error-prod-price')?.classList.add('hidden');
        }
        if (formSelectedSizes.size === 0) {
          document.getElementById('error-prod-tallas')?.classList.remove('hidden');
          valid = false;
        } else {
          document.getElementById('error-prod-tallas')?.classList.add('hidden');
        }
        if (!valid) {
          showToast('Revisa los campos obligatorios del producto');
          return;
        }

        if (pendingProductImages.length === 0) {
          showToast('Agrega al menos 1 imagen para el producto');
          return;
        }

        const sizesPayload = ADMIN_ALL_SIZES.map((sz, index) => {
          const active = formSelectedSizes.has(sz);
          const cm =
            (document.getElementById(`size-cm-${sz}`) as HTMLInputElement)?.value.trim() ||
            (DEFAULT_MEASUREMENTS_BY_CAT[categorySlug] || DEFAULT_MEASUREMENTS_BY_CAT.hoodies)[sz];
          return {
            talla: sz,
            medidas_cm: cm,
            stock_talla: active ? 1 : 0,
            orden: index + 1,
          };
        });

        const spec1 = (document.getElementById('prod-spec-1') as HTMLTextAreaElement)?.value.trim();
        const spec2 = (document.getElementById('prod-spec-2') as HTMLInputElement)?.value.trim();
        const spec3 = (document.getElementById('prod-spec-3') as HTMLInputElement)?.value.trim();

        const rawSpecs = [
          materialVal && (!spec1 || !spec1.toLowerCase().includes(materialVal.toLowerCase())) ? materialVal : '',
          spec1,
          spec2,
          spec3,
        ].filter(Boolean) as string[];

        const finalSpecs =
          rawSpecs.length > 0
            ? rawSpecs
            : ['Confección streetwear de alta densidad', 'Edición limitada URBAN_DROP'];

        const btn = document.getElementById('btn-create-product') as HTMLButtonElement;
        const icon = document.getElementById('create-prod-icon') as HTMLElement;
        const text = document.getElementById('create-prod-text') as HTMLElement;

        btn.disabled = true;
        icon.className = 'fa-solid fa-circle-notch animate-spin text-xs shrink-0';
        text.textContent = 'Guardando...';

        try {
          // 1. Obtener ID de la categoría por slug
          const catRes = await fetch(
            `${SUPABASE_URL}/rest/v1/categorias?select=id,slug&slug=eq.${encodeURIComponent(categorySlug)}&limit=1`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          const catRows = await catRes.json();
          const categoriaId = Array.isArray(catRows) && catRows[0]?.id ? catRows[0].id : 1;

          let targetProductId = editingId;

          if (editingId) {
            // UPDATE producto existente
            const patchRes = await fetch(`${SUPABASE_URL}/rest/v1/productos?id=eq.${editingId}`, {
              method: 'PATCH',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
                Prefer: 'return=minimal',
              },
              body: JSON.stringify({
                categoria_id: categoriaId,
                nombre: marca,
                precio: priceVal,
                etiqueta: 'Catálogo',
                corte_fit: 'Regular',
                info_modelo: 'N/A',
                stock_disponible: 1,
              }),
            });
            if (!patchRes.ok) throw new Error('Error al actualizar producto');

            // Limpiar tablas hijas para reemplazar con el estado actualizado
            const delResults = await Promise.all([
              fetch(`${SUPABASE_URL}/rest/v1/producto_imagenes?producto_id=eq.${editingId}`, {
                method: 'DELETE',
                headers: { apikey: SUPABASE_PUBLISHABLE_KEY, Authorization: `Bearer ${accessToken}` },
              }),
              fetch(`${SUPABASE_URL}/rest/v1/producto_tallas?producto_id=eq.${editingId}`, {
                method: 'DELETE',
                headers: { apikey: SUPABASE_PUBLISHABLE_KEY, Authorization: `Bearer ${accessToken}` },
              }),
              fetch(`${SUPABASE_URL}/rest/v1/producto_especificaciones?producto_id=eq.${editingId}`, {
                method: 'DELETE',
                headers: { apikey: SUPABASE_PUBLISHABLE_KEY, Authorization: `Bearer ${accessToken}` },
              }),
            ]);
            if (delResults.some((r) => !r.ok)) {
              throw new Error('Error al actualizar detalles del producto');
            }
          } else {
            // INSERT nuevo producto
            const prodRes = await fetch(`${SUPABASE_URL}/rest/v1/productos`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
                Prefer: 'return=representation',
              },
              body: JSON.stringify({
                categoria_id: categoriaId,
                nombre: marca,
                precio: priceVal,
                etiqueta: 'Catálogo',
                corte_fit: 'Regular',
                info_modelo: 'N/A',
                stock_disponible: 1,
                activo: true,
                orden: 1,
              }),
            });
            if (!prodRes.ok) {
              const errText = await prodRes.text();
              throw new Error(errText || 'Error al insertar producto');
            }
            const createdRows = await prodRes.json();
            targetProductId = createdRows[0]?.id;
          }

          if (!targetProductId) throw new Error('No se recibió el ID del producto');

          // 3. Insertar imágenes en `public.producto_imagenes`
          const imagesRows = pendingProductImages.map((item, idx) => {
            const desc = normalizeImageDescriptor(item);
            return {
              producto_id: targetProductId,
              url: desc.url,
              alt_text: `${marca} - Vista ${idx + 1} | Catálogo URBAN_DROP`,
              orden: idx + 1,
              r2_object_key: desc.r2_object_key,
              content_hash: desc.content_hash,
              mime_type: desc.mime_type || 'image/webp',
              width: desc.width || 700,
              height: desc.height || 933,
              dominant_color: desc.dominant_color || '#0f172a',
              lqip_data_uri: desc.lqip_data_uri,
              exif_stripped: Boolean(desc.exif_stripped),
              magic_bytes_verified: Boolean(desc.magic_bytes_verified),
              cache_control: desc.cache_control || 'public, max-age=31536000, immutable',
            };
          });

          const imgInsertRes = await fetch(`${SUPABASE_URL}/rest/v1/producto_imagenes`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(imagesRows),
          });
          if (!imgInsertRes.ok) throw new Error('Error al guardar imágenes del producto');

          // 4. Insertar tallas en `public.producto_tallas`
          const tallasRows = sizesPayload.map((t) => ({
            producto_id: targetProductId,
            ...t,
          }));

          const tallasInsertRes = await fetch(`${SUPABASE_URL}/rest/v1/producto_tallas`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(tallasRows),
          });
          if (!tallasInsertRes.ok) throw new Error('Error al guardar tallas del producto');

          // 5. Insertar especificaciones en `public.producto_especificaciones`
          const specsRows = finalSpecs.map((desc, idx) => ({
            producto_id: targetProductId,
            descripcion: desc,
            orden: idx + 1,
          }));

          if (specsRows.length > 0) {
            const specsInsertRes = await fetch(`${SUPABASE_URL}/rest/v1/producto_especificaciones`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
                Prefer: 'return=minimal',
              },
              body: JSON.stringify(specsRows),
            });
            if (!specsInsertRes.ok) throw new Error('Error al guardar especificaciones del producto');
          }

          adminFormModal?.classList.add('hidden');
          adminFormModal?.classList.remove('flex');
          adminDetailModal?.classList.add('hidden');
          adminDetailModal?.classList.remove('flex');
          resetCreateProductForm();
          showToast(editingId ? `Producto "${marca}" modificado` : `¡Producto "${marca}" agregado al catálogo!`, 3000);
          await loadAdminProductsList().catch(() => {});
        } catch (err) {
          showToast(err instanceof Error && err.message ? err.message : 'Error al guardar el producto. Verifica tu sesión JWT.');
        } finally {
          btn.disabled = false;
          icon.className = 'fa-solid fa-check text-xs';
          text.textContent = 'Guardar';
        }
      });

      // ==============================================================
      // MODAL 3: BORRADO SEGURO CON CONFIRMACIÓN (SOFT DELETE RLS)
      // ==============================================================
      const confirmDeleteModal = document.getElementById('confirm-delete-modal');
      let pendingDeleteProductId: number | null = null;

      function openDeleteConfirmation(productId: number) {
        const prod = adminProductsCache.find((p) => p.id === productId);
        if (!prod || !confirmDeleteModal) return;

        pendingDeleteProductId = productId;
        const titleEl = document.getElementById('confirm-delete-title');
        if (titleEl) titleEl.textContent = `¿Eliminar "${prod.marca}"?`;
        confirmDeleteModal.classList.remove('hidden');
        confirmDeleteModal.classList.add('flex');
      }

      document.getElementById('open-delete-confirm-btn')?.addEventListener('click', () => {
        const editingId = Number((document.getElementById('prod-editing-id') as HTMLInputElement)?.value);
        if (editingId) openDeleteConfirmation(editingId);
      });

      document.getElementById('cancel-delete-btn')?.addEventListener('click', () => {
        pendingDeleteProductId = null;
        confirmDeleteModal?.classList.add('hidden');
        confirmDeleteModal?.classList.remove('flex');
      });

      document.getElementById('confirm-delete-btn')?.addEventListener('click', async () => {
        const targetId = pendingDeleteProductId || Number((document.getElementById('prod-editing-id') as HTMLInputElement)?.value);
        const accessToken = getActiveAccessToken();
        if (!targetId || !accessToken) {
          showToast('Sesión JWT requerida para eliminar');
          return;
        }

        const confirmBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement | null;
        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.textContent = 'Eliminando...';
        }

        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/productos?id=eq.${targetId}`, {
            method: 'DELETE',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              Prefer: 'return=minimal',
            },
          });

          if (!res.ok) {
            const errBody = await res.text().catch(() => '');
            throw new Error(errBody || 'Error al eliminar producto');
          }

          pendingDeleteProductId = null;
          confirmDeleteModal?.classList.add('hidden');
          confirmDeleteModal?.classList.remove('flex');
          adminDetailModal?.classList.add('hidden');
          adminDetailModal?.classList.remove('flex');
          adminFormModal?.classList.add('hidden');
          adminFormModal?.classList.remove('flex');
          resetCreateProductForm();

          adminProductsCache = adminProductsCache.filter((p) => p.id !== targetId);
          renderAdminCatalog();
          showToast('Producto eliminado del catálogo', 3000);
          await loadAdminProductsList().catch(() => {});
        } catch {
          showToast('No se pudo eliminar el producto. Verifica tu sesión.');
        } finally {
          if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Sí, eliminar';
          }
        }
      });

      // ==============================================================
      // CONFIGURACIÓN DE WHATSAPP E INSTAGRAM (`configuracion_tienda`)
      // ==============================================================
      const waInputEl = document.getElementById('cfg-whatsapp-number') as HTMLInputElement;
      const waPreviewEl = document.getElementById('cfg-wa-preview-link') as HTMLElement;
      const igToggleEl = document.getElementById('cfg-instagram-active') as HTMLInputElement;
      const igStatusLabelEl = document.getElementById('cfg-ig-status-label') as HTMLElement;
      const igUrlInputEl = document.getElementById('cfg-instagram-url') as HTMLInputElement;

      function updateSocialConfigPreviewUI() {
        const cleanWa = (waInputEl?.value || '').replace(/[^0-9]/g, '') || '5215500000000';
        if (waPreviewEl) {
          waPreviewEl.textContent = `https://wa.me/${cleanWa}`;
        }
        const isIgActive = igToggleEl?.checked ?? true;
        if (igStatusLabelEl) {
          igStatusLabelEl.textContent = isIgActive
            ? 'VISIBLE EN TARJETAS Y MODAL DEL CATÁLOGO'
            : 'OCULTO EN TODO EL CATÁLOGO';
          igStatusLabelEl.className = isIgActive
            ? 'text-[10px] font-mono text-emerald-400 font-bold'
            : 'text-[10px] font-mono text-amber-400 font-bold';
        }
      }

      waInputEl?.addEventListener('input', updateSocialConfigPreviewUI);
      igToggleEl?.addEventListener('change', updateSocialConfigPreviewUI);

      async function loadStoreConfig() {
        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/configuracion_tienda?select=whatsapp_numero,instagram_activo,instagram_url&clave=eq.principal&limit=1`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          if (!res.ok) return;
          const rows = await res.json();
          if (Array.isArray(rows) && rows.length > 0) {
            const cfg = rows[0];
            if (waInputEl) waInputEl.value = cfg.whatsapp_numero || '5215500000000';
            if (igToggleEl) igToggleEl.checked = Boolean(cfg.instagram_activo);
            if (igUrlInputEl) igUrlInputEl.value = cfg.instagram_url || 'https://instagram.com/direct/inbox/';
            localStorage.setItem(
              STORE_CONFIG_CACHE_KEY,
              JSON.stringify({
                whatsappNumber: cfg.whatsapp_numero,
                instagramActive: Boolean(cfg.instagram_activo),
                instagramUrl: cfg.instagram_url,
              })
            );
            updateSocialConfigPreviewUI();
          }
        } catch {
          // Ignorar error de red
        }
      }

      const socialConfigForm = document.getElementById('social-config-form') as HTMLFormElement;
      socialConfigForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        const accessToken = getActiveAccessToken();
        if (!accessToken) {
          showToast('Inicia sesión como administrador para guardar cambios');
          return;
        }

        const cleanWa = (waInputEl?.value || '').replace(/[^0-9]/g, '');
        const igActive = Boolean(igToggleEl?.checked);
        const igUrl = (igUrlInputEl?.value || '').trim() || 'https://instagram.com/direct/inbox/';

        if (cleanWa.length < 8) {
          showToast('Ingresa un número de WhatsApp válido con código de país (mín. 8 dígitos)');
          return;
        }

        if (!/^https?:\/\/.+/i.test(igUrl)) {
          showToast('Ingresa un enlace válido para Instagram (https://...)');
          return;
        }

        const saveBtn = document.getElementById('btn-save-social-config') as HTMLButtonElement;
        const saveIcon = document.getElementById('save-cfg-icon') as HTMLElement;
        const saveText = document.getElementById('save-cfg-text') as HTMLElement;

        saveBtn.disabled = true;
        saveIcon.className = 'fa-solid fa-circle-notch animate-spin text-sm';
        saveText.textContent = 'Actualizando configuración en Supabase...';

        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/configuracion_tienda?clave=eq.principal`, {
            method: 'PATCH',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
              Prefer: 'return=representation',
            },
            body: JSON.stringify({
              whatsapp_numero: cleanWa,
              instagram_activo: igActive,
              instagram_url: igUrl,
              updated_at: new Date().toISOString(),
            }),
          });

          if (!res.ok) {
            throw new Error('No se pudo actualizar configuracion_tienda');
          }

          waInputEl.value = cleanWa;
          localStorage.setItem(
            STORE_CONFIG_CACHE_KEY,
            JSON.stringify({
              whatsappNumber: cleanWa,
              instagramActive: igActive,
              instagramUrl: igUrl,
            })
          );
          updateSocialConfigPreviewUI();
          showToast(
            `¡Canales actualizados! WhatsApp: ${cleanWa} • Instagram: ${igActive ? 'Visible' : 'Oculto'}`
          );
        } catch {
          showToast('Error al guardar la configuración social');
        } finally {
          saveBtn.disabled = false;
          saveIcon.className = 'fa-solid fa-floppy-disk text-sm';
          saveText.textContent = 'Guardar Configuración de WhatsApp e Instagram';
        }
      });

      // Renderizado del Panel de Sesión e Inspector JWT
      function renderAuthenticatedSession(sessionData: {
        access_token: string;
        refresh_token?: string;
        user?: { id: string; email: string };
      }) {
        const report = inspectAndValidateJwt(sessionData.access_token);
        if (!report.valid || !report.payload) {
          sessionStorage.removeItem(SESSION_STORAGE_KEY);
          localStorage.removeItem(SESSION_STORAGE_KEY);
          return;
        }

        loginCardView.classList.add('hidden');
        jwtSessionView.classList.remove('hidden');
        syncFabVisibility();

        const userEmailEl = document.getElementById('jwt-user-email');
        const roleBadgeEl = document.getElementById('jwt-role-badge');
        const algPillEl = document.getElementById('jwt-alg-pill');

        if (userEmailEl) userEmailEl.textContent = report.payload.email || sessionData.user?.email || 'Usuario Autenticado';
        if (roleBadgeEl) roleBadgeEl.textContent = `ROL: ${report.checks.roleFromAppMetadata.toUpperCase()}`;
        if (algPillEl) algPillEl.textContent = `ALG: ${report.header?.alg || 'HS256'} • TYP: ${report.header?.typ || 'JWT'}`;

        const checksGrid = document.getElementById('jwt-checks-grid');
        if (checksGrid) {
          const checkItems = [
            { label: 'Estructura 3 Segmentos', ok: report.checks.structureThreeParts },
            { label: 'Algoritmo Fuerte (!none)', ok: report.checks.algorithmAllowed },
            { label: 'Vigencia Temporal (exp)', ok: report.checks.notExpired },
            { label: 'Emisor Verificado (iss)', ok: report.checks.issuerMatches },
            { label: `RBAC: ${report.checks.roleFromAppMetadata}`, ok: true },
            { label: 'Session ID Vinculado', ok: report.checks.sessionIdPresent },
          ];

          checksGrid.innerHTML = checkItems
            .map(
              (c) => `
              <div class="p-2 rounded-xl bg-slate-950 border ${
                c.ok ? 'border-emerald-500/30 text-emerald-300' : 'border-red-500/30 text-red-300'
              } flex items-center gap-2">
                <i class="fa-solid ${c.ok ? 'fa-circle-check text-emerald-400' : 'fa-circle-xmark text-red-400'} text-xs"></i>
                <span class="font-medium truncate">${c.label}</span>
              </div>
            `
            )
            .join('');
        }

        const rawColorized = document.getElementById('jwt-raw-colorized');
        if (rawColorized) {
          const [h, p, s] = sessionData.access_token.split('.');
          rawColorized.innerHTML = `<span class="text-pink-400">${h}</span>.<span class="text-emerald-400">${p}</span>.<span class="text-cyan-400">${s}</span>`;
        }

        const payloadPre = document.getElementById('jwt-payload-pre');
        if (payloadPre) {
          payloadPre.textContent = JSON.stringify(
            {
              sub: report.payload.sub,
              email: report.payload.email,
              role: report.payload.role,
              app_metadata: report.payload.app_metadata,
              session_id: report.payload.session_id,
              iat: report.payload.iat,
              exp: report.payload.exp,
              iss: report.payload.iss,
            },
            null,
            2
          );
        }

        if (expInterval) clearInterval(expInterval);
        const updateCountdown = () => {
          const expEl = document.getElementById('jwt-exp-countdown');
          if (!expEl || !report.payload?.exp) return;
          const diff = report.payload.exp - Math.floor(Date.now() / 1000);
          if (diff <= 0) {
            expEl.textContent = 'EXPIRADO';
            expEl.className = 'font-mono font-bold text-sm text-red-400';
            if (expInterval) clearInterval(expInterval);
            return;
          }
          const mins = Math.floor(diff / 60);
          const secs = diff % 60;
          expEl.textContent = `${mins}m ${String(secs).padStart(2, '0')}s`;
        };
        updateCountdown();
        expInterval = setInterval(updateCountdown, 1000);

        loadUserAuditLogs(sessionData.access_token);
        loadAdminProductsList();
        loadStoreConfig();
      }

      // Envío del Formulario de Login contra Supabase Auth
      loginForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        errorBanner.classList.add('hidden');
        errorBanner.classList.remove('flex');

        if (updateRateLimitUI()) return;

        const csrfInput = (document.getElementById('csrf-token-input') as HTMLInputElement)?.value;
        const expectedCsrf = sessionStorage.getItem('urban_drop_csrf_nonce');
        if (!csrfInput || csrfInput !== expectedCsrf) {
          errorTitle.textContent = 'Fallo de validación CSRF (OWASP A01:2025)';
          errorDesc.textContent = 'El token de integridad del formulario no es válido. Recarga la página.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
          return;
        }

        const email = emailInput.value.trim().toLowerCase();
        const password = passwordInput.value;

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length < 10) {
          errorTitle.textContent = 'Formato de credenciales inválido';
          errorDesc.textContent = 'Ingresa un correo corporativo válido y una contraseña de al menos 10 caracteres.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
          return;
        }

        const startTime = Date.now();
        submitBtn.disabled = true;
        submitSpinner.className = 'fa-solid fa-circle-notch animate-spin text-sm';
        submitBtnText.textContent = 'Verificando credenciales y firmando JWT...';

        try {
          const response = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, password }),
          });

          const elapsed = Date.now() - startTime;
          if (elapsed < 450) {
            await new Promise((r) => setTimeout(r, 450 - elapsed));
          }

          if (!response.ok) {
            const rl = getRateLimitState();
            const nextFailed = rl.failedAttempts + 1;
            const isLocked = nextFailed >= MAX_ATTEMPTS;

            setRateLimitState({
              failedAttempts: nextFailed,
              lockoutUntil: isLocked ? Date.now() + LOCKOUT_SECONDS * 1000 : 0,
            });

            await logAuthAuditEvent(
              isLocked ? 'RATE_LIMIT_LOCK' : 'LOGIN_FAILED',
              email,
              null,
              null,
              { attempt: nextFailed }
            );

            errorTitle.textContent = 'Autenticación rechazada';
            errorDesc.textContent =
              'Credenciales inválidas o cuenta no autorizada. Por seguridad no se especifica qué campo falló (OWASP A07:2025).';
            errorBanner.classList.remove('hidden');
            errorBanner.classList.add('flex');
            return;
          }

          const sessionData = await response.json();
          const verification = inspectAndValidateJwt(sessionData.access_token);

          if (!verification.valid) {
            throw new Error(verification.errors.join(' '));
          }

          setRateLimitState({ failedAttempts: 0, lockoutUntil: 0 });
          const serializedSession = JSON.stringify({
            access_token: sessionData.access_token,
            refresh_token: sessionData.refresh_token,
            user: sessionData.user,
          });
          sessionStorage.setItem(SESSION_STORAGE_KEY, serializedSession);
          localStorage.setItem(SESSION_STORAGE_KEY, serializedSession);

          await logAuthAuditEvent(
            'LOGIN_SUCCESS',
            email,
            sessionData.user?.id || verification.payload?.sub || null,
            sessionData.access_token,
            { alg: verification.header?.alg, role: verification.checks.roleFromAppMetadata }
          );

          passwordInput.value = '';
          initCsrfToken();
          showToast('¡Autenticación exitosa! Panel de Alta y Configuración activo.');
          renderAuthenticatedSession(sessionData);
        } catch {
          errorTitle.textContent = 'Error de comunicación segura';
          errorDesc.textContent = 'No fue posible establecer conexión con el servidor de autenticación.';
          errorBanner.classList.remove('hidden');
          errorBanner.classList.add('flex');
        } finally {
          submitBtn.disabled = false;
          submitSpinner.className = 'fa-solid fa-fingerprint text-sm';
          submitBtnText.textContent = 'Autenticar y Abrir Panel Admin';
          updateRateLimitUI();
        }
      });

      if (import.meta.env.DEV) {
        document.getElementById('btn-fill-demo')?.addEventListener('click', () => {
          emailInput.value = 'admin@urbandrop.store';
          passwordInput.value = 'UrbanDrop#2025!Secure';
          passwordInput.dispatchEvent(new Event('input'));
          errorBanner.classList.add('hidden');
          showToast('Credenciales Admin cargadas.');
        });

        document.getElementById('btn-fill-invalid')?.addEventListener('click', () => {
          emailInput.value = 'admin@urbandrop.store';
          passwordInput.value = 'IntentoFallido#9999';
          passwordInput.dispatchEvent(new Event('input'));
          showToast('Credenciales de prueba fallida cargadas.');
        });
      }

      document.getElementById('btn-copy-jwt')?.addEventListener('click', async () => {
        const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw || !navigator.clipboard) return;
        const parsed = JSON.parse(raw);
        await navigator.clipboard.writeText(parsed.access_token);
        showToast('Token JWT copiado al portapapeles');
      });

      document.getElementById('btn-verify-server-jwt')?.addEventListener('click', async () => {
        const raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);

        try {
          const res = await fetch(`${SUPABASE_URL}/auth/v1/user`, {
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Authorization: `Bearer ${parsed.access_token}`,
            },
          });
          if (res.ok) {
            const userObj = await res.json();
            await logAuthAuditEvent('TOKEN_VERIFIED', userObj.email || 'admin@urbandrop.store', userObj.id, parsed.access_token, {
              verified_endpoint: '/auth/v1/user',
            });
            await loadUserAuditLogs(parsed.access_token);
            showToast('Firma y sesión JWT validadas contra Supabase Auth');
          } else {
            showToast('El token ya no es válido en el servidor');
          }
        } catch {
          showToast('Error al verificar el token con el servidor');
        }
      });

      document.getElementById('btn-logout-jwt')?.addEventListener('click', async () => {
        const raw =
          sessionStorage.getItem(SESSION_STORAGE_KEY) ||
          localStorage.getItem(SESSION_STORAGE_KEY);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            await logAuthAuditEvent(
              'LOGOUT',
              parsed.user?.email || 'admin@urbandrop.store',
              parsed.user?.id || null,
              parsed.access_token
            );
            await fetch(`${SUPABASE_URL}/auth/v1/logout`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${parsed.access_token}`,
              },
            });
          } catch {
            // Continúa limpieza local
          }
        }

        sessionStorage.removeItem(SESSION_STORAGE_KEY);
        localStorage.removeItem(SESSION_STORAGE_KEY);
        if (expInterval) clearInterval(expInterval);
        jwtSessionView.classList.add('hidden');
        loginCardView.classList.remove('hidden');
        syncFabVisibility();
        initCsrfToken();
        showToast('Sesión cerrada y token JWT revocado');
      });

      const owaspModal = document.getElementById('owasp-modal');
      document.getElementById('btn-owasp-info')?.addEventListener('click', () => {
        owaspModal?.classList.remove('opacity-0', 'pointer-events-none');
      });
      document.getElementById('close-owasp-modal')?.addEventListener('click', () => {
        owaspModal?.classList.add('opacity-0', 'pointer-events-none');
      });
      owaspModal?.addEventListener('click', (e) => {
        if (e.target === owaspModal) owaspModal.classList.add('opacity-0', 'pointer-events-none');
      });

      // Restaurar sesión activa si el JWT en sessionStorage o localStorage sigue vigente
      try {
        const existingRaw =
          sessionStorage.getItem(SESSION_STORAGE_KEY) ||
          localStorage.getItem(SESSION_STORAGE_KEY);
        if (existingRaw) {
          sessionStorage.setItem(SESSION_STORAGE_KEY, existingRaw);
          localStorage.setItem(SESSION_STORAGE_KEY, existingRaw);
          const existingSession = JSON.parse(existingRaw);
          renderAuthenticatedSession(existingSession);
        }
      } catch {
        sessionStorage.removeItem(SESSION_STORAGE_KEY);
        localStorage.removeItem(SESSION_STORAGE_KEY);
      }
    </script>

    <style>
      .font-heading {
        font-family: 'Space Grotesk', sans-serif;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
