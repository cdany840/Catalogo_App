      const socialConfigForm = document.getElementById('social-config-form') as HTMLFormElement;
      socialConfigForm?.addEventListener('submit', async (e: SubmitEvent) => {
        e.preventDefault();
        const accessToken = getActiveAccessToken();
        if (!accessToken) {
          showToast('Inicia sesión como administrador para guardar cambios');
          return;
        }

        const cleanWa = (waInputEl?.value || '').replace(/[^0-9]/g, '');
