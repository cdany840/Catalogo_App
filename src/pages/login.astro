            const shortHash = (desc.content_hash || '').slice(0, 8);
            return `
            <div class="relative group aspect-[3/4] rounded-xl overflow-hidden bg-slate-900 border border-slate-800" style="background-color: ${desc.dominant_color || '#0f172a'};">
              <img src="${desc.url}" alt="Previsualización ${idx + 1}" width="700" height="933" decoding="async" class="w-full h-full object-cover" />
              <span class="absolute top-1.5 left-1.5 bg-slate-950/85 text-white font-mono text-[9px] px-1.5 py-0.5 rounded border border-slate-700">
