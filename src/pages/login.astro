      // Gestión de Rate-Limiting (OWASP A07:2025)
      interface RateLimitState {
        failedAttempts: number;
        lockoutUntil: number;
      }

      function getRateLimitState(): RateLimitState {
        try {
          const raw = sessionStorage.getItem(RATE_LIMIT_STORAGE_KEY);
          if (!raw) return { failedAttempts: 0, lockoutUntil: 0 };
          return JSON.parse(raw) as RateLimitState;
        } catch {
          return { failedAttempts: 0, lockoutUntil: 0 };
        }
      }

      function setRateLimitState(next: RateLimitState) {
        sessionStorage.setItem(RATE_LIMIT_STORAGE_KEY, JSON.stringify(next));
        updateRateLimitUI();
      }

      function updateRateLimitUI(): boolean {
        const rl = getRateLimitState();
        const now = Date.now();

        if (rl.lockoutUntil > now) {
          const remainingSec = Math.ceil((rl.lockoutUntil - now) / 1000);
          lockoutBanner.classList.remove('hidden');
          lockoutBanner.classList.add('flex');
          lockoutTimerEl.textContent = String(remainingSec);
          rateLimitBadge.textContent = '0 / 5 (Bloqueado)';
          rateLimitBadge.className = 'font-mono font-bold text-red-400';
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

          if (!lockoutInterval) {
            lockoutInterval = setInterval(() => {
              const check = getRateLimitState();
              if (check.lockoutUntil <= Date.now()) {
                if (lockoutInterval) clearInterval(lockoutInterval);
                lockoutInterval = null;
                setRateLimitState({ failedAttempts: 0, lockoutUntil: 0 });
              } else {
                updateRateLimitUI();
              }
            }, 1000);
          }
          return true;
        }

        lockoutBanner.classList.add('hidden');
        lockoutBanner.classList.remove('flex');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');

        const remaining = Math.max(0, MAX_ATTEMPTS - rl.failedAttempts);
        rateLimitBadge.textContent = `${remaining} / ${MAX_ATTEMPTS} intentos disponibles`;
        rateLimitBadge.className =
          remaining <= 2 ? 'font-mono font-bold text-amber-400' : 'font-mono font-bold text-emerald-400';
        return false;
      }

      updateRateLimitUI();

      // Evaluador de Entropía y Contraseñas Comprometidas
      function evaluatePasswordPolicy(pwd: string) {
        const lower = pwd.toLowerCase();
        const compromised = COMPROMISED_PATTERNS.some((p) => lower.includes(p));
        if (compromised) {
          return { score: 1, compromised: true, message: 'Alerta: Patrón en lista de contraseñas filtradas' };
        }

        let score = 0;
        if (pwd.length >= 10) score++;
        if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
        if (/\d/.test(pwd)) score++;
        if (/[^A-Za-z0-9]/.test(pwd)) score++;

        const messages = [
          'Mín. 10 caracteres + complejidad',
          'Débil (incrementa longitud)',
          'Aceptable (agrega símbolos)',
          'Fuerte (Cumple OWASP)',
          'Óptima (Alta entropía NIST/OWASP 2025)',
        ];

        return { score, compromised: false, message: messages[score] || messages[0] };
      }

      passwordInput?.addEventListener('input', () => {
        const val = passwordInput.value;
        const { score, compromised, message } = evaluatePasswordPolicy(val);
        const label = document.getElementById('password-entropy-label');
        const bars = document.querySelectorAll<HTMLElement>('#password-strength-bars [data-bar]');

        if (label) {
          label.textContent = message;
          label.className = compromised
            ? 'text-[10px] font-mono text-red-400 font-bold'
            : score >= 3
              ? 'text-[10px] font-mono text-emerald-400 font-semibold'
              : 'text-[10px] font-mono text-amber-400';
        }

        bars.forEach((bar, idx) => {
          if (val.length === 0) {
            bar.className = 'h-1 rounded-full bg-slate-800 transition-colors';
          } else if (compromised) {
            bar.className = 'h-1 rounded-full bg-red-500 transition-colors';
          } else if (idx < score) {
            bar.className =
              score >= 3
                ? 'h-1 rounded-full bg-emerald-400 transition-colors'
                : 'h-1 rounded-full bg-amber-400 transition-colors';
          } else {
            bar.className = 'h-1 rounded-full bg-slate-800 transition-colors';
          }
        });
      });

      togglePassBtn?.addEventListener('click', () => {
