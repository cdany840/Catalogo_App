      // Gestión de Rate-Limiting (OWASP A07:2025)
      interface RateLimitState {
        failedAttempts: number;
        lockoutUntil: number;
      }

      function getRateLimitState(): RateLimitState {
        try {
          const raw = sessionStorage.getItem(RATE_LIMIT_STORAGE_KEY);
          if (!raw) return { failedAttempts: 0, lockoutUntil: 0 };
          return JSON.parse(raw) as RateLimitState;
        } catch {
          return { failedAttempts: 0, lockoutUntil: 0 };
        }
      }

      function setRateLimitState(next: RateLimitState) {
        sessionStorage.setItem(RATE_LIMIT_STORAGE_KEY, JSON.stringify(next));
        updateRateLimitUI();
      }

      function updateRateLimitUI(): boolean {
        const rl = getRateLimitState();
        const now = Date.now();

        if (rl.lockoutUntil > now) {
          const remainingSec = Math.ceil((rl.lockoutUntil - now) / 1000);
          lockoutBanner.classList.remove('hidden');
          lockoutBanner.classList.add('flex');
          lockoutTimerEl.textContent = String(remainingSec);
          rateLimitBadge.textContent = '0 / 5 (Bloqueado)';
          rateLimitBadge.className = 'font-mono font-bold text-red-400';
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

          if (!lockoutInterval) {
            lockoutInterval = setInterval(() => {
              const check = getRateLimitState();
              if (check.lockoutUntil <= Date.now()) {
                if (lockoutInterval) clearInterval(lockoutInterval);
                lockoutInterval = null;
                setRateLimitState({ failedAttempts: 0, lockoutUntil: 0 });
              } else {
                updateRateLimitUI();
              }
            }, 1000);
          }
          return true;
        }

        lockoutBanner.classList.add('hidden');
        lockoutBanner.classList.remove('flex');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');

        const remaining = Math.max(0, MAX_ATTEMPTS - rl.failedAttempts);
        rateLimitBadge.textContent = `${remaining} / ${MAX_ATTEMPTS} intentos disponibles`;
        rateLimitBadge.className =
          remaining <= 2 ? 'font-mono font-bold text-amber-400' : 'font-mono font-bold text-emerald-400';
        return false;
      }

      updateRateLimitUI();

      // Evaluador de Entropía y Contraseñas Comprometidas
      function evaluatePasswordPolicy(pwd: string) {
        const lower = pwd.toLowerCase();
        const compromised = COMPROMISED_PATTERNS.some((p) => lower.includes(p));
        if (compromised) {
          return { score: 1, compromised: true, message: 'Alerta: Patrón en lista de contraseñas filtradas' };
        }

        let score = 0;
        if (pwd.length >= 10) score++;
        if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
        if (/\d/.test(pwd)) score++;
        if (/[^A-Za-z0-9]/.test(pwd)) score++;

        const messages = [
          'Mín. 10 caracteres + complejidad',
          'Débil (incrementa longitud)',
          'Aceptable (agrega símbolos)',
          'Fuerte (Cumple OWASP)',
          'Óptima (Alta entropía NIST/OWASP 2025)',
        ];

        return { score, compromised: false, message: messages[score] || messages[0] };
      }

      passwordInput?.addEventListener('input', () => {
        const val = passwordInput.value;
        const { score, compromised, message } = evaluatePasswordPolicy(val);
        const label = document.getElementById('password-entropy-label');
        const bars = document.querySelectorAll<HTMLElement>('#password-strength-bars [data-bar]');

        if (label) {
          label.textContent = message;
          label.className = compromised
            ? 'text-[10px] font-mono text-red-400 font-bold'
            : score >= 3
              ? 'text-[10px] font-mono text-emerald-400 font-semibold'
              : 'text-[10px] font-mono text-amber-400';
        }

        bars.forEach((bar, idx) => {
          if (val.length === 0) {
            bar.className = 'h-1 rounded-full bg-slate-800 transition-colors';
          } else if (compromised) {
            bar.className = 'h-1 rounded-full bg-red-500 transition-colors';
          } else if (idx < score) {
            bar.className =
              score >= 3
                ? 'h-1 rounded-full bg-emerald-400 transition-colors'
                : 'h-1 rounded-full bg-amber-400 transition-colors';
          } else {
            bar.className = 'h-1 rounded-full bg-slate-800 transition-colors';
          }
        });
      });

      togglePassBtn?.addEventListener('click', () => {
        const isPass = passwordInput.type === 'password';
        passwordInput.type = isPass ? 'text' : 'password';
        togglePassIcon.className = isPass ? 'fa-regular fa-eye-slash text-pink-400' : 'fa-regular fa-eye';
        if (isPass) {
          setTimeout(() => {
            if (passwordInput.type === 'text') {
              passwordInput.type = 'password';
              togglePassIcon.className = 'fa-regular fa-eye';
            }
          }, 5000);
        }
      });

      // Registro de Auditoría en Supabase PostgreSQL (`public.auth_audit_logs`)
      async function logAuthAuditEvent(
        eventType: 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'LOGOUT' | 'RATE_LIMIT_LOCK' | 'TOKEN_VERIFIED',
        email: string,
        userId: string | null = null,
        accessToken: string | null = null,
        extraMeta: Record<string, unknown> = {}
      ) {
        try {
          const headers: Record<string, string> = {
            apikey: SUPABASE_PUBLISHABLE_KEY,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          };
          if (accessToken) {
            headers['Authorization'] = `Bearer ${accessToken}`;
          }

          await fetch(`${SUPABASE_URL}/rest/v1/auth_audit_logs`, {
            method: 'POST',
            headers,
            body: JSON.stringify({
              user_id: userId,
              email_masked: maskEmailForAudit(email),
              event_type: eventType,
              ip_hint: 'client-web-owasp2025',
              user_agent: navigator.userAgent.slice(0, 140),
              metadata: extraMeta,
            }),
          });
        } catch {
          // Falla silenciosa
        }
      }

      async function loadUserAuditLogs(accessToken: string) {
        const container = document.getElementById('audit-logs-container');
        if (!container) return;

        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/auth_audit_logs?select=id,event_type,email_masked,created_at,metadata&order=created_at.desc&limit=6`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Authorization: `Bearer ${accessToken}`,
                Accept: 'application/json',
              },
            }
          );

          if (!res.ok) return;
          const logs = await res.json();
          if (!Array.isArray(logs) || logs.length === 0) {
            container.innerHTML = `<p class="text-slate-500 text-center py-2">Sin eventos registrados aún.</p>`;
            return;
          }

          container.innerHTML = '';
          logs.forEach((item: any) => {
            const row = document.createElement('div');
            row.className =
              'flex items-center justify-between px-2.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-800/80';

            const left = document.createElement('div');
            left.className = 'flex items-center gap-2';

            const badge = document.createElement('span');
            const isSuccess = item.event_type === 'LOGIN_SUCCESS' || item.event_type === 'TOKEN_VERIFIED';
            badge.className = `font-mono text-[10px] font-bold px-1.5 py-0.5 rounded ${
              isSuccess
                ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                : 'bg-amber-500/15 text-amber-400 border border-amber-500/30'
            }`;
            badge.textContent = item.event_type;

            const emailSpan = document.createElement('span');
            emailSpan.className = 'text-slate-300 font-mono text-[10px]';
            emailSpan.textContent = item.email_masked;

            left.appendChild(badge);
            left.appendChild(emailSpan);

            const timeSpan = document.createElement('span');
            timeSpan.className = 'text-slate-500 font-mono text-[10px]';
            const dt = new Date(item.created_at);
            timeSpan.textContent = dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            row.appendChild(left);
            row.appendChild(timeSpan);
            container.appendChild(row);
          });
        } catch {
          // Ignorar error de red
        }
      }

      // ==============================================================
      // GESTIÓN DE IMÁGENES DEL NUEVO PRODUCTO (CLOUDFLARE R2 PRESIGNED PIPELINE)
      // ==============================================================
      function normalizeImageDescriptor(entry: string | R2PendingImageDescriptor): R2PendingImageDescriptor {
        if (typeof entry === 'string') {
          const fallbackHash = entry.replace(/[^a-f0-9]/gi, '').slice(0, 64).padEnd(64, 'a');
          return {
            url: entry,
            r2_object_key: `drops/v1/${fallbackHash.slice(0, 24)}-700x933.webp`,
            content_hash: fallbackHash,
            mime_type: 'image/webp',
            width: 700,
            height: 933,
            dominant_color: '#0f172a',
            lqip_data_uri: createLqipSvgDataUri('#0f172a'),
            exif_stripped: true,
            magic_bytes_verified: true,
            cache_control: 'public, max-age=31536000, immutable',
          };
        }
        return entry;
      }

