        if (pdmIgBtn) {
          pdmIgBtn.classList.toggle('hidden', !state.instagramActive);
          pdmIgBtn.classList.toggle('flex', state.instagramActive);
        }

        const bagIgBtn = document.getElementById('send-bag-ig-btn');
        if (bagIgBtn) {
          bagIgBtn.classList.toggle('hidden', !state.instagramActive);
          bagIgBtn.classList.toggle('flex', state.instagramActive);
        }
