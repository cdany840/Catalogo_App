            <p class="font-bold text-slate-300 flex items-center gap-2">
              <i class="fa-solid fa-layer-group text-purple-400" aria-hidden="true"></i>
              <span>Material y Cuidados</span>
            </p>
            <ul class="text-slate-400 space-y-1 pl-5 list-disc text-[11px]" id="pdm-specs-list"></ul>
