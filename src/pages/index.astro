      function updateCategoryCountsInDOM() {
        const allProds = Array.from(state.products.values());
        const counts: Record<string, number> = {
          todos: allProds.length,
          hoodies: allProds.filter((p) => p.category === 'hoodies').length,
          pantalones: allProds.filter((p) => p.category === 'pantalones').length,
          't-shirts': allProds.filter((p) => p.category === 't-shirts').length,
          chaquetas: allProds.filter((p) => p.category === 'chaquetas').length,
        };

        document.querySelectorAll<HTMLButtonElement>('.cat-btn').forEach((btn) => {
          const catId = btn.getAttribute('data-category-id') || 'todos';
          const badge = btn.querySelector('.cat-count');
          if (badge && catId in counts) {
            badge.textContent = String(counts[catId]);
          }
        });
      }

      function applyProductSizeAvailabilityToCard(cardEl: HTMLElement, product: ProductItem) {
        const avail = product.availableSizes || { S: true, M: true, L: true, XL: true };
        cardEl.querySelectorAll<HTMLButtonElement>('.size-chip').forEach((chip) => {
          const sz = chip.getAttribute('data-size') as SizeKey;
          const isAvail = avail[sz] !== false;
          chip.disabled = !isAvail;
          if (!isAvail) {
            chip.className =
              'size-chip min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-800 bg-slate-900/40 text-slate-600 line-through cursor-not-allowed text-center';
          }
        });
      }

