              type="button"
              class="min-h-[44px] py-3 px-3 rounded-xl bg-pink-500/15 hover:bg-pink-500/25 text-pink-300 border border-pink-500/40 font-bold text-xs flex items-center justify-center gap-2 active:scale-95 transition-all focus-visible:outline-none"
