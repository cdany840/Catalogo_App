      // 1.1 Sincronización en vivo desde Supabase PostgreSQL (Productos + Configuración Social + Metadatos R2)
      async function syncCatalogFromSupabase() {
        applyAdminTechnicalVisibility();
        applyStoreConfigToDOM();
        applySaveDataUI();

        try {
          const cfgRes = await fetch(
            `${SUPABASE_URL}/rest/v1/configuracion_tienda?select=whatsapp_numero,instagram_activo,instagram_url&clave=eq.principal&limit=1`,
            {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            }
          );
          if (cfgRes.ok) {
            const cfgRows = await cfgRes.json();
            if (Array.isArray(cfgRows) && cfgRows.length > 0) {
              const cfg = cfgRows[0];
              state.whatsappNumber = cfg.whatsapp_numero || DEFAULT_WHATSAPP_NUMBER;
              state.instagramActive = Boolean(cfg.instagram_activo);
              state.instagramUrl = cfg.instagram_url || DEFAULT_INSTAGRAM_URL;
              localStorage.setItem(
                STORE_CONFIG_CACHE_KEY,
                JSON.stringify({
                  whatsappNumber: state.whatsappNumber,
                  instagramActive: state.instagramActive,
                  instagramUrl: state.instagramUrl,
                })
              );
              applyStoreConfigToDOM();
            }
          }
        } catch {
          // Mantiene configuración en memoria
        }

        const selectQueryBase = [
          'id',
          'nombre',
          'precio',
          'etiqueta',
          'corte_fit',
          'info_modelo',
          'stock_disponible',
          'orden',
          'categorias!inner(slug,nombre,icono)',
          'producto_imagenes(url,alt_text,orden,r2_object_key,content_hash,dominant_color,lqip_data_uri,exif_stripped,magic_bytes_verified)',
          'producto_tallas(talla,medidas_cm,stock_talla,orden)',
          'producto_especificaciones(descripcion,orden)',
        ].join(',');

        const buildCatalogUrl = (cols: string) =>
          `${SUPABASE_URL}/rest/v1/productos?select=${encodeURIComponent(
            cols
          )}&activo=eq.true&order=id.desc`;

        try {
          let res = await fetch(buildCatalogUrl(`slug,${selectQueryBase}`), {
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              Accept: 'application/json',
            },
          });
          if (!res.ok && res.status === 400) {
            res = await fetch(buildCatalogUrl(selectQueryBase), {
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Accept: 'application/json',
              },
            });
          }
          if (!res.ok) return;
          const rows = await res.json();
          if (!Array.isArray(rows)) return;

          const catalogContainer = document.getElementById('catalog-container');
          const liveIds = new Set(rows.map((r: any) => Number(r.id)));

          Array.from(state.products.keys()).forEach((existingId) => {
            if (!liveIds.has(existingId)) {
              state.products.delete(existingId);
            }
          });
          document.querySelectorAll<HTMLElement>('.product-card').forEach((card) => {
            const cid = Number(card.getAttribute('data-product-id'));
            if (!liveIds.has(cid)) {
              card.remove();
            }
          });

          rows.forEach((row: any) => {
            const numPrice = typeof row.precio === 'number' ? row.precio : parseFloat(String(row.precio));
            const sortedImgObjects = [...(row.producto_imagenes || [])].sort((a, b) => a.orden - b.orden);
            const sortedImages = sortedImgObjects.map((img) => img.url);
            const imageMeta: ProductImageMeta[] = sortedImgObjects.map((img) => ({
              url: img.url,
              r2ObjectKey: img.r2_object_key,
              contentHash: img.content_hash,
              dominantColor: img.dominant_color || '#0f172a',
              lqipDataUri: img.lqip_data_uri || undefined,
              exifStripped: img.exif_stripped !== false,
              magicBytesVerified: img.magic_bytes_verified !== false,
            }));

            if (sortedImages.length === 0) {
              sortedImages.push('https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&q=80&w=700');
            }

            const measurements: ProductMeasurements = {
              S: 'Pecho: 56cm | Largo: 68cm',
              M: 'Pecho: 59cm | Largo: 71cm',
              L: 'Pecho: 62cm | Largo: 74cm',
              XL: 'Pecho: 65cm | Largo: 77cm',
            };
            const availableSizes: Record<SizeKey, boolean> = {
              S: true,
              M: true,
              L: true,
              XL: true,
            };

            if (Array.isArray(row.producto_tallas) && row.producto_tallas.length > 0) {
              ALL_SIZES.forEach((sz) => {
                availableSizes[sz] = false;
              });
              for (const t of row.producto_tallas) {
                if (t.talla in measurements) {
                  const key = t.talla as SizeKey;
                  measurements[key] = t.medidas_cm;
                  availableSizes[key] = (t.stock_talla ?? 1) > 0;
                }
              }
            }

            const sortedSpecs = [...(row.producto_especificaciones || [])]
              .sort((a, b) => a.orden - b.orden)
              .map((s) => s.descripcion);

            const existing = state.products.get(row.id);
            const fallbackSlug = `${String(row.nombre || 'drop')
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '')
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '') || 'drop'}-${row.id}`;
            const mappedProduct: ProductItem = {
              id: row.id,
              slug: row.slug || existing?.slug || fallbackSlug,
              name: row.nombre,
              price: `$${numPrice.toFixed(2)}`,
              numericPrice: numPrice,
              category: row.categorias?.slug || 'hoodies',
              tag: row.etiqueta,
              fit: row.corte_fit,
              modelInfo: row.info_modelo,
              stockLeft: row.stock_disponible,
              images: sortedImages,
              imageMeta,
              measurements,
              availableSizes,
              specs: sortedSpecs,
              currentSlide: existing?.currentSlide ?? 0,
              selectedSize: existing?.selectedSize ?? null,
            };
            state.products.set(row.id, mappedProduct);

            const cardEl = document.querySelector<HTMLElement>(`.product-card[data-product-id="${row.id}"]`);
            if (cardEl) {
              cardEl.setAttribute('data-category', mappedProduct.category);
              cardEl.setAttribute(
                'data-search-text',
                `${mappedProduct.name} ${mappedProduct.tag} ${mappedProduct.fit} ${mappedProduct.category} ${mappedProduct.specs.join(' ')}`.toLowerCase()
              );
              const titleEl = cardEl.querySelector('h2');
              if (titleEl) titleEl.textContent = mappedProduct.name;
              const slideIdx = mappedProduct.currentSlide ?? 0;
              const currentImgUrl = mappedProduct.images[slideIdx] || mappedProduct.images[0];
              const altText = `${mappedProduct.name} — Corte ${mappedProduct.fit} (${mappedProduct.tag}) — Vista ${slideIdx + 1} de ${mappedProduct.images.length}`;
              updatePictureElementForProduct(row.id, currentImgUrl, altText);

              // Aplicar LQIP / Color dominante si existe en BD
              const carouselArea = cardEl.querySelector<HTMLElement>('.card-carousel-area');
              const meta0 = mappedProduct.imageMeta?.[slideIdx] || mappedProduct.imageMeta?.[0];
              if (carouselArea && meta0) {
                const domColor = meta0.dominantColor || '#0f172a';
                const lqip = meta0.lqipDataUri || createClientLqipDataUri(domColor, '#1e1b4b');
                carouselArea.style.backgroundColor = domColor;
                carouselArea.style.backgroundImage = `url("${lqip}")`;
              }

              applyProductSizeAvailabilityToCard(cardEl, mappedProduct);
            } else if (catalogContainer) {
              const newCard = createProductCardElement(mappedProduct);
              catalogContainer.prepend(newCard);
            }
          });

          // Actualizar prioridad LCP en la primera tarjeta visible del DOM
          const allCards = document.querySelectorAll<HTMLElement>('.product-card');
          allCards.forEach((card, idx) => {
            const img = card.querySelector<HTMLImageElement>('img.card-img');
            const badge = card.querySelector<HTMLElement>('[data-r2-badge-product]');
            if (img) {
              img.loading = idx === 0 ? 'eager' : 'lazy';
              img.setAttribute('fetchpriority', idx === 0 ? 'high' : 'low');
            }
            if (badge) {
              badge.textContent = idx === 0 ? 'LCP•AVIF' : state.saveDataActive ? 'R2•LITE' : 'R2•AVIF';
            }
          });

          updateCategoryCountsInDOM();
          applyStoreConfigToDOM();
          applyCatalogFilters();
          applyAdminTechnicalVisibility();
          updateSavedBagUI();
        } catch {
          // Mantiene datos pre-renderizados del servidor si no hay red
        }
      }

      function openProductFromInitialUrl() {
        const searchParams = new URLSearchParams(window.location.search);
        const querySlug = searchParams.get('p') || searchParams.get('slug') || '';
        const pathMatch = window.location.pathname.match(/^\/p\/([^/?#]+)/);
        const targetSlug = decodeURIComponent(querySlug || (pathMatch ? pathMatch[1] : '')).trim();
        if (!targetSlug) return;

        let matched = Array.from(state.products.values()).find((p) => p.slug === targetSlug);
        if (!matched) {
          const idMatch = targetSlug.match(/-(\d+)$/);
          if (idMatch) {
            matched = state.products.get(Number(idMatch[1]));
          }
        }
        if (matched) {
          openDetailModal(matched.id);
        }
      }

      syncCatalogFromSupabase().then(() => {
        openProductFromInitialUrl();
      });

      // 2. Elementos del DOM
      const detailModal = document.getElementById('product-detail-modal') as HTMLElement;
      const detailModalCard = document.getElementById('detail-modal-card') as HTMLElement;
      const socialModal = document.getElementById('social-modal') as HTMLElement;
      const socialModalCard = document.getElementById('social-modal-card') as HTMLElement;
      const uxInfoModal = document.getElementById('ux-info-modal') as HTMLElement;
      const r2PipelineModal = document.getElementById('r2-pipeline-modal') as HTMLElement;
      const savedBagModal = document.getElementById('saved-bag-modal') as HTMLElement;
      const searchInput = document.getElementById('catalog-search-input') as HTMLInputElement;
      const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
      const emptyCatalogState = document.getElementById('empty-catalog-state') as HTMLElement;
      const toastEl = document.getElementById('toast-notification') as HTMLElement;
      const toastMsgEl = document.getElementById('toast-message') as HTMLElement;

      let toastTimer: ReturnType<typeof setTimeout> | null = null;

      function showToast(message: string) {
        if (!toastEl || !toastMsgEl) return;
        toastMsgEl.textContent = message;
        toastEl.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-3');
        toastEl.classList.add('opacity-100', 'translate-y-0');

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toastEl.classList.add('opacity-0', 'pointer-events-none', '-translate-y-3');
          toastEl.classList.remove('opacity-100', 'translate-y-0');
        }, 2400);
      }

      // 3. Filtrado Combinado (Categorías + Búsqueda en tiempo real)
      const categoryPills = document.querySelectorAll<HTMLButtonElement>('.cat-btn');

      function applyCatalogFilters() {
        let visibleCount = 0;
        const query = state.searchQuery.trim().toLowerCase();
        const productCards = document.querySelectorAll<HTMLElement>('.product-card');

        productCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category') || '';
          const searchText = card.getAttribute('data-search-text') || '';

          const matchesCategory = state.activeCategory === 'todos' || cardCat === state.activeCategory;
          const matchesQuery = !query || searchText.includes(query);

          if (matchesCategory && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyCatalogState) {
          emptyCatalogState.classList.toggle('hidden', visibleCount > 0);
        }
      }

      categoryPills.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-category-id') || 'todos';
          state.activeCategory = selectedCat;

          categoryPills.forEach((b) => {
            b.setAttribute('aria-pressed', 'false');
            b.className = "cat-btn snap-start font-bold text-xs px-3.5 py-2 rounded-xl whitespace-nowrap transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800";
            const badge = b.querySelector('.cat-count');
            if (badge) badge.className = "cat-count text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-400";
          });

          btn.setAttribute('aria-pressed', 'true');
          btn.className = "cat-btn snap-start font-bold text-xs px-3.5 py-2 rounded-xl whitespace-nowrap transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 bg-pink-500 text-white shadow-md shadow-pink-500/20";
          const activeBadge = btn.querySelector('.cat-count');
          if (activeBadge) activeBadge.className = "cat-count text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-white/20 text-white";

          applyCatalogFilters();
        });
      });

      searchInput?.addEventListener('input', () => {
        state.searchQuery = searchInput.value;
        if (clearSearchBtn) {
          clearSearchBtn.classList.toggle('hidden', state.searchQuery.length === 0);
          clearSearchBtn.classList.toggle('flex', state.searchQuery.length > 0);
        }
        applyCatalogFilters();
      });

      clearSearchBtn?.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        state.searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        clearSearchBtn.classList.remove('flex');
        applyCatalogFilters();
      });

      document.getElementById('reset-filters-btn')?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        state.searchQuery = '';
        clearSearchBtn?.classList.add('hidden');
        clearSearchBtn?.classList.remove('flex');
        const firstPill = categoryPills[0];
        if (firstPill) firstPill.click();
      });

      // 4. Delegación de Eventos en el Feed Principal
      document.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        const actionBtn = target.closest<HTMLElement>('[data-action]');
        if (!actionBtn) return;

        const action = actionBtn.getAttribute('data-action');
        const productId = Number(actionBtn.getAttribute('data-product-id'));
        if (!productId) return;

        if (action === 'slide-prev') {
          e.stopPropagation();
          changeProductSlide(productId, -1);
        } else if (action === 'slide-next') {
          e.stopPropagation();
          changeProductSlide(productId, 1);
        } else if (action === 'share-product') {
          e.stopPropagation();
          shareProductById(productId);
        } else if (action === 'add-to-cart') {
          e.stopPropagation();
          addToCart(productId);
        } else if (action === 'open-detail') {
          openDetailModal(productId);
        } else if (action === 'select-size') {
          const size = actionBtn.getAttribute('data-size') as SizeKey;
          selectProductSize(productId, size);
        } else if (action === 'trigger-social') {
          const channel = actionBtn.getAttribute('data-channel') as 'whatsapp' | 'instagram';
          triggerSocial(productId, channel);
        }
      });

      // 5. Soporte de Gestos Táctiles (Swipe Horizontal en Tarjetas y Modal)
      function attachHorizontalSwipe(
        element: HTMLElement,
        onSwipeLeft: () => void,
        onSwipeRight: () => void
      ) {
        let startX = 0;
        let startY = 0;
        let swiped = false;

        element.addEventListener(
          'touchstart',
          (e: TouchEvent) => {
            if (e.touches.length !== 1) return;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            swiped = false;
          },
          { passive: true }
        );

        element.addEventListener(
          'touchend',
          (e: TouchEvent) => {
            if (e.changedTouches.length !== 1) return;
            const dx = e.changedTouches[0].clientX - startX;
            const dy = e.changedTouches[0].clientY - startY;

            if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy) * 1.3) {
              swiped = true;
              if (dx < 0) {
                onSwipeLeft();
              } else {
                onSwipeRight();
              }
            }
          },
          { passive: true }
        );

        element.addEventListener(
          'click',
          (e: MouseEvent) => {
            if (swiped) {
              e.stopPropagation();
              swiped = false;
            }
          },
          true
        );
      }

      document.querySelectorAll<HTMLElement>('.card-carousel-area').forEach((carouselEl) => {
        const pid = Number(carouselEl.getAttribute('data-product-id'));
        if (!pid) return;
        attachHorizontalSwipe(
          carouselEl,
          () => changeProductSlide(pid, 1),
          () => changeProductSlide(pid, -1)
        );
      });

      const pdmGalleryContainer = document.getElementById('pdm-gallery-container');
      if (pdmGalleryContainer) {
        attachHorizontalSwipe(
          pdmGalleryContainer,
          () => changeProductSlide(state.activeProductId, 1),
          () => changeProductSlide(state.activeProductId, -1)
        );
      }

      // 6. Lógica de Carrusel Sincronizada con Negociación AVIF/WebP (Tarjeta + Modal Detalle)
      function changeProductSlide(productId: number, step: number) {
        const product = state.products.get(productId);
        if (!product || product.images.length <= 1) return;

        const total = product.images.length;
        let current = (product.currentSlide ?? 0) + step;
        if (current < 0) current = total - 1;
        if (current >= total) current = 0;
        product.currentSlide = current;

        const imgEl = document.querySelector<HTMLImageElement>(`[data-img-product="${productId}"]`);
        const counterEl = document.querySelector<HTMLElement>(`[data-counter-product="${productId}"]`);
        const card = document.querySelector<HTMLElement>(`.product-card[data-product-id="${productId}"]`);

        if (imgEl) {
          imgEl.style.opacity = '0.3';
          setTimeout(() => {
            const altText = `${product.name} — Corte ${product.fit} (${product.tag}) — Vista ${current + 1} de ${total}`;
            updatePictureElementForProduct(productId, product.images[current], altText);
            imgEl.style.opacity = '1';
          }, 120);
        }

        if (counterEl) {
          counterEl.textContent = String(current + 1);
        }

        if (card) {
          const dots = card.querySelectorAll<HTMLElement>('[data-dot-index]');
          dots.forEach((dot, idx) => {
            dot.className = idx === current
              ? "h-1 flex-1 rounded-full bg-white/90 shadow-sm transition-all duration-300"
              : "h-1 flex-1 rounded-full bg-white/30 transition-all duration-300";
          });
        }

        if (state.activeProductId === productId && !detailModal.classList.contains('pointer-events-none')) {
          updateDetailGallery();
        }
      }

      // 7. Selección y Sincronización de Tallas (Tarjeta + Modal Detalle + Modal Social)
      function selectProductSize(productId: number, size: SizeKey) {
        const product = state.products.get(productId);
        if (!product) return;
        if (product.availableSizes && product.availableSizes[size] === false) {
          showToast(`La talla ${size} está agotada en este modelo`);
          return;
        }
        product.selectedSize = size;

        const card = document.querySelector<HTMLElement>(`.product-card[data-product-id="${productId}"]`);
        if (card) {
          const chips = card.querySelectorAll<HTMLButtonElement>('.size-chip');
          chips.forEach((chip) => {
            const chipSize = chip.getAttribute('data-size') as SizeKey;
            const isAvail = product.availableSizes ? product.availableSizes[chipSize] !== false : true;
            if (!isAvail) {
              chip.disabled = true;
              chip.className = "size-chip min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-800 bg-slate-900/40 text-slate-600 line-through cursor-not-allowed text-center";
            } else if (chipSize === size) {
              chip.className = "size-chip min-h-[44px] py-2.5 text-xs font-bold rounded-xl border-2 border-pink-500 bg-pink-500/20 text-white shadow-lg shadow-pink-500/10 active:scale-95 transition-all text-center focus-visible:outline-none";
            } else {
              chip.className = "size-chip min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-700 bg-slate-800/50 text-slate-200 hover:border-slate-500 active:scale-95 transition-all text-center focus-visible:outline-none";
            }
          });

          const label = card.querySelector<HTMLElement>(`[data-size-label="${productId}"]`);
          const waBtnText = card.querySelector<HTMLElement>(`[data-btn-text-wa="${productId}"]`);
          const cardMeasBox = card.querySelector<HTMLElement>(`[data-card-measurements-box="${productId}"]`);
          const cardMeasText = card.querySelector<HTMLElement>(`[data-card-measurements-text="${productId}"]`);

          if (label) {
            label.textContent = `Talla ${size} seleccionada`;
            label.className = "text-[11px] font-bold text-emerald-400";
          }
          if (waBtnText) {
            waBtnText.textContent = `Pedir Talla ${size} por WhatsApp`;
          }
          if (cardMeasBox && cardMeasText) {
            cardMeasBox.classList.remove('hidden');
            cardMeasBox.classList.add('flex');
            cardMeasText.textContent = product.measurements[size];
          }
        }

        if (state.activeProductId === productId) {
          syncDetailModalSizes(productId);
          syncSocialModalState();
        }

        updateSavedBagUI();
      }

      // 8. Carrito de Compras Completo (Persistencia Local + Cantidades + Tallas + Envío Gratis)
      function getDefaultAvailableSize(product: ProductItem): SizeKey {
        if (product.selectedSize && (!product.availableSizes || product.availableSizes[product.selectedSize] !== false)) {
          return product.selectedSize;
        }
        const preferredOrder: SizeKey[] = ['M', 'L', 'S', 'XL'];
        for (const sz of preferredOrder) {
          if (!product.availableSizes || product.availableSizes[sz] !== false) {
            return sz;
          }
        }
        return 'M';
      }

      function saveCartToStorage() {
        try {
          const serialized = Array.from(state.cartItems.values());
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(serialized));
        } catch {
          // ignore storage quota errors
        }
      }

      function loadCartFromStorage() {
        try {
          const raw = localStorage.getItem(CART_STORAGE_KEY);
          if (!raw) return;
          const items = JSON.parse(raw);
          if (!Array.isArray(items)) return;
          state.cartItems.clear();
          state.savedProductIds.clear();
          items.forEach((entry: any) => {
            const pid = Number(entry.productId);
            const sz = (ALL_SIZES.includes(entry.size) ? entry.size : 'M') as SizeKey;
            const qty = Math.max(1, Math.min(20, Number(entry.qty) || 1));
            if (pid > 0) {
              const key = `${pid}:${sz}`;
              state.cartItems.set(key, { key, productId: pid, size: sz, qty });
              state.savedProductIds.add(pid);
            }
          });
        } catch {
          // ignore
        }
      }

      function syncSavedProductIdsFromCart() {
        state.savedProductIds.clear();
        state.cartItems.forEach((item) => {
          state.savedProductIds.add(item.productId);
        });
      }

      function getProductTotalQtyInCart(productId: number): number {
        let sum = 0;
        state.cartItems.forEach((item) => {
          if (item.productId === productId) sum += item.qty;
        });
        return sum;
      }

      function addToCart(productId: number, explicitSize?: SizeKey | null, deltaQty = 1) {
        const product = state.products.get(productId);
        if (!product) return;

        const chosenSize: SizeKey = explicitSize || product.selectedSize || getDefaultAvailableSize(product);
        if (product.availableSizes && product.availableSizes[chosenSize] === false) {
          showToast(`La talla ${chosenSize} está agotada en este modelo`);
          return;
        }

        if (!product.selectedSize) {
          selectProductSize(productId, chosenSize);
        }

        const key = `${productId}:${chosenSize}`;
        const existing = state.cartItems.get(key);
        const maxStock = Math.max(1, Number(product.stockLeft) || 10);
        const currentQty = existing ? existing.qty : 0;

        if (currentQty + deltaQty > maxStock) {
          showToast(`Stock máximo alcanzado (${maxStock} pzs disponibles de ${product.name})`);
          return;
        }

        const nextQty = currentQty + deltaQty;
        state.cartItems.set(key, {
          key,
          productId,
          size: chosenSize,
          qty: nextQty,
        });

        syncSavedProductIdsFromCart();
        saveCartToStorage();
        updateSavedBagUI();
        showToast(`🛒 ${product.name} (Talla ${chosenSize}) agregada al carrito`);
      }

      function changeCartItemQty(key: string, delta: number) {
        const item = state.cartItems.get(key);
        if (!item) return;
        const product = state.products.get(item.productId);
        const maxStock = product ? Math.max(1, Number(product.stockLeft) || 10) : 10;
        const nextQty = item.qty + delta;

        if (nextQty <= 0) {
          state.cartItems.delete(key);
          if (product) {
            showToast(`${product.name} (Talla ${item.size}) eliminada del carrito`);
          }
        } else if (nextQty > maxStock) {
          showToast(`Solo quedan ${maxStock} piezas disponibles de este modelo`);
          return;
        } else {
          item.qty = nextQty;
          state.cartItems.set(key, item);
        }

        syncSavedProductIdsFromCart();
        saveCartToStorage();
        updateSavedBagUI();
      }

      function changeCartItemSize(oldKey: string, newSize: SizeKey) {
        const item = state.cartItems.get(oldKey);
        if (!item || item.size === newSize) return;
        const product = state.products.get(item.productId);
        if (!product) return;

        if (product.availableSizes && product.availableSizes[newSize] === false) {
          showToast(`La talla ${newSize} está agotada`);
          return;
        }

        const newKey = `${item.productId}:${newSize}`;
        const targetExisting = state.cartItems.get(newKey);
        const maxStock = Math.max(1, Number(product.stockLeft) || 10);
        const combinedQty = Math.min(maxStock, (targetExisting ? targetExisting.qty : 0) + item.qty);

        state.cartItems.delete(oldKey);
        state.cartItems.set(newKey, {
          key: newKey,
          productId: item.productId,
          size: newSize,
          qty: combinedQty,
        });

        product.selectedSize = newSize;
        syncSavedProductIdsFromCart();
        saveCartToStorage();
        updateSavedBagUI();
        showToast(`Talla actualizada a ${newSize}`);
      }

      function removeCartItem(key: string) {
        const item = state.cartItems.get(key);
        if (!item) return;
        const product = state.products.get(item.productId);
        state.cartItems.delete(key);
        syncSavedProductIdsFromCart();
        saveCartToStorage();
        updateSavedBagUI();
        if (product) {
          showToast(`${product.name} eliminada del carrito`);
        }
      }

      function clearCart() {
        if (state.cartItems.size === 0) return;
        state.cartItems.clear();
        state.savedProductIds.clear();
        saveCartToStorage();
        updateSavedBagUI();
        showToast('Carrito vaciado');
      }

      function getCartTotals() {
        let totalUnits = 0;
        let subtotal = 0;
        state.cartItems.forEach((item) => {
          const prod = state.products.get(item.productId);
          if (!prod) return;
          totalUnits += item.qty;
          subtotal += prod.numericPrice * item.qty;
        });

        return {
          totalUnits,
          subtotal,
          grandTotal: subtotal,
        };
      }

      function updateSavedBagUI() {
        const { totalUnits, grandTotal } = getCartTotals();

        const headerBadge = document.getElementById('saved-bag-badge');
        const floatingBar = document.getElementById('floating-bag-bar');
        const floatingCount = document.getElementById('floating-bag-count');
        const floatingTotal = document.getElementById('floating-bag-total');
        const countPill = document.getElementById('cart-items-count-pill');
        const clearBtn = document.getElementById('clear-cart-btn');

        state.products.forEach((_, pid) => {
          const inCartQty = getProductTotalQtyInCart(pid);
          const cardCartBtnText = document.querySelector<HTMLElement>(`[data-btn-text-cart="${pid}"]`);
          if (cardCartBtnText) {
            cardCartBtnText.textContent = inCartQty > 0 ? `En Carrito (${inCartQty})` : 'Agregar';
          }
        });

        const pdmAddCartText = document.getElementById('pdm-btn-add-cart-text');
        if (pdmAddCartText) {
          const activeQty = getProductTotalQtyInCart(state.activeProductId);
          pdmAddCartText.textContent =
            activeQty > 0 ? `Agregar otra (${activeQty} en carrito)` : 'Agregar al Carrito';
        }

        if (headerBadge) {
          headerBadge.textContent = String(totalUnits);
          headerBadge.classList.toggle('hidden', totalUnits === 0);
          headerBadge.classList.toggle('flex', totalUnits > 0);
        }

        if (countPill) {
          countPill.textContent = `${totalUnits} ${totalUnits === 1 ? 'prenda' : 'prendas'}`;
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', totalUnits === 0);
        }

        if (floatingBar && floatingCount && floatingTotal) {
          floatingCount.textContent = String(totalUnits);
          floatingTotal.textContent = `$${grandTotal.toFixed(2)} USD`;
          if (totalUnits > 0) {
            floatingBar.classList.remove('translate-y-28', 'opacity-0', 'pointer-events-none');
          } else {
            floatingBar.classList.add('translate-y-28', 'opacity-0', 'pointer-events-none');
          }
        }

        renderSavedBagModalItems();
      }

      function renderSavedBagModalItems() {
        const container = document.getElementById('saved-bag-items');
        const subtotalEl = document.getElementById('cart-subtotal-val');
        const totalEl = document.getElementById('saved-bag-modal-total');
        if (!container || !totalEl) return;

        const { totalUnits, grandTotal } = getCartTotals();

        if (subtotalEl) subtotalEl.textContent = `$${grandTotal.toFixed(2)} USD`;

        if (state.cartItems.size === 0 || totalUnits === 0) {
          container.innerHTML = `
            <div class="text-center py-8 text-slate-400 space-y-2.5">
              <div class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mx-auto text-slate-500">
                <i class="fa-solid fa-bag-shopping text-xl"></i>
              </div>
              <p class="font-semibold text-slate-200 text-xs">Tu carrito está vacío</p>
              <p class="text-[11px] text-slate-500 max-w-[260px] mx-auto">Selecciona tu talla y presiona <strong class="text-pink-400">"Agregar"</strong> en cualquier prenda para armar tu pedido.</p>
            </div>
          `;
          totalEl.textContent = '$0.00 USD';
          return;
        }

        const rows: string[] = [];

        state.cartItems.forEach((item) => {
          const prod = state.products.get(item.productId);
          if (!prod) return;
          const lineTotal = prod.numericPrice * item.qty;
          const exactMeas = prod.measurements?.[item.size] || '';

          const sizeOptionsHtml = ALL_SIZES.map((sz) => {
            const isAvail = prod.availableSizes ? prod.availableSizes[sz] !== false : true;
            const isCurrent = sz === item.size;
            return `<button
              type="button"
              data-cart-size-key="${item.key}"
              data-cart-new-size="${sz}"
              ${!isAvail ? 'disabled' : ''}
              class="px-2 py-0.5 rounded text-[10px] font-bold transition-all ${
                !isAvail
                  ? 'bg-slate-900 text-slate-700 line-through cursor-not-allowed'
                  : isCurrent
                  ? 'bg-pink-500 text-white shadow'
                  : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'
              }"
            >${sz}</button>`;
          }).join('');

          rows.push(`
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800/90 flex flex-col gap-2.5">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <img
                    src="${prod.images[0]}"
                    alt="${prod.name}"
                    width="56"
                    height="68"
                    loading="lazy"
                    decoding="async"
                    data-cart-open-detail="${prod.id}"
                    class="w-14 h-16 rounded-xl object-cover border border-slate-800 shrink-0 cursor-pointer hover:opacity-85 transition-opacity"
                  />
                  <div class="min-w-0">
                    <p
                      data-cart-open-detail="${prod.id}"
                      class="font-bold text-white text-xs truncate cursor-pointer hover:text-pink-400 transition-colors"
                    >${prod.name}</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">${prod.price} c/u • <span class="font-mono text-emerald-400 font-bold">$${lineTotal.toFixed(2)}</span></p>
                    ${
                      exactMeas
                        ? `<p class="text-[10px] text-slate-500 font-mono mt-0.5 truncate"><i class="fa-solid fa-ruler-combined text-pink-400/80 mr-1"></i>${exactMeas}</p>`
                        : ''
                    }
                  </div>
                </div>
                <button
                  type="button"
                  data-remove-saved="${item.key}"
                  class="w-7 h-7 rounded-full bg-slate-900 text-slate-400 hover:text-red-400 hover:bg-red-500/10 flex items-center justify-center shrink-0 transition-colors"
                  aria-label="Quitar prenda del carrito"
                >
                  <i class="fa-solid fa-trash-can text-[11px]"></i>
                </button>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-slate-900 gap-2">
                <div class="flex items-center gap-1">
                  <span class="text-[10px] text-slate-400 font-semibold mr-1">Talla:</span>
                  ${sizeOptionsHtml}
                </div>
                <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl px-1.5 py-0.5">
                  <button
                    type="button"
                    data-cart-dec="${item.key}"
                    class="w-6 h-6 rounded-lg bg-slate-950 hover:bg-slate-800 text-slate-300 flex items-center justify-center text-xs font-bold active:scale-90 transition-all"
                    aria-label="Disminuir cantidad"
                  >−</button>
                  <span class="font-mono font-bold text-xs text-white min-w-[20px] text-center">${item.qty}</span>
                  <button
                    type="button"
                    data-cart-inc="${item.key}"
                    class="w-6 h-6 rounded-lg bg-slate-950 hover:bg-pink-500/20 text-pink-400 flex items-center justify-center text-xs font-bold active:scale-90 transition-all"
                    aria-label="Aumentar cantidad"
                  >+</button>
                </div>
              </div>
            </div>
          `);
        });

        container.innerHTML = rows.join('');
        totalEl.textContent = `$${grandTotal.toFixed(2)} USD`;

        container.querySelectorAll<HTMLButtonElement>('[data-remove-saved]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-remove-saved');
            if (key) removeCartItem(key);
          });
        });

        container.querySelectorAll<HTMLButtonElement>('[data-cart-dec]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-cart-dec');
            if (key) changeCartItemQty(key, -1);
          });
        });

        container.querySelectorAll<HTMLButtonElement>('[data-cart-inc]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-cart-inc');
            if (key) changeCartItemQty(key, 1);
          });
        });

        container.querySelectorAll<HTMLButtonElement>('[data-cart-size-key]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-cart-size-key');
            const newSz = btn.getAttribute('data-cart-new-size') as SizeKey;
            if (key && newSz) changeCartItemSize(key, newSz);
          });
        });

        container.querySelectorAll<HTMLElement>('[data-cart-open-detail]').forEach((el) => {
          el.addEventListener('click', () => {
            const pid = Number(el.getAttribute('data-cart-open-detail'));
            if (pid) {
              closeSavedBagModal();
              openDetailModal(pid);
            }
          });
        });
      }

      // 9. Modal de Detalles (Bottom Sheet)
      function openDetailModal(productId: number) {
        state.activeProductId = productId;
        const product = state.products.get(productId);
        if (!product) return;

        (document.getElementById('detail-tag-header') as HTMLElement).textContent = product.tag;
        (document.getElementById('pdm-title') as HTMLElement).textContent = product.name;
        (document.getElementById('pdm-category-badge') as HTMLElement).textContent = `CATEGORÍA: ${product.category.toUpperCase()}`;
        (document.getElementById('pdm-price') as HTMLElement).textContent = product.price;
        (document.getElementById('pdm-fit') as HTMLElement).textContent = product.fit;
        (document.getElementById('pdm-model-info') as HTMLElement).textContent = product.modelInfo;
        (document.getElementById('pdm-stock-badge') as HTMLElement).textContent = `Quedan ${product.stockLeft} pzs`;
        (document.getElementById('pdm-scarcity-text') as HTMLElement).textContent = `Edición limitada: solo ${product.stockLeft} piezas disponibles en este drop.`;

        const specsContainer = document.getElementById('pdm-specs-list') as HTMLElement;
        specsContainer.innerHTML = product.specs.map((s) => `<li>${s}</li>`).join('');

        const hasMultipleImages = product.images.length > 1;
        const dotsContainer = document.getElementById('pdm-dots-container') as HTMLElement;
        dotsContainer.innerHTML = hasMultipleImages
          ? product.images
              .map(
                (_, i) =>
                  `<div class="h-1 flex-1 rounded-full transition-all duration-300 ${
                    i === (product.currentSlide ?? 0) ? 'bg-white/90' : 'bg-white/30'
                  }" id="pdm-dot-${i}"></div>`
              )
              .join('')
          : '';
        dotsContainer.classList.toggle('hidden', !hasMultipleImages);

        (document.getElementById('pdm-total-counter') as HTMLElement).textContent = String(product.images.length);

        const pdmPrevBtn = document.getElementById('pdm-slide-prev') as HTMLButtonElement | null;
        const pdmNextBtn = document.getElementById('pdm-slide-next') as HTMLButtonElement | null;
        if (pdmPrevBtn) {
          pdmPrevBtn.disabled = !hasMultipleImages;
          pdmPrevBtn.classList.toggle('hidden', !hasMultipleImages);
          pdmPrevBtn.classList.toggle('flex', hasMultipleImages);
        }
        if (pdmNextBtn) {
          pdmNextBtn.disabled = !hasMultipleImages;
          pdmNextBtn.classList.toggle('hidden', !hasMultipleImages);
          pdmNextBtn.classList.toggle('flex', hasMultipleImages);
        }

        updateDetailGallery();
        syncDetailModalSizes(productId);
        updateSavedBagUI();

        detailModal.classList.remove('opacity-0', 'pointer-events-none');
        detailModalCard.classList.remove('translate-y-full');

        if (product.slug && window.location.pathname !== `/p/${product.slug}`) {
          window.history.pushState({ productSlug: product.slug }, '', `/p/${encodeURIComponent(product.slug)}`);
        }
      }

      function closeDetailModal() {
        detailModalCard.classList.add('translate-y-full');
        detailModal.classList.add('opacity-0', 'pointer-events-none');

        if (window.location.pathname.startsWith('/p/')) {
          window.history.pushState({}, '', '/');
        }
      }

      window.addEventListener('popstate', () => {
        if (!window.location.pathname.startsWith('/p/')) {
          detailModalCard.classList.add('translate-y-full');
          detailModal.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      function updateDetailGallery() {
        const product = state.products.get(state.activeProductId);
        if (!product) return;

        const current = product.currentSlide ?? 0;
        const rawUrl = product.images[current] || product.images[0];
        const responsive = buildResponsiveSources(rawUrl, state.saveDataActive);
        const avifEl = document.getElementById('pdm-source-avif') as HTMLSourceElement | null;
        const webpEl = document.getElementById('pdm-source-webp') as HTMLSourceElement | null;
        const imgEl = document.getElementById('pdm-image') as HTMLImageElement;
        const counterEl = document.getElementById('pdm-counter') as HTMLElement;
        const metaBadge = document.getElementById('pdm-r2-meta-badge');

        imgEl.style.opacity = '0.3';
        setTimeout(() => {
          delete imgEl.dataset.fallbackApplied;
          if (avifEl) {
            avifEl.srcset = responsive.avifSrcset;
            avifEl.sizes = responsive.sizes;
          }
          if (webpEl) {
            webpEl.srcset = responsive.webpSrcset;
            webpEl.sizes = responsive.sizes;
          }
          imgEl.srcset = responsive.webpSrcset;
          imgEl.sizes = responsive.sizes;
          imgEl.src = responsive.fallbackSrc;
          imgEl.alt = `${product.name} — Corte ${product.fit} (${product.tag}) — Vista detallada ${current + 1} de ${product.images.length}`;
          imgEl.style.opacity = '1';
          counterEl.textContent = String(current + 1);

          const meta = product.imageMeta?.[current];
          if (metaBadge) {
            const hashShort = meta?.contentHash ? `SHA256:${meta.contentHash.slice(0, 8)}` : 'Immutable';
            metaBadge.textContent = `R2 Edge • AVIF/WebP • ${hashShort} • EXIF=0`;
          }
        }, 100);

        product.images.forEach((_, idx) => {
          const dot = document.getElementById(`pdm-dot-${idx}`);
          if (dot) {
            dot.className = `h-1 flex-1 rounded-full transition-all duration-300 ${
              idx === current ? 'bg-white/90' : 'bg-white/30'
            }`;
          }
        });
      }

      function syncDetailModalSizes(productId: number) {
        const product = state.products.get(productId);
        if (!product) return;

        const currentSize = product.selectedSize;
        const detailButtons = document.querySelectorAll<HTMLButtonElement>('.pdm-size-btn');

        detailButtons.forEach((btn) => {
          const sz = btn.getAttribute('data-detail-size') as SizeKey;
          const isAvail = product.availableSizes ? product.availableSizes[sz] !== false : true;
          btn.disabled = !isAvail;
          if (!isAvail) {
            btn.className = "pdm-size-btn min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-800 bg-slate-900/40 text-slate-600 line-through cursor-not-allowed transition-all";
          } else if (sz === currentSize) {
            btn.className = "pdm-size-btn min-h-[44px] py-2.5 text-xs font-bold rounded-xl border-2 border-pink-500 bg-pink-500/20 text-white shadow-lg shadow-pink-500/10 transition-all focus-visible:outline-none";
          } else {
            btn.className = "pdm-size-btn min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-700 bg-slate-800/50 text-slate-200 transition-all focus-visible:outline-none";
          }
        });

        const statusEl = document.getElementById('pdm-size-status') as HTMLElement;
        const measurementsEl = document.getElementById('pdm-measurements') as HTMLElement;
        const waText = document.getElementById('pdm-btn-wa-text') as HTMLElement;
        const sizeTableEl = document.getElementById('pdm-size-table') as HTMLElement;

        if (currentSize) {
          statusEl.textContent = `Talla ${currentSize} seleccionada`;
          statusEl.className = "text-xs font-bold text-emerald-400";
          measurementsEl.textContent = product.measurements[currentSize];
          waText.textContent = `Pedir Talla ${currentSize}`;
        } else {
          statusEl.textContent = "Selecciona una talla";
          statusEl.className = "text-xs font-bold text-pink-400";
          measurementsEl.textContent = "Selecciona talla para ver cm";
          waText.textContent = "Pedir Ahora";
        }

        if (sizeTableEl) {
          sizeTableEl.innerHTML = ALL_SIZES.map((sz) => {
            const isSelected = sz === currentSize;
            return `
              <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg ${
                isSelected
                  ? 'bg-pink-500/20 border border-pink-500/40 text-white font-bold'
                  : 'bg-slate-900/70 text-slate-400'
              }">
                <span>Talla ${sz}</span>
                <span>${product.measurements[sz]}</span>
              </div>
            `;
          }).join('');
        }
      }

      // 10. Eventos del Modal Detalle
      document.getElementById('pdm-close-btn')?.addEventListener('click', closeDetailModal);

      document.getElementById('pdm-slide-prev')?.addEventListener('click', () => {
        changeProductSlide(state.activeProductId, -1);
      });

      document.getElementById('pdm-slide-next')?.addEventListener('click', () => {
        changeProductSlide(state.activeProductId, 1);
      });

      document.querySelectorAll<HTMLButtonElement>('.pdm-size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sz = btn.getAttribute('data-detail-size') as SizeKey;
          selectProductSize(state.activeProductId, sz);
        });
      });

      document.getElementById('pdm-btn-add-cart')?.addEventListener('click', () => {
        const product = state.products.get(state.activeProductId);
        addToCart(state.activeProductId, product?.selectedSize || null, 1);
      });

      document.getElementById('pdm-btn-wa')?.addEventListener('click', () => {
        triggerSocial(state.activeProductId, 'whatsapp');
      });

      document.getElementById('pdm-btn-ig')?.addEventListener('click', () => {
        triggerSocial(state.activeProductId, 'instagram');
      });

      function getProductDirectUrl(product: ProductItem): string {
        const slugPath = product.slug ? `/p/${encodeURIComponent(product.slug)}` : '/';
        return new URL(slugPath, window.location.origin).toString();
      }

      async function shareProductById(productId: number) {
        const product = state.products.get(productId);
        if (!product) return;
        const productUrl = getProductDirectUrl(product);
        const shareText = `Mira ${product.name} (${product.price}) en URBAN_DROP`;

        if (navigator.share) {
          try {
            await navigator.share({
              title: product.name,
              text: shareText,
              url: productUrl,
            });
            return;
          } catch {
            // Continúa al fallback de portapapeles
          }
        }

        if (navigator.clipboard) {
          await navigator.clipboard.writeText(productUrl);
          showToast('¡Enlace directo de la prenda copiado!');
        }
      }

      document.getElementById('pdm-share-btn')?.addEventListener('click', () => {
        shareProductById(state.activeProductId);
      });

      // 11. Lógica Social Commerce (WhatsApp / Instagram + Confirmación de Talla)
      function syncSocialModalState() {
        if (state.isMultiOrderSocial) return;
        const product = state.products.get(state.activeProductId);
        if (!product) return;

        const size = product.selectedSize || 'S/M (Por confirmar)';
        const exactCm = product.selectedSize ? ` [${product.measurements[product.selectedSize]}]` : '';
        const productUrl = getProductDirectUrl(product);
        const message = `¡Hola URBAN_DROP! 🔥 Me interesa la prenda *${product.name}* (${product.price}) en Talla *${size}*${exactCm}.\nEnlace: ${productUrl}`;

        state.activeMessageText = message;

        const previewText = document.getElementById('social-preview-text') as HTMLElement;
        const sizeMeasEl = document.getElementById('social-size-measurements') as HTMLElement;
        const socialSizeBtns = document.querySelectorAll<HTMLButtonElement>('.social-size-btn');

        previewText.textContent = `"${message}"`;

        if (sizeMeasEl) {
          sizeMeasEl.textContent = product.selectedSize
            ? product.measurements[product.selectedSize]
            : 'Elige una talla arriba';
        }

        socialSizeBtns.forEach((btn) => {
          const sz = btn.getAttribute('data-social-size');
          if (sz === product.selectedSize) {
            btn.className = "social-size-btn py-2 text-xs font-bold rounded-xl border-2 border-pink-500 bg-pink-500/20 text-white transition-all";
          } else {
            btn.className = "social-size-btn py-2 text-xs font-bold rounded-xl border border-slate-700 bg-slate-800/50 text-slate-200 hover:border-slate-500 transition-all";
          }
        });

        if (state.activeSocialChannel === 'whatsapp') {
          state.activeRedirectUrl = `https://wa.me/${state.whatsappNumber}?text=${encodeURIComponent(message)}`;
        } else {
          state.activeRedirectUrl = state.instagramUrl;
        }
      }

      function triggerSocial(productId: number, channel: 'whatsapp' | 'instagram') {
        const product = state.products.get(productId);
        if (!product) return;

        state.activeProductId = productId;
        state.activeSocialChannel = channel;
        state.isMultiOrderSocial = false;

        const socialSizeBox = document.getElementById('social-size-box') as HTMLElement;
        const modalTitle = document.getElementById('social-modal-title') as HTMLElement;
        const modalSubtitle = document.getElementById('social-modal-subtitle') as HTMLElement;
        const iconBg = document.getElementById('modal-icon-bg') as HTMLElement;
        const socialIcon = document.getElementById('modal-social-icon') as HTMLElement;
        const confirmBtnText = document.getElementById('confirm-redirect-text') as HTMLElement;

        socialSizeBox?.classList.remove('hidden');
        syncSocialModalState();

        if (channel === 'whatsapp') {
          modalTitle.textContent = 'Iniciando Chat de WhatsApp';
          modalSubtitle.textContent = 'Mensaje pre-estructurado listo para enviar';
          iconBg.className = 'w-10 h-10 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl';
          socialIcon.className = 'fa-brands fa-whatsapp';
          confirmBtnText.textContent = 'Abrir WhatsApp Ahora';
        } else {
          modalTitle.textContent = 'Iniciando DM en Instagram';
          modalSubtitle.textContent = 'Copiamos tu mensaje para pegarlo en el DM';
          iconBg.className = 'w-10 h-10 rounded-2xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-xl';
          socialIcon.className = 'fa-brands fa-instagram';
          confirmBtnText.textContent = 'Copiar y Abrir Instagram DM';
          if (navigator.clipboard) {
            navigator.clipboard.writeText(state.activeMessageText).catch(() => {});
          }
        }

        socialModal.classList.remove('opacity-0', 'pointer-events-none');
        socialModalCard.classList.remove('translate-y-10');
      }

      document.querySelectorAll<HTMLButtonElement>('.social-size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sz = btn.getAttribute('data-social-size') as SizeKey;
          selectProductSize(state.activeProductId, sz);
        });
      });

      document.getElementById('copy-message-btn')?.addEventListener('click', async () => {
        if (!state.activeMessageText || !navigator.clipboard) return;
        await navigator.clipboard.writeText(state.activeMessageText);
        const label = document.getElementById('copy-message-label');
        if (label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            label.textContent = 'Copiar texto';
          }, 1800);
        }
        showToast('¡Mensaje copiado al portapapeles!');
      });

      function closeSocialModal() {
        socialModalCard.classList.add('translate-y-10');
        socialModal.classList.add('opacity-0', 'pointer-events-none');
      }

      document.getElementById('close-social-btn')?.addEventListener('click', closeSocialModal);
      document.getElementById('confirm-redirect-btn')?.addEventListener('click', async () => {
        if (state.activeSocialChannel === 'instagram' && navigator.clipboard && state.activeMessageText) {
          await navigator.clipboard.writeText(state.activeMessageText).catch(() => {});
        }
        if (state.activeRedirectUrl) {
          window.open(state.activeRedirectUrl, '_blank', 'noopener,noreferrer');
        }
        closeSocialModal();
      });

      // 12. Eventos del Carrito de Compras (Bolsa Drop)
      function openSavedBagModal() {
        renderSavedBagModalItems();
        savedBagModal.classList.remove('opacity-0', 'pointer-events-none');
      }

      function closeSavedBagModal() {
        savedBagModal.classList.add('opacity-0', 'pointer-events-none');
      }

      document.getElementById('btn-saved-bag')?.addEventListener('click', openSavedBagModal);
      document.getElementById('open-bag-modal-btn')?.addEventListener('click', openSavedBagModal);
      document.getElementById('close-bag-btn')?.addEventListener('click', closeSavedBagModal);
      document.getElementById('clear-cart-btn')?.addEventListener('click', clearCart);

      function checkoutCartByChannel(channel: 'whatsapp' | 'instagram') {
        if (state.cartItems.size === 0) {
          showToast('Tu carrito está vacío. Agrega al menos una prenda.');
          return;
        }

        const { totalUnits, grandTotal } = getCartTotals();
        const lines: string[] = [];

        state.cartItems.forEach((item) => {
          const p = state.products.get(item.productId);
          if (!p) return;
          const lineTotal = p.numericPrice * item.qty;
          const exactCm = p.measurements?.[item.size] ? ` [${p.measurements[item.size]}]` : '';
          const directUrl = getProductDirectUrl(p);
          lines.push(`• ${item.qty}x *${p.name}* — Talla *${item.size}*${exactCm} ($${lineTotal.toFixed(2)} USD)\n  Enlace: ${directUrl}`);
        });

        const notesInput = document.getElementById('cart-order-notes') as HTMLInputElement | null;
        const notes = notesInput?.value ? notesInput.value.trim() : '';
        const notesLine = notes ? `\nNota de entrega: _${notes}_` : '';

        const multiMsg = `¡Hola URBAN_DROP! 🔥 Quiero confirmar mi carrito del Drop #04 (${totalUnits} ${
          totalUnits === 1 ? 'prenda' : 'prendas'
        }):\n${lines.join('\n')}\nTotal a pagar: *$${grandTotal.toFixed(
          2
        )} USD*${notesLine}\n¿Me confirman datos de pago y disponibilidad?`;

        state.isMultiOrderSocial = true;
        state.activeSocialChannel = channel;
        state.activeMessageText = multiMsg;
        state.activeRedirectUrl =
          channel === 'whatsapp'
            ? `https://wa.me/${state.whatsappNumber}?text=${encodeURIComponent(multiMsg)}`
            : state.instagramUrl;

        closeSavedBagModal();

        const socialSizeBox = document.getElementById('social-size-box') as HTMLElement;
        const previewText = document.getElementById('social-preview-text') as HTMLElement;
        const modalTitle = document.getElementById('social-modal-title') as HTMLElement;
        const modalSubtitle = document.getElementById('social-modal-subtitle') as HTMLElement;
        const iconBg = document.getElementById('modal-icon-bg') as HTMLElement;
        const socialIcon = document.getElementById('modal-social-icon') as HTMLElement;
        const confirmBtnText = document.getElementById('confirm-redirect-text') as HTMLElement;

        socialSizeBox?.classList.add('hidden');
        previewText.textContent = `"${multiMsg}"`;

        if (channel === 'whatsapp') {
          modalTitle.textContent = `Checkout de Carrito (${totalUnits} ${totalUnits === 1 ? 'Prenda' : 'Prendas'})`;
          modalSubtitle.textContent = 'Orden completa lista para enviar por WhatsApp';
          iconBg.className = 'w-10 h-10 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl';
          socialIcon.className = 'fa-brands fa-whatsapp';
          confirmBtnText.textContent = 'Enviar Pedido por WhatsApp';
        } else {
          modalTitle.textContent = `Checkout por Instagram DM (${totalUnits} ${totalUnits === 1 ? 'Prenda' : 'Prendas'})`;
          modalSubtitle.textContent = 'Copiamos tu carrito para pegarlo en el DM';
          iconBg.className = 'w-10 h-10 rounded-2xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-xl';
          socialIcon.className = 'fa-brands fa-instagram';
          confirmBtnText.textContent = 'Copiar Pedido y Abrir Instagram DM';
          if (navigator.clipboard) {
            navigator.clipboard.writeText(multiMsg).catch(() => {});
          }
        }

        socialModal.classList.remove('opacity-0', 'pointer-events-none');
        socialModalCard.classList.remove('translate-y-10');
      }

      document.getElementById('send-bag-wa-btn')?.addEventListener('click', () => {
        checkoutCartByChannel('whatsapp');
      });

      document.getElementById('send-bag-ig-btn')?.addEventListener('click', () => {
        checkoutCartByChannel('instagram');
      });

      loadCartFromStorage();
      updateSavedBagUI();

      // 13. Modales adicionales (UX + Cloudflare R2 Pipeline), Click en Backdrop y Teclado
      const btnInfo = document.getElementById('btn-info-modal');
      const closeUxBtn = document.getElementById('close-ux-btn');
      const btnR2Modal = document.getElementById('btn-r2-pipeline-modal');
      const closeR2ModalBtn = document.getElementById('close-r2-modal-btn');
      const toggleSaveDataBtn = document.getElementById('toggle-save-data-btn');

      btnInfo?.addEventListener('click', () => {
        if (!isAdminSessionActive()) return;
        uxInfoModal.classList.remove('opacity-0', 'pointer-events-none');
      });

      closeUxBtn?.addEventListener('click', () => {
        uxInfoModal.classList.add('opacity-0', 'pointer-events-none');
      });

      btnR2Modal?.addEventListener('click', () => {
        if (!isAdminSessionActive()) return;
        r2PipelineModal?.classList.remove('opacity-0', 'pointer-events-none');
      });

      closeR2ModalBtn?.addEventListener('click', () => {
        r2PipelineModal?.classList.add('opacity-0', 'pointer-events-none');
      });

      toggleSaveDataBtn?.addEventListener('click', () => {
        state.saveDataActive = !state.saveDataActive;
        try {
          localStorage.setItem(SAVE_DATA_STORAGE_KEY, state.saveDataActive ? '1' : '0');
        } catch {
          // ignore
        }
        applySaveDataUI();
        showToast(
          state.saveDataActive
            ? 'Directiva Save-Data activada: imágenes en modo ahorro (q=52)'
            : 'Directiva Save-Data desactivada: máxima calidad AVIF/WebP (q=80)'
        );
      });

      // Cerrar cualquier modal al hacer clic en el fondo oscuro (backdrop)
      detailModal?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === detailModal) closeDetailModal();
      });
      socialModal?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === socialModal) closeSocialModal();
      });
      uxInfoModal?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === uxInfoModal) uxInfoModal.classList.add('opacity-0', 'pointer-events-none');
      });
      r2PipelineModal?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === r2PipelineModal) r2PipelineModal.classList.add('opacity-0', 'pointer-events-none');
      });
      savedBagModal?.addEventListener('click', (e: MouseEvent) => {
        if (e.target === savedBagModal) closeSavedBagModal();
      });

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          closeDetailModal();
          closeSocialModal();
          closeSavedBagModal();
          uxInfoModal.classList.add('opacity-0', 'pointer-events-none');
          r2PipelineModal?.classList.add('opacity-0', 'pointer-events-none');
        } else if (!detailModal.classList.contains('pointer-events-none')) {
          if (e.key === 'ArrowLeft') changeProductSlide(state.activeProductId, -1);
          if (e.key === 'ArrowRight') changeProductSlide(state.activeProductId, 1);
        }
      });
    </script>

    <!-- ============================================================== -->
    <!-- ESTILOS ESPECÍFICOS, CLS=0 Y ACELERACIÓN POR HARDWARE (GPU)    -->
    <!-- ============================================================== -->
    <style>
      .font-heading {
        font-family: 'Space Grotesk', sans-serif;
      }

      /* Reserva estricta de espacio intrínseco (CLS = 0) y Aceleración por Hardware */
      .r2-gpu-layer {
        aspect-ratio: 3 / 4;
        contain: layout paint;
        transform: translate3d(0, 0, 0);
        backface-visibility: hidden;
        will-change: transform;
        touch-action: pan-y pinch-zoom;
      }

      .card-img {
        aspect-ratio: 3 / 4;
      }

      /* Animación sutil de pulso para el CTA principal */
      @keyframes pulse-subtle {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.02);
        }
      }

      .btn-social-pulse {
        animation: pulse-subtle 3s infinite ease-in-out;
      }

      /* Ocultar scrollbar nativa manteniendo el scroll táctil */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
