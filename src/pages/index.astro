---
// =============================================================================
// FRONTMATTER DE ASTRO (Se ejecuta en el servidor / build time)
// Conectado a Supabase PostgreSQL (5 tablas relacionales con RLS)
// =============================================================================

import { categories, sizes } from '../data/products';
import { fetchCatalogFromSupabase } from '../lib/supabase';
import {
  buildEdgeResponsiveSources,
  createLqipSvgDataUri,
  INTRINSIC_WIDTH,
  INTRINSIC_HEIGHT,
} from '../lib/cloudflare-r2';

// Obtiene el catálogo en el servidor directamente desde Supabase PostgreSQL
const { products } = await fetchCatalogFromSupabase();
const lcpCandidateSources = buildEdgeResponsiveSources(products[0]?.images[0] || '');

const categoryCounts: Record<string, number> = {
  todos: products.length,
  hoodies: products.filter((p) => p.category === 'hoodies').length,
  pantalones: products.filter((p) => p.category === 'pantalones').length,
  't-shirts': products.filter((p) => p.category === 't-shirts').length,
  chaquetas: products.filter((p) => p.category === 'chaquetas').length,
};

// Metadatos de la página
const pageTitle = "URBAN_DROP — Catálogo Social Streetwear";
const pageDescription = "Descubre lanzamientos exclusivos de ropa urbana y haz tu pedido directo por WhatsApp o Instagram.";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Google Fonts & Edge Image CDN Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <!-- Critical Path LCP Preload (Negociación AVIF + Descriptores DPR + fetchpriority="high") -->
    <link
      id="lcp-preload-link"
      rel="preload"
      as="image"
      type="image/avif"
      href={lcpCandidateSources.fallbackSrc}
      imagesrcset={lcpCandidateSources.avifSrcset}
      imagesizes={lcpCandidateSources.sizes}
      fetchpriority="high"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Iconografía Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>

  <body class="min-h-screen pb-28 select-none bg-slate-950 antialiased font-sans text-slate-100">
    <!-- ========================================== -->
    <!-- TOAST DE NOTIFICACIONES RÁPIDAS            -->
    <!-- ========================================== -->
    <div
      id="toast-notification"
      class="fixed top-16 left-1/2 -translate-x-1/2 z-[60] px-4 py-2.5 rounded-2xl bg-slate-900/95 border border-emerald-500/40 text-emerald-400 text-xs font-bold shadow-2xl backdrop-blur-md flex items-center gap-2 opacity-0 pointer-events-none -translate-y-3 transition-all duration-300"
      role="status"
      aria-live="polite"
    >
      <i id="toast-icon" class="fa-solid fa-circle-check text-sm" aria-hidden="true"></i>
      <span id="toast-message">Acción completada</span>
    </div>

    <!-- ========================================== -->
    <!-- HEADER STICKY (Accesibilidad y Jerarquía)  -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80 px-4 py-3">
      <div class="max-w-md mx-auto flex items-center justify-between">
        <!-- Brand Identifier -->
        <a href="#" class="flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 rounded-lg">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-500 via-purple-500 to-emerald-400 p-[2px]">
            <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center">
              <i class="fa-solid fa-fire text-xs text-pink-500" aria-hidden="true"></i>
            </div>
          </div>
          <div>
            <span class="font-heading text-lg font-bold tracking-tight text-white block leading-none">URBAN_DROP</span>
            <span class="text-[9px] font-mono text-slate-400 tracking-widest uppercase">Drop #04 • Streetwear</span>
          </div>
        </a>

        <!-- Estado en tiempo real del catálogo y utilidades -->
        <div class="flex items-center gap-1.5">
          <!-- Botón Telemetría Cloudflare R2 & Edge Image Pipeline (Solo Admin) -->
          <button
            id="btn-r2-pipeline-modal"
            data-admin-only="flex"
            type="button"
            class="hidden px-2 py-1 rounded-full bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 items-center gap-1 text-[10px] font-mono font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
            aria-label="Ver arquitectura de imágenes Cloudflare R2, AVIF/WebP, LCP y Seguridad"
            title="Cloudflare R2 Edge Media Pipeline (AVIF/WebP • DPR • CLS=0 • Presigned S3)"
          >
            <i class="fa-solid fa-cloud-bolt text-[10px] text-amber-400" aria-hidden="true"></i>
            <span id="r2-header-pill-text">R2•AVIF</span>
          </button>

          <!-- Botón Bolsa / Selección Guardada -->
          <button
            id="btn-saved-bag"
            type="button"
            class="relative w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center text-xs hover:bg-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
            aria-label="Ver prendas guardadas para pedido múltiple"
          >
            <i class="fa-solid fa-bag-shopping text-pink-400" aria-hidden="true"></i>
            <span
              id="saved-bag-badge"
              class="hidden absolute -top-1 -right-1 w-4 h-4 rounded-full bg-pink-500 text-white text-[9px] font-bold items-center justify-center shadow"
            >
              0
            </span>
          </button>

          <!-- Botón Consultoría UX (Solo Admin) -->
          <button
            id="btn-info-modal"
            data-admin-only="flex"
            type="button"
            class="hidden w-8 h-8 rounded-full bg-slate-800 text-slate-300 items-center justify-center text-xs hover:bg-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
            aria-label="Ver Justificación UX"
          >
            <i class="fa-solid fa-lightbulb text-amber-400" aria-hidden="true"></i>
          </button>

          <!-- Acceso a Ruta /login (Autenticación JWT OWASP 2025) -->
          <a
            href="/login"
            id="nav-login-link"
            class="w-8 h-8 rounded-full bg-slate-800 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs hover:bg-emerald-500/20 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
            aria-label="Acceso Administrativo JWT (OWASP 2025)"
            title="Login Seguro JWT (OWASP 2025)"
          >
            <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </header>

    <!-- ========================================== -->
    <!-- BANNER EXPLICATIVO (Reducción de Fricción) -->
    <!-- ========================================== -->
    <section class="max-w-md mx-auto px-4 pt-4 pb-2">
      <div class="p-3.5 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-900/90 border border-slate-800 flex items-center justify-between text-xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center text-sm font-bold shrink-0">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
          </div>
          <div>
            <p class="font-bold text-slate-200">Catálogo Social Commerce</p>
            <p class="text-[11px] text-slate-400">Toca la imagen para fotos y medidas en cm</p>
          </div>
        </div>
        <div class="flex flex-col items-end gap-1 shrink-0">
          <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono px-2 py-0.5 rounded-lg">
            WhatsApp / DM
          </span>
          <span id="save-data-banner-indicator" class="hidden text-[9px] bg-amber-500/15 text-amber-300 border border-amber-500/30 font-mono px-1.5 py-0.5 rounded">
            Save-Data: ON (q=52)
          </span>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- BUSCADOR RÁPIDO Y FILTRO INTELIGENTE       -->
    <!-- ========================================== -->
    <section class="max-w-md mx-auto px-4 pt-1 pb-1">
      <div class="relative flex items-center">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 text-slate-500 text-xs pointer-events-none" aria-hidden="true"></i>
        <input
          id="catalog-search-input"
          type="search"
          placeholder="Buscar prenda, corte (boxy, cargo) o tela..."
          class="w-full bg-slate-900/90 border border-slate-800 focus:border-pink-500/60 rounded-xl pl-9 pr-9 py-2.5 text-xs text-slate-100 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-pink-500/20 transition-all"
          aria-label="Buscar prendas en el catálogo"
        />
        <button
          id="clear-search-btn"
          type="button"
          class="hidden absolute right-2.5 w-6 h-6 rounded-full bg-slate-800 text-slate-400 hover:text-white items-center justify-center text-[10px]"
          aria-label="Limpiar búsqueda"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SELECTOR DE CATEGORÍAS (CSS Scroll Snap)   -->
    <!-- ========================================== -->
    <nav class="max-w-md mx-auto px-4 pt-1 pb-2 overflow-x-auto no-scrollbar snap-x snap-mandatory touch-pan-x" aria-label="Categorías de prendas">
      <div class="flex items-center gap-2 py-1" id="category-pills">
        {categories.map((cat, index) => (
          <button
            type="button"
            data-category-id={cat.id}
            aria-pressed={index === 0 ? "true" : "false"}
            class:list={[
              "cat-btn snap-start font-bold text-xs px-3.5 py-2 rounded-xl whitespace-nowrap transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500",
              index === 0
                ? "bg-pink-500 text-white shadow-md shadow-pink-500/20"
                : "bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800"
            ]}
          >
            <span>{cat.label}</span>
            <span
              class:list={[
                "cat-count text-[10px] font-mono px-1.5 py-0.2 rounded-full",
                index === 0 ? "bg-white/20 text-white" : "bg-slate-800 text-slate-400"
              ]}
            >
              {categoryCounts[cat.id]}
            </span>
          </button>
        ))}
      </div>
    </nav>

    <!-- ========================================== -->
    <!-- FEED DE PRODUCTOS (Cloudflare R2 + Edge)   -->
    <!-- ========================================== -->
    <main class="max-w-md mx-auto px-4 py-2 space-y-6" id="catalog-container">
      {products.map((product, pIndex) => {
        const responsiveSources = buildEdgeResponsiveSources(product.images[0]);
        const lqipBg = createLqipSvgDataUri('#0f172a', '#1e1b4b');
        const isLcp = pIndex === 0;
        return (
        <article
          class="product-card bg-slate-900/90 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl flex flex-col relative transition-all duration-300"
          data-product-id={product.id}
          data-category={product.category}
          data-search-text={`${product.name} ${product.tag} ${product.fit} ${product.category} ${product.specs.join(' ')}`.toLowerCase()}
        >
          <!-- Indicador superior de Stories (solo cuando hay más de 1 imagen) -->
          {product.images.length > 1 && (
            <div class="absolute top-3 inset-x-3 z-20 flex gap-1.5 pointer-events-none" aria-hidden="true">
              {product.images.map((_, imgIndex) => (
                <div
                  class:list={[
                    "h-1 flex-1 rounded-full transition-all duration-300",
                    imgIndex === 0 ? "bg-white/90 shadow-sm" : "bg-white/30"
                  ]}
                  data-dot-index={imgIndex}
                />
              ))}
            </div>
          )}

          <!-- Caja de Imagen y Carrusel Táctil (CLS=0 aspect-ratio 3/4 + LQIP + GPU acceleration) -->
          <div
            class="card-carousel-area r2-gpu-layer relative aspect-[3/4] bg-slate-950 overflow-hidden group touch-pan-y cursor-pointer"
            style={`background-color: #0f172a; background-image: url("${lqipBg}"); background-size: cover; background-position: center;`}
            data-action="open-detail"
            data-product-id={product.id}
            data-dominant-color="#0f172a"
          >
            <!-- Negociación de Formatos AVIF / WebP + Resolución Adaptativa DPR (srcset/sizes) -->
            <picture class="w-full h-full block" data-picture-product={product.id}>
              <source
                type="image/avif"
                srcset={responsiveSources.avifSrcset}
                sizes={responsiveSources.sizes}
                data-source-avif={product.id}
              />
              <source
                type="image/webp"
                srcset={responsiveSources.webpSrcset}
                sizes={responsiveSources.sizes}
                data-source-webp={product.id}
              />
              <img
                src={responsiveSources.fallbackSrc}
                srcset={responsiveSources.webpSrcset}
                sizes={responsiveSources.sizes}
                width={INTRINSIC_WIDTH}
                height={INTRINSIC_HEIGHT}
                alt={`${product.name} — Corte ${product.fit} (${product.tag}) — Vista 1 de ${product.images.length}`}
                loading={isLcp ? "eager" : "lazy"}
                fetchpriority={isLcp ? "high" : "low"}
                decoding="async"
                class="card-img w-full h-full object-cover transition-opacity duration-200"
                data-img-product={product.id}
              />
            </picture>

            <!-- Gradiente sutil inferior para legibilidad WCAG AA/AAA -->
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent pointer-events-none" aria-hidden="true"></div>

            <!-- Badge Signifier "Toca para detalles" -->
            <button
              type="button"
              data-action="open-detail"
              data-product-id={product.id}
              class="absolute top-7 left-3 z-20 bg-slate-950/85 backdrop-blur-md text-slate-100 text-[10px] font-semibold px-2.5 py-1.5 rounded-full border border-pink-500/30 flex items-center gap-1.5 shadow-lg hover:bg-pink-500 hover:text-white transition-all pointer-events-auto focus-visible:outline-none"
            >
              <i class="fa-solid fa-expand text-[9px] text-pink-400" aria-hidden="true"></i>
              <span>Toca para detalles</span>
            </button>

            <!-- Badge Telemetría Cloudflare R2 Edge Codec (Solo Admin) -->
            <span
              data-admin-only="inline-flex"
              class="hidden absolute top-7 right-12 z-20 bg-slate-950/85 backdrop-blur-md text-amber-300 text-[9px] font-mono px-2 py-1 rounded-full border border-amber-500/30 items-center gap-1 pointer-events-none"
              aria-hidden="true"
            >
              <i class="fa-solid fa-bolt text-[8px]"></i>
              <span data-r2-badge-product={product.id}>{isLcp ? 'LCP•AVIF' : 'R2•AVIF'}</span>
            </span>

            <!-- Botón Compartir Enlace Directo -->
            <button
              type="button"
              data-action="share-product"
              data-product-id={product.id}
              class="absolute top-7 right-3 z-20 w-8 h-8 rounded-full bg-slate-950/85 backdrop-blur-md text-slate-200 border border-white/15 flex items-center justify-center text-xs hover:text-emerald-400 active:scale-90 transition-all focus-visible:outline-none"
              aria-label={`Compartir enlace de ${product.name}`}
              title="Compartir enlace directo"
            >
              <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
            </button>

            <!-- Controles de Navegación del Carrusel -->
            <button
              type="button"
              data-action="slide-prev"
              data-product-id={product.id}
              disabled={product.images.length <= 1}
              class={`absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/75 text-white backdrop-blur-md items-center justify-center opacity-85 hover:opacity-100 active:scale-90 transition-all z-20 focus-visible:outline-none ${product.images.length <= 1 ? 'hidden' : 'flex'}`}
              aria-label={`Ver foto anterior de ${product.name}`}
            >
              <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              data-action="slide-next"
              data-product-id={product.id}
              disabled={product.images.length <= 1}
              class={`absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/75 text-white backdrop-blur-md items-center justify-center opacity-85 hover:opacity-100 active:scale-90 transition-all z-20 focus-visible:outline-none ${product.images.length <= 1 ? 'hidden' : 'flex'}`}
              aria-label={`Ver siguiente foto de ${product.name}`}
            >
              <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
            </button>

            <!-- Badge de Fit & Modelo rápido en esquina inferior izquierda (Contraste WCAG AAA) -->
            <div class="absolute bottom-3 left-3 z-10 flex items-center gap-1.5 bg-slate-950/85 backdrop-blur-md text-slate-100 text-[10px] px-2.5 py-1 rounded-full border border-white/15 pointer-events-none">
              <i class="fa-solid fa-ruler-horizontal text-pink-400 text-[9px]" aria-hidden="true"></i>
              <span>{product.fit}</span>
            </div>

            <!-- Contador de diapositivas -->
            <div class="absolute bottom-3 right-3 z-10 bg-slate-950/85 backdrop-blur-md text-slate-200 text-[10px] font-mono px-2.5 py-1 rounded-full border border-white/15">
              <span data-counter-product={product.id}>1</span>/{product.images.length}
            </div>
          </div>

          <!-- Información y Acciones Rápidas -->
          <div class="p-4 flex flex-col justify-between gap-4">
            <div class="flex items-start justify-between gap-2">
              <div class="cursor-pointer" data-action="open-detail" data-product-id={product.id}>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-bold tracking-widest text-pink-400 uppercase">{product.tag}</span>
                  <span class="text-[10px] font-mono text-amber-400/90 bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/20">
                    Quedan {product.stockLeft}
                  </span>
                </div>
                <h2 class="font-heading font-bold text-lg text-white leading-tight hover:text-pink-400 transition-colors mt-0.5">
                  {product.name}
                </h2>
                <p class="text-[11px] text-slate-400 mt-0.5">{product.specs[0]}</p>
                <a
                  href={`/p/${product.slug}`}
                  onclick="event.stopPropagation()"
                  class="inline-flex items-center gap-1 text-[10px] font-semibold text-pink-400 hover:text-pink-300 mt-1"
                >
                  <span>Ver ficha directa</span>
                  <i class="fa-solid fa-arrow-up-right-from-square text-[9px]" aria-hidden="true"></i>
                </a>
              </div>
              <div class="text-right shrink-0">
                <span class="text-[10px] text-slate-500 font-mono block">PRECIO</span>
                <span class="font-heading font-bold text-xl text-emerald-400">{product.price}</span>
              </div>
            </div>

            <!-- Selector Rápido de Talla (S, M, L, XL) -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Talla requerida:</span>
                <span data-size-label={product.id} class="text-[11px] font-semibold text-pink-400">
                  Selecciona una talla
                </span>
              </div>

              <div class="grid grid-cols-4 gap-2">
                {sizes.map((sz) => (
                  <button
                    type="button"
                    data-action="select-size"
                    data-product-id={product.id}
                    data-size={sz}
                    class="size-chip min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-700 bg-slate-800/50 text-slate-200 hover:border-slate-500 active:scale-95 transition-all text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
                  >
                    {sz}
                  </button>
                ))}
              </div>

              <!-- Píldora reactiva de medidas en cm directamente en la tarjeta -->
              <div
                data-card-measurements-box={product.id}
                class="hidden mt-2 px-3 py-1.5 rounded-xl bg-slate-950/90 border border-slate-800/90 items-center justify-between text-[11px]"
              >
                <span class="text-slate-400 flex items-center gap-1.5">
                  <i class="fa-solid fa-ruler-combined text-pink-400 text-[10px]" aria-hidden="true"></i>
                  <span>Medidas exactas:</span>
                </span>
                <span data-card-measurements-text={product.id} class="font-mono font-bold text-emerald-400"></span>
              </div>
            </div>

            <!-- Botones de Conversión Social Directa y Carrito (Ley de Fitts) -->
            <div class="pt-1 flex gap-2">
              <button
                type="button"
                data-action="add-to-cart"
                data-product-id={product.id}
                class="min-h-[44px] py-3 px-3 rounded-xl bg-pink-500/15 hover:bg-pink-500/25 text-pink-300 border border-pink-500/40 font-bold text-xs flex items-center justify-center gap-1.5 active:scale-95 transition-all shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
                aria-label={`Agregar ${product.name} al carrito`}
              >
                <i class="fa-solid fa-cart-plus text-xs" aria-hidden="true" data-cart-btn-icon={product.id}></i>
                <span data-btn-text-cart={product.id}>Agregar</span>
              </button>

              <button
                type="button"
                data-action="trigger-social"
                data-product-id={product.id}
                data-channel="whatsapp"
                class="flex-1 min-h-[44px] py-3 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 active:scale-95 transition-all btn-social-pulse focus-visible:outline-none"
              >
                <i class="fa-brands fa-whatsapp text-base" aria-hidden="true"></i>
                <span data-btn-text-wa={product.id}>Pedir por WhatsApp</span>
              </button>

              <button
                type="button"
                data-action="trigger-social"
                data-product-id={product.id}
                data-channel="instagram"
                class="w-12 h-11 min-h-[44px] rounded-xl bg-slate-800 hover:bg-slate-700 text-pink-400 border border-slate-700 flex items-center justify-center text-base active:scale-95 transition-all focus-visible:outline-none"
                aria-label={`Pedir ${product.name} por mensaje directo de Instagram`}
              >
                <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </article>
      )})}

      <!-- Estado Vacío para Búsqueda / Filtros sin coincidencias -->
      <div
