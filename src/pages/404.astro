---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Prenda no encontrada | URBAN_DROP"
  description="Este enlace ya no está disponible. Explora el catálogo actual de URBAN_DROP."
>
  <main class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="max-w-md w-full bg-slate-900/90 border border-slate-800 rounded-3xl p-8 text-center space-y-5 shadow-2xl">
      <div class="w-16 h-16 rounded-2xl bg-pink-500/15 border border-pink-500/30 text-pink-400 flex items-center justify-center mx-auto text-2xl">
        <i class="fa-solid fa-shirt" aria-hidden="true"></i>
      </div>
      <div class="space-y-2">
        <span class="text-[11px] font-mono uppercase tracking-widest text-pink-400">Error 404</span>
        <h1 class="font-heading text-2xl font-bold text-white">Prenda no encontrada</h1>
        <p class="text-sm text-slate-400">
          El enlace que abriste no existe o fue retirado del drop. Descubre las piezas disponibles en nuestro catálogo.
        </p>
      </div>
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 w-full min-h-[46px] py-3 px-5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition-all active:scale-95"
      >
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>Ver catálogo completo</span>
      </a>
    </div>
  </main>
</Layout>
