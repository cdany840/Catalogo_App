---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { sizes, type SizeKey } from '../../data/products';
import {
  fetchProductBySlugFromSupabase,
  isValidProductSlug,
  buildWhatsAppLink,
} from '../../lib/supabase';
import {
  buildEdgeResponsiveSources,
  createLqipSvgDataUri,
  INTRINSIC_WIDTH,
  INTRINSIC_HEIGHT,
} from '../../lib/cloudflare-r2';

const { slug } = Astro.params;

// Validación estricta del parámetro slug para prevenir inyección o consultas malformadas
if (!isValidProductSlug(slug)) {
  return Astro.redirect('/404');
}

const { product, relatedProducts, storeConfig } = await fetchProductBySlugFromSupabase(slug);

if (!product) {
  return Astro.redirect('/404');
}

// Cabeceras de Seguridad + Caché en el Edge (CDN)
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300'
);
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');

const isSoldOut = product.active === false || product.stockLeft <= 0;
const siteOrigin = Astro.url.origin || Astro.site?.toString() || 'https://urbandrop.store';
const canonicalUrl = new URL(`/p/${product.slug}`, siteOrigin).toString();
const ogImage = product.images[0];
const ogDescription = isSoldOut
  ? `${product.price} MXN · Prenda agotada actualmente. Descubre piezas similares en URBAN_DROP.`
  : `${product.price} MXN · ${product.fit}. Consulta tallas disponibles y pide directo por WhatsApp.`;

const lcpSources = buildEdgeResponsiveSources(product.images[0] || '');

// Determinar primera talla disponible por defecto
const availableSizeKeys = sizes.filter(
  (sz) => !product.availableSizes || product.availableSizes[sz] !== false
);
const defaultSize: SizeKey = availableSizeKeys[0] || 'M';
const initialWhatsAppUrl = buildWhatsAppLink(
  storeConfig.whatsappNumber,
  product.name,
  defaultSize,
  canonicalUrl,
  product.price,
  product.measurements[defaultSize]
);

const clientPayload = {
  slug: product.slug,
  name: product.name,
  price: product.price,
  canonicalUrl,
  whatsappNumber: storeConfig.whatsappNumber,
  instagramEnabled: storeConfig.instagramEnabled,
  instagramUrl: storeConfig.instagramUrl,
  isSoldOut,
  defaultSize,
  measurements: product.measurements,
  availableSizes: product.availableSizes || { S: true, M: true, L: true, XL: true },
  imageCount: product.images.length,
};
---

<Layout
  title={`${product.name} | URBAN_DROP`}
  description={ogDescription}
  image={ogImage}
  url={canonicalUrl}
  ogType="product"
  priceAmount={product.numericPrice}
  priceCurrency="MXN"
  availability={isSoldOut ? 'out of stock' : 'in stock'}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={lcpSources.fallbackSrc}
      imagesrcset={lcpSources.avifSrcset}
      imagesizes={lcpSources.sizes}
      fetchpriority="high"
    />
  </Fragment>

  <!-- Toast de notificaciones -->
  <div
    id="pdp-toast"
    class="fixed top-16 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-2xl bg-slate-900/95 border border-emerald-500/40 text-emerald-400 text-xs font-bold shadow-2xl backdrop-blur-md flex items-center gap-2 opacity-0 pointer-events-none -translate-y-3 transition-all duration-300"
    role="status"
    aria-live="polite"
  >
    <i class="fa-solid fa-circle-check text-sm" aria-hidden="true"></i>
    <span id="pdp-toast-text">Enlace copiado</span>
  </div>

  <!-- Header Sticky -->
  <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80 px-4 py-3">
    <div class="max-w-md mx-auto flex items-center justify-between gap-2">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-bold text-slate-300 hover:text-white bg-slate-900 border border-slate-800 px-3 py-2 rounded-xl transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
      >
        <i class="fa-solid fa-arrow-left text-pink-400" aria-hidden="true"></i>
        <span>Catálogo</span>
      </a>

      <a href="/" class="font-heading text-sm font-bold tracking-tight text-white">
        URBAN_DROP
      </a>

      <button
        id="pdp-share-btn"
        type="button"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-200 bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-2 rounded-xl transition-colors active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
        aria-label={`Compartir enlace de ${product.name}`}
      >
        <i class="fa-solid fa-share-nodes text-pink-400" aria-hidden="true"></i>
        <span>Compartir</span>
      </button>
    </div>
  </header>

  <main class="max-w-md mx-auto px-4 pt-4 pb-16 space-y-5">
    <!-- Tarjeta Principal de Producto -->
    <article class="bg-slate-900/90 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">
      <!-- Galería de Imágenes -->
      <div class="relative aspect-[3/4] bg-slate-950 overflow-hidden group" id="pdp-carousel">
        {product.images.length > 1 && (
          <div class="absolute top-3 left-3 right-3 z-20 flex gap-1.5" id="pdp-story-bars">
            {product.images.map((_, idx) => (
              <div class="h-1 flex-1 rounded-full bg-white/25 overflow-hidden">
                <div
                  class={`h-full rounded-full transition-all duration-300 ${
                    idx === 0 ? 'w-full bg-white' : 'w-0 bg-white'
                  }`}
                  data-story-fill={idx}
                />
              </div>
            ))}
          </div>
        )}

        {isSoldOut && (
          <div class="absolute inset-0 z-20 bg-slate-950/55 backdrop-blur-[2px] flex items-center justify-center pointer-events-none">
            <span class="px-5 py-2 rounded-2xl bg-rose-600/95 text-white font-heading font-bold text-base tracking-widest uppercase shadow-2xl border border-rose-400/50 -rotate-6">
              AGOTADO
            </span>
          </div>
        )}

        <div
          id="pdp-track"
          class="flex h-full w-full overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar"
          style="scrollbar-width: none; -ms-overflow-style: none;"
        >
          {product.images.map((imgUrl, idx) => {
            const sources = buildEdgeResponsiveSources(imgUrl);
            const lqip = createLqipSvgDataUri('#0f172a', '#ec4899');
            return (
              <div class="w-full h-full shrink-0 snap-center relative">
                <picture class="block w-full h-full">
                  <source type="image/avif" srcset={sources.avifSrcset} sizes={sources.sizes} />
                  <source type="image/webp" srcset={sources.webpSrcset} sizes={sources.sizes} />
                  <img
                    src={sources.fallbackSrc}
                    alt={`${product.name} - Vista ${idx + 1}`}
                    width={INTRINSIC_WIDTH}
                    height={INTRINSIC_HEIGHT}
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    decoding={idx === 0 ? 'sync' : 'async'}
                    fetchpriority={idx === 0 ? 'high' : 'auto'}
                    class="w-full h-full object-cover"
                    style={`background-image: url("${lqip}"); background-size: cover;`}
                  />
                </picture>
              </div>
            );
          })}
        </div>

        {product.images.length > 1 && (
          <>
            <button
              id="pdp-prev"
              type="button"
              class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-950/75 text-white border border-white/15 flex items-center justify-center hover:bg-slate-900 transition-colors"
              aria-label="Imagen anterior"
            >
              <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
            </button>
            <button
              id="pdp-next"
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-slate-950/75 text-white border border-white/15 flex items-center justify-center hover:bg-slate-900 transition-colors"
              aria-label="Imagen siguiente"
            >
              <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
            </button>
            <div class="absolute bottom-3 right-3 z-20 bg-slate-950/85 backdrop-blur-md text-slate-200 text-[11px] font-mono px-2.5 py-1 rounded-full border border-white/15">
              <span id="pdp-counter">1</span>/{product.images.length}
            </div>
          </>
        )}
      </div>

      <!-- Miniaturas si hay varias imágenes -->
      {product.images.length > 1 && (
        <div class="flex gap-2 px-4 pt-3 overflow-x-auto" id="pdp-thumbs">
          {product.images.map((imgUrl, idx) => {
            const thumbSrc = buildEdgeResponsiveSources(imgUrl).fallbackSrc;
            return (
              <button
                type="button"
                data-thumb-idx={idx}
                class={`w-14 h-16 rounded-xl overflow-hidden border-2 shrink-0 transition-all ${
                  idx === 0 ? 'border-pink-500 opacity-100' : 'border-slate-800 opacity-60 hover:opacity-100'
                }`}
                aria-label={`Ver imagen ${idx + 1}`}
              >
                <img
                  src={thumbSrc}
                  alt=""
                  width="56"
                  height="64"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </button>
            );
          })}
        </div>
      )}

      <!-- Información del Producto -->
      <div class="p-5 space-y-5">
        <div class="flex items-start justify-between gap-3">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[10px] font-bold tracking-widest text-pink-400 uppercase">
                {product.tag}
              </span>
              {isSoldOut ? (
                <span class="text-[10px] font-mono font-bold text-rose-300 bg-rose-500/15 px-2 py-0.5 rounded border border-rose-500/30">
                  Agotado
                </span>
              ) : (
                <span class="text-[10px] font-mono text-amber-400/90 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                  Quedan {product.stockLeft}
                </span>
              )}
            </div>
            <h1 class="font-heading font-bold text-2xl text-white leading-tight">
              {product.name}
            </h1>
            <p class="text-xs text-slate-400">
              Fit: <span class="text-slate-200 font-semibold">{product.fit}</span>
              {product.modelInfo && product.modelInfo !== 'N/A' && (
                <span> · Modelo: {product.modelInfo}</span>
              )}
            </p>
          </div>

          <div class="text-right shrink-0">
            <span class="text-[10px] text-slate-500 font-mono block">PRECIO</span>
            <span class="font-heading font-bold text-2xl text-emerald-400">{product.price}</span>
          </div>
        </div>

        <!-- Selector de Tallas + Medidas Exactas -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
              Selecciona tu talla
            </span>
            <span id="pdp-selected-size-label" class="text-xs font-bold text-pink-400">
              {isSoldOut ? 'Sin stock' : `Talla ${defaultSize}`}
            </span>
          </div>

          <div class="grid grid-cols-4 gap-2" id="pdp-size-grid">
            {sizes.map((sz) => {
              const sizeAvailable =
                !isSoldOut && (!product.availableSizes || product.availableSizes[sz] !== false);
              const isSelected = sizeAvailable && sz === defaultSize;
              return (
                <button
                  type="button"
                  data-pdp-size={sz}
                  disabled={!sizeAvailable}
                  class={`min-h-[44px] py-2.5 text-xs font-bold rounded-xl border transition-all text-center ${
                    !sizeAvailable
                      ? 'border-slate-800 bg-slate-900/50 text-slate-600 line-through cursor-not-allowed'
                      : isSelected
                        ? 'border-2 border-pink-500 bg-pink-500/20 text-white shadow-lg shadow-pink-500/10'
                        : 'border-slate-700 bg-slate-800/50 text-slate-200 hover:border-slate-500 active:scale-95'
                  }`}
                >
                  {sz}
                </button>
              );
            })}
          </div>

          <div class="px-3.5 py-2.5 rounded-xl bg-slate-950/90 border border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400 flex items-center gap-1.5">
              <i class="fa-solid fa-ruler-combined text-pink-400" aria-hidden="true"></i>
              <span>Medidas exactas:</span>
            </span>
            <span id="pdp-measurements-text" class="font-mono font-bold text-emerald-400">
              {product.measurements[defaultSize]}
            </span>
          </div>
        </div>

        <!-- Especificaciones -->
        {product.specs.length > 0 && (
          <div class="space-y-2 pt-1">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
              Detalles y materiales
            </h2>
            <ul class="space-y-1.5">
              {product.specs.map((spec) => (
                <li class="flex items-start gap-2 text-xs text-slate-300">
                  <i class="fa-solid fa-check text-emerald-400 text-[10px] mt-1 shrink-0" aria-hidden="true"></i>
                  <span>{spec}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Botones de Conversión Directa -->
        {isSoldOut ? (
          <div class="space-y-3 pt-2">
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-center text-xs text-rose-200">
              Esta prenda está agotada por el momento. Explora piezas disponibles abajo o regresa al catálogo.
            </div>
            <a
              href="/"
              class="w-full min-h-[46px] py-3 px-4 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm flex items-center justify-center gap-2 transition-all"
            >
              <i class="fa-solid fa-border-all text-pink-400" aria-hidden="true"></i>
              <span>Explorar catálogo activo</span>
            </a>
          </div>
        ) : (
          <div class="space-y-2.5 pt-2">
            <a
              id="pdp-whatsapp-btn"
              href={initialWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full min-h-[48px] py-3.5 px-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 active:scale-[0.98] transition-all"
            >
              <i class="fa-brands fa-whatsapp text-lg" aria-hidden="true"></i>
              <span>Pedir por WhatsApp</span>
            </a>

            {storeConfig.instagramEnabled && (
              <button
                id="pdp-instagram-btn"
                type="button"
                class="w-full min-h-[46px] py-3 px-4 rounded-2xl bg-slate-800 hover:bg-slate-700 text-pink-300 border border-slate-700 font-bold text-xs flex items-center justify-center gap-2 active:scale-[0.98] transition-all"
              >
                <i class="fa-brands fa-instagram text-base text-pink-400" aria-hidden="true"></i>
                <span>Copiar pedido y abrir Instagram DM</span>
              </button>
            )}
          </div>
        )}
      </div>
    </article>

    <!-- Productos Relacionados (Especialmente útil cuando activo = false) -->
    {relatedProducts.length > 0 && (
      <section class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <h2 class="font-heading font-bold text-base text-white">
            {isSoldOut ? 'Piezas disponibles similares' : 'También te puede interesar'}
          </h2>
          <a href="/" class="text-xs font-semibold text-pink-400 hover:text-pink-300">
            Ver todo
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {relatedProducts.map((rel) => {
            const relImg = buildEdgeResponsiveSources(rel.images[0] || '').fallbackSrc;
            return (
              <a
                href={`/p/${rel.slug}`}
                class="bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden hover:border-pink-500/40 transition-colors group"
              >
                <div class="aspect-[3/4] bg-slate-950 overflow-hidden">
                  <img
                    src={relImg}
                    alt={rel.name}
                    width="350"
                    height="466"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-2.5">
                  <p class="text-xs font-bold text-white truncate">{rel.name}</p>
                  <p class="text-xs font-heading font-bold text-emerald-400 mt-0.5">{rel.price}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <script id="pdp-data" type="application/json" set:html={JSON.stringify(clientPayload)} />

  <script>
    (() => {
      const dataEl = document.getElementById('pdp-data');
      if (!dataEl?.textContent) return;

      const data = JSON.parse(dataEl.textContent) as {
        slug: string;
        name: string;
        price: string;
        canonicalUrl: string;
        whatsappNumber: string;
        instagramEnabled: boolean;
        instagramUrl: string;
        isSoldOut: boolean;
        defaultSize: 'S' | 'M' | 'L' | 'XL';
        measurements: Record<'S' | 'M' | 'L' | 'XL', string>;
        availableSizes: Record<'S' | 'M' | 'L' | 'XL', boolean>;
        imageCount: number;
      };

      let selectedSize = data.defaultSize;
      let currentSlide = 0;

      const toast = document.getElementById('pdp-toast');
      const toastText = document.getElementById('pdp-toast-text');
      let toastTimer: number | undefined;

      function showToast(msg: string) {
        if (!toast || !toastText) return;
        toastText.textContent = msg;
        toast.classList.remove('opacity-0', '-translate-y-3', 'pointer-events-none');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
        }, 2600);
      }

      function buildMessage(size: 'S' | 'M' | 'L' | 'XL'): string {
        const meas = data.measurements[size] || '';
        return (
          `Hola URBAN_DROP, me interesa esta prenda:\n` +
          `• Producto: ${data.name} (${data.price})\n` +
          `• Talla: ${size}${meas ? ` [${meas}]` : ''}\n` +
          `• Enlace: ${data.canonicalUrl}`
        );
      }

      function updateOrderLinks() {
        const waBtn = document.getElementById('pdp-whatsapp-btn') as HTMLAnchorElement | null;
        if (waBtn && !data.isSoldOut) {
          const cleanPhone = (data.whatsappNumber || '5215500000000').replace(/\D/g, '');
          waBtn.href = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(buildMessage(selectedSize))}`;
        }
      }

      // Selector de tallas
      const sizeButtons = document.querySelectorAll<HTMLButtonElement>('[data-pdp-size]');
      const sizeLabel = document.getElementById('pdp-selected-size-label');
      const measText = document.getElementById('pdp-measurements-text');

      sizeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          const sz = btn.getAttribute('data-pdp-size') as 'S' | 'M' | 'L' | 'XL' | null;
          if (!sz) return;
          selectedSize = sz;

          sizeButtons.forEach((b) => {
            if (b.disabled) return;
            const active = b.getAttribute('data-pdp-size') === sz;
            b.className = active
              ? 'min-h-[44px] py-2.5 text-xs font-bold rounded-xl border-2 border-pink-500 bg-pink-500/20 text-white shadow-lg shadow-pink-500/10 transition-all text-center'
              : 'min-h-[44px] py-2.5 text-xs font-bold rounded-xl border border-slate-700 bg-slate-800/50 text-slate-200 hover:border-slate-500 active:scale-95 transition-all text-center';
          });

          if (sizeLabel) sizeLabel.textContent = `Talla ${sz}`;
          if (measText) measText.textContent = data.measurements[sz] || '';
          updateOrderLinks();
        });
      });

      // Botón Compartir (Web Share API + Fallback portapapeles)
      document.getElementById('pdp-share-btn')?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: data.name,
              text: `Mira ${data.name} (${data.price}) en URBAN_DROP`,
              url: data.canonicalUrl,
            });
            return;
          } catch {
            // Usuario canceló o falló Web Share; continúa al fallback
          }
        }

        if (navigator.clipboard) {
          await navigator.clipboard.writeText(data.canonicalUrl);
          showToast('Enlace copiado al portapapeles');
        }
      });

      // Botón Instagram DM
      document.getElementById('pdp-instagram-btn')?.addEventListener('click', async () => {
        const msg = buildMessage(selectedSize);
        if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(msg);
            showToast('Mensaje copiado — Pégalo en Instagram DM');
          } catch {
            // Ignorar si no hay permiso de portapapeles
          }
        }
        window.open(data.instagramUrl || 'https://instagram.com/direct/inbox/', '_blank', 'noopener,noreferrer');
      });

      // Carrusel de imágenes
      const track = document.getElementById('pdp-track');
      const counter = document.getElementById('pdp-counter');
      const storyFills = document.querySelectorAll<HTMLElement>('[data-story-fill]');
      const thumbBtns = document.querySelectorAll<HTMLButtonElement>('[data-thumb-idx]');

      function goToSlide(index: number) {
        if (!track || data.imageCount <= 1) return;
        currentSlide = Math.max(0, Math.min(index, data.imageCount - 1));
        track.scrollTo({ left: currentSlide * track.clientWidth, behavior: 'smooth' });
        syncSlideUI(currentSlide);
      }

      function syncSlideUI(idx: number) {
        if (counter) counter.textContent = String(idx + 1);
        storyFills.forEach((fill, i) => {
          fill.style.width = i <= idx ? '100%' : '0%';
        });
        thumbBtns.forEach((tb, i) => {
          tb.className =
            i === idx
              ? 'w-14 h-16 rounded-xl overflow-hidden border-2 border-pink-500 opacity-100 shrink-0 transition-all'
              : 'w-14 h-16 rounded-xl overflow-hidden border-2 border-slate-800 opacity-60 hover:opacity-100 shrink-0 transition-all';
        });
      }

      document.getElementById('pdp-prev')?.addEventListener('click', () => goToSlide(currentSlide - 1));
      document.getElementById('pdp-next')?.addEventListener('click', () => goToSlide(currentSlide + 1));

      thumbBtns.forEach((tb) => {
        tb.addEventListener('click', () => {
          const idx = Number(tb.getAttribute('data-thumb-idx') || 0);
          goToSlide(idx);
        });
      });

      track?.addEventListener(
        'scroll',
        () => {
          if (!track.clientWidth) return;
          const idx = Math.round(track.scrollLeft / track.clientWidth);
          if (idx !== currentSlide) {
            currentSlide = idx;
            syncSlideUI(idx);
          }
        },
        { passive: true }
      );
    })();
  </script>
</Layout>
